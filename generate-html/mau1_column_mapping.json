    },
    {
      "id": "HEADLINE29",
      "type": "text",
      "content": "Chú rể",
      "method": "id_pattern",
      "column_name": "groom_name_3"
    },
    {
      "id": "IMAGE15",
      "type": "image",
      "content": "",
      "method": "id_pattern",
      "column_name": "image_15"
    },
    {
      "id": "HEADLINE30",
      "type": "text",
      "content": "Chú rể là người đàn ông chín chắn, mạnh mẽ và đầy trách nhiệm. Anh mang trái tim ấm áp, luôn quan tâm và che chở cho người mình yêu. Trong ngày cưới, ánh mắt anh tràn đầy hạnh phúc và tự hào, bởi hôm ...",
      "method": "id_pattern",
      "column_name": "groom_name_4"
    },
    {
      "id": "SECTION6",
      "type": "text",
      "content": "ANH TÚ &amp; DIỆU NHI",
      "method": "id_pattern",
      "column_name": "text_section6"
    },
