    },
    {
      "id": "HEADLINE34",
      "type": "text",
      "content": "Sau hành trình đầy yêu thương, hôm nay chúng ta chính thức gọi nhau là vợ chồng. Ngày vui này là khởi đầu cho một chặng đường mới, cùng nhau xây đắp hạnh phúc.",
      "method": "id_pattern",
      "column_name": "event_date_6"
