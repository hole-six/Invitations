    {
      "id": "HEADLINE27",
      "type": "text",
      "content": "Cô dâu là người con gái dịu dàng, ấm áp nhưng cũng mạnh mẽ và độc lập. Ở cô luôn có sự tinh tế, yêu thương và biết quan tâm đến mọi người xung quanh. Trong ngày cưới, nụ cười của cô rạng rỡ hơn bao gi...",
      "method": "id_pattern",
      "column_name": "bride_name_4"
    },
    {
      "id": "BOX9",
      "type": "text",
      "content": "Chú rể",
      "method": "id_pattern",
