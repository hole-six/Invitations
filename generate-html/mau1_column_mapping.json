    },
    {
      "id": "HEADLINE35",
      "type": "text",
      "content": "Những buổi hẹn nhẹ nhàng, tiếng cười, những lần nắm tay… đã viết nên từng trang kỷ niệm. Tình yêu lớn dần theo năm tháng, và chúng ta biết rằng mình thuộc về nhau.",
      "method": "id_pattern",
      "column_name": "event_month"
    },
    {
      "id": "BOX11",
