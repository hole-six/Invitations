    },
    {
      "id": "HEADLINE33",
      "type": "text",
      "content": "Ngày ấy, giữa muôn vàn con người, chúng ta chạm mặt nhau như một sự sắp đặt của định mệnh. Ánh mắt đầu tiên đã mở ra câu chuyện dài đầy yêu thương.",
      "method": "id_pattern",
      "column_name": "event_date_5"
    },
    {
      "id": "BOX12",
