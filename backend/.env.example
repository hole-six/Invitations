# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=wedding_invitations
DB_USERNAME=root
DB_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-change-in-production-min-32-chars

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=/storage/uploads

# ERP SSO Integration
ERP_API_URL=https://api.hiweb.vn/api/v1
ERP_LOGIN_PAGE_URL=https://hiweb.vn/login
# ERP_LOGIN_PAGE_URL should redirect back to APP_URL/auth/sso/callback with token
