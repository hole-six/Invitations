<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Thiệp Cưới | Nhã An & Duy Khánh</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Great+Vibes&family=Montserrat:wght@300;400;500&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --forest:#1f3a33;
  --forest2:#162c27;
  --forest3:#2d5045;
  --gold:#c9a84c;
  --gold2:#e8d5a0;
  --gold3:#f5edd8;
  --cream:#f8f5ef;
  --parchment:#fdf9f2;
  --text:#2a2018;
  --muted:#6b6050;
  --border:rgba(201,168,76,0.3);
}

html{scroll-behavior:smooth;}
body{font-family:'Montserrat',sans-serif;background:var(--cream);color:var(--text);overflow-x:hidden;}

/* ═══════════════════════════════
   INTRO SCREEN
═══════════════════════════════ */
#intro{
  position:fixed;inset:0;z-index:9999;
  background:var(--forest2);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  overflow:hidden;
  transition:transform 1.4s cubic-bezier(0.76,0,0.24,1);
}
#intro.open{transform:translateY(-100%);}

/* gold ornament lines */
#intro::before,#intro::after{
  content:'';position:absolute;left:50%;transform:translateX(-50%);
  width:1px;background:linear-gradient(to bottom,transparent,var(--gold),transparent);
}
#intro::before{top:0;height:30%;}
#intro::after{bottom:0;height:30%;}

.intro-ornament{
  display:flex;align-items:center;gap:18px;margin-bottom:24px;
  animation:fadeUp .8s ease .3s both;
}
.intro-ornament::before,.intro-ornament::after{
  content:'';width:60px;height:1px;
  background:linear-gradient(to right,transparent,var(--gold));
}
.intro-ornament::after{background:linear-gradient(to left,transparent,var(--gold));}
.intro-ornament span{color:var(--gold);font-size:14px;letter-spacing:6px;}

.intro-title{
  font-family:'Great Vibes',cursive;
  font-size:clamp(50px,9vw,82px);
  color:white;
  text-align:center;
  line-height:1.1;
  animation:fadeUp .9s ease .5s both;
  filter:drop-shadow(0 4px 24px rgba(201,168,76,0.35));
}
.intro-amp{
  display:block;
  font-size:.52em;
  color:var(--gold);
  margin:4px 0;
}

.intro-date{
  margin-top:20px;
  font-family:'Montserrat',sans-serif;
  font-size:11px;letter-spacing:6px;text-transform:uppercase;
  color:rgba(255,255,255,.5);
  animation:fadeUp .8s ease .75s both;
}

.intro-cta{
  margin-top:44px;
  display:flex;flex-direction:column;align-items:center;gap:10px;
  animation:fadeUp .8s ease 1s both;
  cursor:pointer;
  color:rgba(255,255,255,.45);
  font-size:10px;letter-spacing:4px;text-transform:uppercase;
}
.intro-cta .cta-line{
  width:1px;height:40px;
  background:linear-gradient(to bottom,var(--gold),transparent);
  animation:pulseH 2s ease-in-out infinite 1.2s;
}
@keyframes pulseH{0%,100%{height:28px;opacity:.4;}50%{height:48px;opacity:.9;}}

/* sparkles in intro */
.sp{
  position:absolute;border-radius:50%;
  background:var(--gold);
  animation:spFloat linear infinite;
  opacity:0;
}
@keyframes spFloat{
  0%{transform:translateY(0) scale(0);opacity:0;}
  10%{opacity:.7;}
  90%{opacity:.4;}
  100%{transform:translateY(-100vh) scale(.5);opacity:0;}
}

/* ═══════════════════════════════
   NAV DOTS
═══════════════════════════════ */
.navd{
  position:fixed;right:16px;top:50%;transform:translateY(-50%);
  display:flex;flex-direction:column;gap:10px;z-index:200;
}
.nd{
  width:8px;height:8px;border-radius:50%;
  background:rgba(201,168,76,.25);cursor:pointer;
  border:1px solid rgba(201,168,76,.5);transition:all .3s;
}
.nd.on,.nd:hover{background:var(--gold);transform:scale(1.4);}

/* ═══════════════════════════════
   SCROLL REVEAL
═══════════════════════════════ */
.rev{opacity:0;transform:translateY(28px);transition:opacity .9s ease,transform .9s ease;}
.rev.vis{opacity:1;transform:none;}
.rev-l{opacity:0;transform:translateX(-28px);transition:opacity .9s ease,transform .9s ease;}
.rev-l.vis{opacity:1;transform:none;}
.rev-r{opacity:0;transform:translateX(28px);transition:opacity .9s ease,transform .9s ease;}
.rev-r.vis{opacity:1;transform:none;}

/* ═══════════════════════════════
   GLOBAL DIVIDER
═══════════════════════════════ */
.dv{
  display:flex;align-items:center;gap:14px;justify-content:center;
  margin:22px 0;color:var(--gold);font-size:16px;
}
.dv::before,.dv::after{content:'';flex:1;max-width:80px;height:1px;background:linear-gradient(to right,transparent,var(--gold));}
.dv::after{background:linear-gradient(to left,transparent,var(--gold));}
.dv-w{color:var(--gold2);}
.dv-w::before{background:linear-gradient(to right,transparent,var(--gold2));}
.dv-w::after{background:linear-gradient(to left,transparent,var(--gold2));}

/* ═══════════════════════════════
   SECTION BASE
═══════════════════════════════ */
.s-wrap{padding:90px 20px;position:relative;}
.s-wrap.alt{background:var(--parchment);}
.s-wrap.dark{background:var(--forest2);color:white;}
.s-wrap.dark2{background:var(--forest);color:white;}
.s-wrap{
  --orn-main:rgba(201,168,76,.2);
  --orn-soft:rgba(201,168,76,.08);
  overflow:hidden;
}
.s-wrap.dark,.s-wrap.dark2{
  --orn-main:rgba(232,213,160,.3);
  --orn-soft:rgba(232,213,160,.12);
}
.s-wrap::before,.s-wrap::after{
  content:'';
  position:absolute;
  width:220px;height:220px;
  pointer-events:none;
  z-index:1;
  background:
    radial-gradient(circle at 50% 50%,transparent 58%,var(--orn-main) 59%,var(--orn-main) 60%,transparent 61%),
    radial-gradient(circle at 50% 50%,transparent 43%,var(--orn-soft) 44%,var(--orn-soft) 45%,transparent 46%),
    radial-gradient(circle at 50% 50%,var(--orn-main) 0 2px,transparent 3px),
    linear-gradient(135deg,transparent 46%,var(--orn-soft) 47%,transparent 48%),
    linear-gradient(45deg,transparent 46%,var(--orn-soft) 47%,transparent 48%);
  opacity:.78;
}
.s-wrap::before{top:-96px;left:-92px;animation:secFloat 11s ease-in-out infinite;}
.s-wrap::after{bottom:-98px;right:-88px;transform:rotate(180deg);animation:secFloatFlip 13s ease-in-out infinite;}

.s-inner{max-width:760px;margin:0 auto;position:relative;z-index:2;}
.s-inner.wide{max-width:1000px;}
.s-label{
  font-size:10px;letter-spacing:5px;text-transform:uppercase;color:var(--gold);
  text-align:center;margin-bottom:10px;font-family:'Montserrat',sans-serif;
  display:flex;align-items:center;justify-content:center;gap:10px;
}
.s-label::before,.s-label::after{
  content:'✧';
  font-size:11px;
  color:rgba(201,168,76,.7);
}
.s-label.lw{color:var(--gold2);}
.s-label.lw::before,.s-label.lw::after{color:rgba(232,213,160,.85);}
.s-title{font-family:'Playfair Display',serif;font-size:clamp(26px,4.5vw,40px);font-weight:400;text-align:center;line-height:1.2;margin-bottom:4px;}
.s-title.tw{color:white;}

/* ═══════════════════════════════
   S1 — HERO
═══════════════════════════════ */
#hero{
  min-height:100vh;display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  padding:80px 20px;position:relative;overflow:hidden;
  background:
    radial-gradient(ellipse at 15% 85%,rgba(31,58,51,.06) 0%,transparent 55%),
    radial-gradient(ellipse at 85% 15%,rgba(201,168,76,.06) 0%,transparent 55%),
    var(--cream);
}
#hero::before{
  content:'';
  position:absolute;inset:-12%;
  pointer-events:none;
  background:
    radial-gradient(circle at 14% 22%,rgba(201,168,76,.22) 0 2px,transparent 3px),
    radial-gradient(circle at 84% 72%,rgba(201,168,76,.18) 0 2px,transparent 3px),
    radial-gradient(circle at 78% 26%,rgba(31,58,51,.14) 0 3px,transparent 4px),
    radial-gradient(circle at 20% 82%,rgba(31,58,51,.12) 0 3px,transparent 4px),
    conic-gradient(from 90deg at 50% 50%,rgba(201,168,76,.08),transparent 40%,rgba(201,168,76,.06) 75%,transparent);
  opacity:.65;
  animation:heroSpin 34s linear infinite;
}
#hero::after{
  content:'';
  position:absolute;
  width:min(880px,88vw);
  height:min(880px,88vw);
  border:1px dashed rgba(201,168,76,.26);
  border-radius:50%;
  top:50%;left:50%;
  transform:translate(-50%,-50%);
  pointer-events:none;
  animation:heroPulse 9s ease-in-out infinite;
}

.hero-card{
  position:relative;width:min(400px,92vw);
  text-align:center;
  z-index:2;
}

/* Polygon frame — kept from original, refined */
.poly-frame{
  position:absolute;inset:18px;
  border:2px solid var(--gold);
  clip-path:polygon(26% 0%,74% 0%,100% 26%,100% 74%,74% 100%,26% 100%,0% 74%,0% 26%);
  opacity:.55;
  animation:polyGlow 4s ease-in-out infinite;
}
@keyframes polyGlow{
  0%,100%{opacity:.45;box-shadow:inset 0 0 0 rgba(201,168,76,0);}
  50%{opacity:.75;box-shadow:inset 0 0 20px rgba(201,168,76,.08);}
}
.poly-frame2{
  position:absolute;inset:24px;
  border:1px solid var(--gold);
  clip-path:polygon(26% 0%,74% 0%,100% 26%,100% 74%,74% 100%,26% 100%,0% 74%,0% 26%);
  opacity:.25;
}

.hero-inner{
  position:relative;z-index:2;
  padding:70px 36px;
}

.hero-std{
  font-family:'Montserrat',sans-serif;font-size:9px;letter-spacing:6px;
  text-transform:uppercase;color:var(--gold);margin-bottom:18px;
  animation:fadeUp .8s ease .2s both;
}
.hero-names{
  font-family:'Great Vibes',cursive;
  font-size:clamp(52px,10vw,76px);
  color:var(--forest);line-height:1;
  animation:fadeUp .9s ease .35s both;
}
.hero-amp{
  font-family:'Playfair Display',serif;
  font-style:italic;color:var(--gold);
  display:block;font-size:.48em;margin:5px 0;
}
.hero-date{
  font-family:'Playfair Display',serif;
  font-size:clamp(18px,3vw,24px);
  color:var(--forest);margin:16px 0 4px;
  animation:fadeUp .8s ease .65s both;
}
.hero-venue{
  font-size:11px;letter-spacing:3px;text-transform:uppercase;
  color:var(--muted);font-family:'Montserrat',sans-serif;
  animation:fadeUp .7s ease .8s both;
}
.hero-scroll{
  margin-top:52px;display:flex;flex-direction:column;align-items:center;gap:8px;
  color:var(--muted);font-size:10px;letter-spacing:3px;text-transform:uppercase;
  font-family:'Montserrat',sans-serif;
  animation:fadeUp .7s ease 1s both;
}
.hero-scroll span{display:block;width:1px;height:36px;background:var(--gold);}

/* corner ornaments */
.co{position:absolute;width:38px;height:38px;}
.co svg{width:100%;height:100%;}
.co.tl{top:6px;left:6px;}
.co.tr{top:6px;right:6px;transform:scaleX(-1);}
.co.bl{bottom:6px;left:6px;transform:scaleY(-1);}
.co.br{bottom:6px;right:6px;transform:scale(-1,-1);}

@keyframes fadeUp{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:none;}}
@keyframes secFloat{0%,100%{transform:translateY(0) rotate(0deg);}50%{transform:translateY(8px) rotate(5deg);}}
@keyframes secFloatFlip{
  0%,100%{transform:rotate(180deg) translateY(0);}
  50%{transform:rotate(185deg) translateY(8px);}
}
@keyframes heroSpin{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}
@keyframes heroPulse{
  0%,100%{opacity:.3;transform:translate(-50%,-50%) scale(1);}
  50%{opacity:.65;transform:translate(-50%,-50%) scale(1.035);}
}

.hero-orns{
  position:absolute;inset:0;
  pointer-events:none;
  z-index:1;
}
.h-orn{
  position:absolute;
  color:rgba(201,168,76,.48);
  font-family:'Playfair Display',serif;
  animation:ornDrift 8s ease-in-out infinite;
}
.h-orn.leaf{font-size:28px;color:rgba(31,58,51,.3);}
.h-orn.star{font-size:18px;}
.h-orn.flower{font-size:24px;}
.h-orn.ring{
  width:20px;height:20px;border-radius:50%;
  border:1px solid rgba(201,168,76,.45);
  box-shadow:0 0 0 4px rgba(201,168,76,.08);
}
@keyframes ornDrift{
  0%,100%{transform:translateY(0) rotate(0deg);}
  50%{transform:translateY(-7px) rotate(8deg);}
}

/* ═══════════════════════════════
   S2 — LỜI MỞ ĐẦU
═══════════════════════════════ */
.qblock{
  text-align:center;max-width:600px;margin:0 auto;
}
.qmark{
  font-family:'Playfair Display',serif;font-size:90px;
  color:var(--gold2);line-height:.4;display:block;margin-bottom:18px;
}
.qtext{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(18px,2.5vw,22px);
  line-height:2;font-style:italic;color:var(--text);
}
.qfrom{
  margin-top:28px;font-family:'Great Vibes',cursive;
  font-size:30px;color:var(--gold);
}

/* ═══════════════════════════════
   S3 — COUPLE
═══════════════════════════════ */
.couple-grid{
  display:grid;grid-template-columns:1fr 60px 1fr;
  gap:0;margin-top:44px;align-items:start;
}
.p-card{text-align:center;padding:28px 16px;}
.p-avatar{
  width:148px;height:178px;margin:0 auto 18px;
  border-radius:3px;border:1px solid var(--gold);
  display:flex;align-items:flex-end;justify-content:center;
  overflow:visible;position:relative;
}
.p-avatar::before{
  content:'';position:absolute;inset:6px;
  border:1px solid rgba(201,168,76,.25);border-radius:2px;pointer-events:none;
}
.p-label{font-size:9px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:6px;font-family:'Montserrat',sans-serif;}
.p-name{font-family:'Playfair Display',serif;font-size:clamp(18px,2.8vw,23px);color:var(--forest);margin-bottom:8px;}
.p-fam{font-family:'Cormorant Garamond',serif;font-size:15px;color:var(--muted);line-height:1.85;font-style:italic;}
.p-sep{
  display:flex;align-items:center;justify-content:center;padding-top:56px;
}
.p-sep-inner{
  width:56px;height:56px;border:1px solid var(--gold);border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-family:'Great Vibes',cursive;font-size:30px;color:var(--gold);
  background:var(--parchment);
}

/* ═══════════════════════════════
   S4 — TIMELINE
═══════════════════════════════ */
.tl{margin-top:44px;position:relative;}
.tl::before{
  content:'';position:absolute;left:50%;top:0;bottom:0;width:1px;
  background:linear-gradient(to bottom,transparent,var(--gold),transparent);
  transform:translateX(-50%);
}
.tli{display:grid;grid-template-columns:1fr 44px 1fr;margin-bottom:36px;align-items:start;}
.tli:nth-child(odd) .tlc{grid-column:1;text-align:right;}
.tli:nth-child(odd) .tle{grid-column:3;}
.tli:nth-child(even) .tlc{grid-column:3;text-align:left;}
.tli:nth-child(even) .tle{grid-column:1;}
.tld{grid-column:2;display:flex;align-items:flex-start;justify-content:center;padding-top:4px;}
.tld span{width:13px;height:13px;border:2px solid var(--gold);border-radius:50%;background:var(--parchment);display:block;}
.tldt{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:4px;font-family:'Montserrat',sans-serif;}
.tltt{font-family:'Playfair Display',serif;font-size:18px;color:var(--forest);margin-bottom:4px;}
.tldc{font-family:'Cormorant Garamond',serif;font-size:15px;color:var(--muted);line-height:1.75;font-style:italic;}

/* ═══════════════════════════════
   S5 — DATE & VENUE (dark)
═══════════════════════════════ */
.bigdate{
  margin:34px auto;display:inline-flex;align-items:center;
  border:1px solid rgba(201,168,76,.4);
}
.db{padding:18px 26px;text-align:center;border-right:1px solid rgba(201,168,76,.25);}
.db:last-child{border-right:none;}
.dn{font-family:'Playfair Display',serif;font-size:42px;color:white;line-height:1;}
.dl{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-top:4px;font-family:'Montserrat',sans-serif;}
.ecards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin-top:34px;}
.ec{
  border:1px solid rgba(201,168,76,.3);padding:28px 22px;position:relative;overflow:hidden;
  transition:border-color .3s;
}
.ec:hover{border-color:rgba(201,168,76,.7);}
.ec::before{content:'';position:absolute;top:0;left:0;width:2px;height:100%;background:var(--gold);}
.ect{font-size:9px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:10px;font-family:'Montserrat',sans-serif;}
.ecn{font-family:'Playfair Display',serif;font-size:20px;color:white;margin-bottom:12px;}
.ecd{font-family:'Cormorant Garamond',serif;font-size:15px;color:rgba(255,255,255,.62);line-height:1.9;}
.ecd strong{color:rgba(255,255,255,.88);font-style:italic;}

/* ═══════════════════════════════
   S6 — SCHEDULE
═══════════════════════════════ */
.slist{list-style:none;margin-top:36px;}
.si{
  display:flex;align-items:flex-start;gap:20px;
  padding:18px 0;border-bottom:1px solid rgba(201,168,76,.18);
}
.si:last-child{border-bottom:none;}
.st{font-family:'Playfair Display',serif;font-size:20px;color:var(--gold);min-width:72px;font-style:italic;}
.sit{font-family:'Playfair Display',serif;font-size:16px;color:var(--forest);margin-bottom:3px;}
.sid{font-family:'Cormorant Garamond',serif;font-size:14px;color:var(--muted);font-style:italic;}

/* ═══════════════════════════════
   S7 — ALBUM
═══════════════════════════════ */
.mosaic{
  display:flex;
  align-content: center;
  grid-template-columns:repeat(3,1fr);
  grid-template-rows:repeat(2,190px);
  gap:10px;
  margin-top:36px;
}
.tile{
  position:relative;overflow:hidden;border-radius:2px;
  display:flex;align-items:center;justify-content:center;
  font-size:40px;cursor:pointer;
  transition:transform .35s ease;
}
.tile:hover{transform:scale(1.03);z-index:1;}
.tile:first-child{grid-row:span 2;font-size:62px;}
.tov{
  position:absolute;inset:0;
  background:rgba(31,58,51,0);
  transition:background .35s;
  display:flex;align-items:center;justify-content:center;
}
.tile:hover .tov{background:rgba(31,58,51,.22);}
/* frame on each tile */
.tile::after{
  content:'';position:absolute;inset:6px;
  border:1px solid rgba(201,168,76,.3);
  pointer-events:none;transition:border-color .3s;
}
.tile:hover::after{border-color:rgba(201,168,76,.6);}

/* ═══════════════════════════════
   S8 — FORMAL INVITATION CARD
═══════════════════════════════ */
.fcard{
  background:white;border:1px solid var(--gold2);
  padding:52px 44px;margin:36px auto;max-width:460px;
  position:relative;
  box-shadow:0 24px 64px rgba(0,0,0,.1);
}
.fcard::before,.fcard::after{
  content:'';position:absolute;pointer-events:none;
  border:1px solid rgba(201,168,76,.2);
}
.fcard::before{inset:6px;}
.fcard::after{inset:12px;}

/* polygon stamp in corner */
.fstamp{
  position:absolute;top:-18px;right:28px;
  width:50px;height:50px;
  background:var(--forest);
  clip-path:polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);
  display:flex;align-items:center;justify-content:center;
}
.fstamp svg{width:28px;height:28px;}

.fc-sal{font-family:'Montserrat',sans-serif;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--muted);margin-bottom:22px;display:block;text-align:center;}
.fc-inv{font-family:'Cormorant Garamond',serif;font-size:16px;line-height:1.9;color:var(--text);text-align:center;margin-bottom:22px;}
.fc-names{font-family:'Great Vibes',cursive;font-size:clamp(30px,5vw,40px);color:var(--forest);line-height:1.3;text-align:center;margin:14px 0;}
.fc-ev{font-family:'Playfair Display',serif;font-size:17px;color:var(--forest);margin:18px 0 8px;text-align:center;}
.fc-dt{font-family:'Cormorant Garamond',serif;font-size:14px;color:var(--muted);line-height:2.1;text-align:center;font-style:italic;}

/* ═══════════════════════════════
   S9 — RSVP
═══════════════════════════════ */
.rform{margin-top:36px;display:flex;flex-direction:column;gap:16px;}
.ff{display:flex;flex-direction:column;text-align:left;gap:5px;}
.ff label{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);font-family:'Montserrat',sans-serif;}
.ff input,.ff select,.ff textarea{
  background:transparent;border:none;border-bottom:1px solid var(--gold2);
  padding:10px 0;font-family:'Cormorant Garamond',serif;font-size:16px;
  color:var(--text);outline:none;transition:border-color .3s;-webkit-appearance:none;
}
.ff input:focus,.ff select:focus,.ff textarea:focus{border-color:var(--gold);}
.ff textarea{resize:none;height:66px;}
.aopts{display:flex;gap:12px;margin-top:7px;}
.aopt{
  flex:1;padding:12px;border:1px solid var(--gold2);text-align:center;cursor:pointer;
  font-family:'Cormorant Garamond',serif;font-size:15px;color:var(--muted);transition:all .3s;
}
.aopt.on,.aopt:hover{border-color:var(--forest);color:var(--forest);background:rgba(31,58,51,.05);}
.btn-sub{
  margin-top:20px;background:var(--forest);color:white;border:none;
  padding:15px 44px;font-family:'Montserrat',sans-serif;font-size:10px;
  letter-spacing:4px;text-transform:uppercase;cursor:pointer;
  transition:background .3s;align-self:center;clip-path:polygon(8px 0%,calc(100% - 8px) 0%,100% 8px,100% calc(100% - 8px),calc(100% - 8px) 100%,8px 100%,0% calc(100% - 8px),0% 8px);
}
.btn-sub:hover{background:var(--forest3);}
.rsuc{display:none;padding:36px;text-align:center;font-family:'Great Vibes',cursive;font-size:28px;color:var(--forest);}

/* ═══════════════════════════════
   S10 — WISHES
═══════════════════════════════ */
.wwall{
  margin-top:36px;display:grid;
  grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:14px;max-height:360px;overflow-y:auto;padding:3px;
}
.wcard{
  background:white;padding:18px;
  border-left:3px solid var(--gold);text-align:left;
  box-shadow:0 2px 12px rgba(0,0,0,.06);
  animation:fadeUp .5s ease;
}
.wa{font-family:'Great Vibes',cursive;font-size:20px;color:var(--forest);margin-bottom:6px;}
.wt{font-family:'Cormorant Garamond',serif;font-size:14px;color:var(--muted);line-height:1.75;font-style:italic;}
.wform{display:flex;flex-direction:column;gap:12px;margin-top:28px;}
.wform input,.wform textarea{
  background:white;border:1px solid var(--gold2);padding:12px 15px;
  font-family:'Cormorant Garamond',serif;font-size:16px;color:var(--text);
  outline:none;transition:border-color .3s;
}
.wform input:focus,.wform textarea:focus{border-color:var(--gold);}
.wform textarea{height:76px;resize:none;}
.btn-w{
  background:var(--gold);color:white;border:none;
  padding:13px 34px;font-family:'Montserrat',sans-serif;
  font-size:10px;letter-spacing:3px;text-transform:uppercase;
  cursor:pointer;align-self:center;transition:opacity .3s;
  clip-path:polygon(8px 0%,calc(100% - 8px) 0%,100% 8px,100% calc(100% - 8px),calc(100% - 8px) 100%,8px 100%,0% calc(100% - 8px),0% 8px);
}
.btn-w:hover{opacity:.85;}

/* ═══════════════════════════════
   S11 — CONTACTS
═══════════════════════════════ */
.fgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:26px;margin-top:44px;}
.fb{
  padding:24px;border:1px solid var(--gold2);text-align:center;
  position:relative;transition:border-color .3s;
  clip-path:polygon(6px 0%,calc(100% - 6px) 0%,100% 6px,100% calc(100% - 6px),calc(100% - 6px) 100%,6px 100%,0% calc(100% - 6px),0% 6px);
}
.fb:hover{border-color:var(--gold);}
.fbs{font-size:9px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:10px;font-family:'Montserrat',sans-serif;}
.fbn{font-family:'Playfair Display',serif;font-size:15px;color:var(--forest);margin-bottom:7px;}
.fbp{font-size:14px;color:var(--forest3);margin-bottom:4px;text-decoration:none;display:block;font-family:'Cormorant Garamond',serif;}
.fbp:hover{text-decoration:underline;}
.fbnt{font-size:12px;color:var(--muted);font-style:italic;font-family:'Cormorant Garamond',serif;}

/* ═══════════════════════════════
   S12 — FOOTER / CLOSING
═══════════════════════════════ */
#closing{
  background:var(--forest2);
  padding:100px 20px;text-align:center;
  position:relative;overflow:hidden;color:white;
}
#closing::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse at center,rgba(201,168,76,.08) 0%,transparent 68%);
}
#closing::after{
  content:'';position:absolute;inset:20px;
  border:1px dashed rgba(201,168,76,.2);
  clip-path:polygon(8% 0%,92% 0%,100% 12%,100% 88%,92% 100%,8% 100%,0% 88%,0% 12%);
  pointer-events:none;opacity:.7;
}
.cl-inner{max-width:580px;margin:0 auto;position:relative;z-index:2;}
.cl-t{font-family:'Great Vibes',cursive;font-size:clamp(44px,7vw,68px);color:var(--gold2);line-height:1.1;margin-bottom:22px;}
.cl-p{font-family:'Cormorant Garamond',serif;font-size:clamp(16px,2vw,20px);color:rgba(255,255,255,.72);line-height:2;font-style:italic;margin-bottom:36px;}
.cl-nm{font-family:'Great Vibes',cursive;font-size:32px;color:var(--gold);}
.cl-d{font-family:'Montserrat',sans-serif;font-size:10px;letter-spacing:5px;text-transform:uppercase;color:rgba(201,168,76,.5);margin-top:14px;}

/* ═══════════════════════════════
   RESPONSIVE
═══════════════════════════════ */
@media(max-width:600px){
  .couple-grid{grid-template-columns:1fr;}.p-sep{display:none;}
  .tl::before{left:22px;}.tli{grid-template-columns:44px 1fr;}
  .tli .tlc{grid-column:2!important;text-align:left!important;}.tli .tle{display:none;}.tli .tld{grid-column:1;}
  .mosaic{grid-template-columns:1fr 1fr;grid-template-rows:auto;}.tile:first-child{grid-row:span 1;}
  .navd{display:none;}
  .bigdate{flex-direction:column;}.db{border-right:none;border-bottom:1px solid rgba(201,168,76,.25);}
  .db:last-child{border-bottom:none;}
  .fcard{padding:36px 24px;}
  .s-wrap::before,.s-wrap::after{width:150px;height:150px;opacity:.55;}
  #hero::after{width:min(560px,92vw);height:min(560px,92vw);}
  .hero-orns{opacity:.75;}
}
</style>
</head>
<body>

<!-- NAV DOTS -->
<nav class="navd" id="navd"></nav>

<!-- ═══════ INTRO ═══════ -->
<div id="intro">
  <!-- polygon frames in bg -->
  <div style="position:absolute;width:220px;height:220px;border:1px solid rgba(201,168,76,.12);clip-path:polygon(26% 0%,74% 0%,100% 26%,100% 74%,74% 100%,26% 100%,0% 74%,0% 26%);top:50%;left:50%;transform:translate(-50%,-50%) scale(2.8);pointer-events:none;"></div>
  <div style="position:absolute;width:220px;height:220px;border:1px solid rgba(201,168,76,.07);clip-path:polygon(26% 0%,74% 0%,100% 26%,100% 74%,74% 100%,26% 100%,0% 74%,0% 26%);top:50%;left:50%;transform:translate(-50%,-50%) scale(4.5);pointer-events:none;"></div>

  <div style="text-align:center;position:relative;z-index:2;">
    <div class="intro-ornament"><span>✦ WEDDING INVITATION ✦</span></div>
    <div class="intro-title">
      Nhã An
      <span class="intro-amp">&amp;</span>
      Duy Khánh
    </div>
    <div class="intro-date">28 · 02 · 2026 — Đà Nẵng</div>
  </div>

  <div class="intro-cta" id="intro-cta">
    Chạm để mở thiệp
    <span class="cta-line"></span>
  </div>
</div>

<!-- ═══════ MAIN CONTENT ═══════ -->

<!-- S1: HERO -->
<section id="hero">
  <div class="hero-orns">
    <span class="h-orn leaf" style="left:9%;top:14%;">❦</span>
    <span class="h-orn leaf" style="right:10%;top:18%;animation-delay:1.2s;">❧</span>
    <span class="h-orn flower" style="left:16%;bottom:24%;animation-delay:.7s;">✿</span>
    <span class="h-orn flower" style="right:18%;bottom:20%;animation-delay:1.6s;">✾</span>
    <span class="h-orn star" style="left:24%;top:50%;animation-delay:2s;">✦</span>
    <span class="h-orn star" style="right:23%;top:52%;animation-delay:1.1s;">✧</span>
    <span class="h-orn ring" style="left:30%;top:22%;animation-delay:.5s;"></span>
    <span class="h-orn ring" style="right:31%;bottom:30%;animation-delay:1.8s;"></span>
  </div>
  <div class="hero-card rev">
    <!-- corner ornaments -->
    <div class="co tl"><svg viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 36 L2 8 Q2 2 8 2 L36 2" stroke="#c9a84c" stroke-width="1.5" fill="none"/><circle cx="2" cy="2" r="2" fill="#c9a84c"/></svg></div>
    <div class="co tr"><svg viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 36 L2 8 Q2 2 8 2 L36 2" stroke="#c9a84c" stroke-width="1.5" fill="none"/><circle cx="2" cy="2" r="2" fill="#c9a84c"/></svg></div>
    <div class="co bl"><svg viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 36 L2 8 Q2 2 8 2 L36 2" stroke="#c9a84c" stroke-width="1.5" fill="none"/><circle cx="2" cy="2" r="2" fill="#c9a84c"/></svg></div>
    <div class="co br"><svg viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 36 L2 8 Q2 2 8 2 L36 2" stroke="#c9a84c" stroke-width="1.5" fill="none"/><circle cx="2" cy="2" r="2" fill="#c9a84c"/></svg></div>
    <!-- polygon frames (original element, enhanced) -->
    <div class="poly-frame"></div>
    <div class="poly-frame2"></div>
    <div class="hero-inner">
      <div class="hero-std">✦ Save The Date ✦</div>
      <h1 class="hero-names">Nhã An<span class="hero-amp">&amp;</span>Duy Khánh</h1>
      <div class="dv" style="margin:14px 0;">◆</div>
      <div class="hero-date">28 · 02 · 2026</div>
      <div class="hero-venue">Nhà Hàng Riverside · Đà Nẵng</div>
    </div>
  </div>
  <div class="hero-scroll">Cuộn để khám phá <span></span></div>
</section>

<!-- S2: LỜI MỞ ĐẦU -->
<section class="s-wrap alt" id="lmd">
  <div class="s-inner">
    <div class="s-label rev">— Lời Ngỏ —</div>
    <h2 class="s-title rev">Lời Mở Đầu</h2>
    <div class="dv rev">◆</div>
    <div class="qblock">
      <span class="qmark rev">"</span>
      <p class="qtext rev">Hôn nhân là hành trình của yêu thương và sẻ chia.<br>Từ khoảnh khắc bình yên đến những tháng ngày rực rỡ,<br>chúng mình đã chọn nhau — và sẽ mãi chọn nhau.<br><br>Với trái tim tràn đầy hạnh phúc và biết ơn, chúng mình trân trọng kính mời quý gia đình, bạn bè đến chung vui trong ngày trọng đại nhất cuộc đời. Sự hiện diện của bạn là món quà quý giá nhất.</p>
      <div class="qfrom rev">Nhã An &amp; Duy Khánh</div>
    </div>
  </div>
</section>

<!-- S3: CÔ DÂU & CHÚ RỂ -->
<section class="s-wrap" id="gt">
  <div class="s-inner wide">
    <div class="s-label rev">— Nhân Vật Chính —</div>
    <h2 class="s-title rev">Cô Dâu &amp; Chú Rể</h2>
    <div class="dv rev">◆</div>
    <div class="couple-grid rev">
      <div class="p-card">
        <div class="p-avatar" style="background:linear-gradient(150deg,#fdf0f2,#f5e4ea);padding:0;display:flex;align-items:center;justify-content:center;">
          <img src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img6-5.jpg" alt="Cô dâu" style="width:100px;height:130px;object-fit:cover;border-radius:12px;box-shadow:0 2px 12px 0 rgba(201,168,76,0.10);background:#fff;">
        </div>
        <div class="p-label">Cô Dâu</div>
        <div class="p-name">Nguyễn Thị Nhã An</div>
        <p class="p-fam">Con gái của<br><em>Ông Nguyễn Văn Bình<br>&amp; Bà Trần Thị Mai</em><br><small style="font-size:12px;">Quận Hải Châu, Đà Nẵng</small></p>
      </div>
      <div class="p-sep"><div class="p-sep-inner">&amp;</div></div>
      <div class="p-card">
        <div class="p-avatar" style="background:linear-gradient(150deg,#eef3f0,#ddeae4);padding:0;display:flex;align-items:center;justify-content:center;">
          <img src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img2-4.jpg" alt="Chú rể" style="width:100px;height:130px;object-fit:cover;border-radius:12px;box-shadow:0 2px 12px 0 rgba(201,168,76,0.10);background:#fff;">
        </div>
        <div class="p-label">Chú Rể</div>
        <div class="p-name">Lê Văn Duy Khánh</div>
        <p class="p-fam">Con trai của<br><em>Ông Lê Văn Hùng<br>&amp; Bà Phạm Thị Lan</em><br><small style="font-size:12px;">Quận Thanh Khê, Đà Nẵng</small></p>
      </div>
    </div>
  </div>
</section>

<!-- S4: TIMELINE -->
<section class="s-wrap alt" id="ct">
  <div class="s-inner">
    <div class="s-label rev">— Hành Trình Của Chúng Mình —</div>
    <h2 class="s-title rev">Chuyện Tình Yêu</h2>
    <div class="dv rev">◆</div>
    <div class="tl">
      <div class="tli rev-l">
        <div class="tlc"><div class="tldt">Mùa Thu 2021</div><div class="tltt">Lần Đầu Gặp Gỡ</div><div class="tldc">Trong một buổi chiều bình yên, hai ánh mắt chạm nhau và cả thế giới như lặng xuống…</div></div>
        <div class="tld"><span></span></div><div class="tle"></div>
      </div>
      <div class="tli rev-r">
        <div class="tle"></div>
        <div class="tld"><span></span></div>
        <div class="tlc"><div class="tldt">Tháng 3, 2022</div><div class="tltt">Ngày Hẹn Hò Đầu Tiên</div><div class="tldc">Một tách cà phê, muôn câu chuyện — và anh biết, người này sẽ là cả cuộc đời.</div></div>
      </div>
      <div class="tli rev-l">
        <div class="tlc"><div class="tldt">Mùa Hè 2023</div><div class="tltt">Chuyến Đi Đáng Nhớ</div><div class="tldc">Cùng nhau khám phá những vùng đất mới, tìm thấy nhau nhiều hơn trong mỗi khoảnh khắc.</div></div>
        <div class="tld"><span></span></div><div class="tle"></div>
      </div>
      <div class="tli rev-r">
        <div class="tle"></div>
        <div class="tld"><span></span></div>
        <div class="tlc"><div class="tldt">24.12.2024</div><div class="tltt">Lời Cầu Hôn</div><div class="tldc">Dưới ánh đèn lung linh của đêm Giáng Sinh, anh quỳ xuống và nhận được câu trả lời từ trái tim.</div></div>
      </div>
      <div class="tli rev-l">
        <div class="tlc"><div class="tldt">28.02.2026</div><div class="tltt">Ngày Kết Đôi</div><div class="tldc">Hành trình tươi đẹp nhất bắt đầu — chúng mình chính thức trở thành một gia đình.</div></div>
        <div class="tld"><span></span></div><div class="tle"></div>
      </div>
    </div>
  </div>
</section>

<!-- S5: THỜI GIAN & ĐỊA ĐIỂM -->
<section class="s-wrap dark" id="tg">
  <div class="s-inner wide" style="text-align:center;">
    <div class="s-label lw rev">— Hẹn Gặp Nhau Tại —</div>
    <h2 class="s-title tw rev">Thời Gian &amp; Địa Điểm</h2>
    <div class="dv dv-w rev">◆</div>
    <div class="bigdate rev">
      <div class="db"><div class="dn">28</div><div class="dl">Ngày</div></div>
      <div class="db"><div class="dn">02</div><div class="dl">Tháng</div></div>
      <div class="db"><div class="dn">2026</div><div class="dl">Năm</div></div>
      <div class="db"><div class="dn">CN</div><div class="dl">Thứ</div></div>
    </div>
    <div class="ecards rev">
      <div class="ec">
        <div class="ect">Lễ Gia Tiên</div><div class="ecn">Nhà Trai</div>
        <div class="ecd"><strong>08:00</strong> — Lễ gia tiên nhà trai<br>Rước dâu: <strong>09:30</strong></div>
      </div>
      <div class="ec">
        <div class="ect">Địa Điểm Tiệc</div><div class="ecn">Riverside Restaurant</div>
        <div class="ecd"><strong>Bờ Đông Sông Hàn</strong><br>123 Trần Phú, Hải Châu<br>Đà Nẵng</div>
      </div>
      <div class="ec">
        <div class="ect">Tiệc Mừng</div><div class="ecn">Đón Khách</div>
        <div class="ecd">Đón tiếp quý khách: <strong>10:00</strong><br>Nhập tiệc: <strong>10:30</strong><br>Kết thúc: <strong>13:00</strong></div>
      </div>
    </div>
  </div>
</section>

<!-- S6: LỊCH TRÌNH -->
<section class="s-wrap" id="lt">
  <div class="s-inner">
    <div class="s-label rev">— Diễn Biến Ngày Vui —</div>
    <h2 class="s-title rev">Lịch Trình Buổi Lễ</h2>
    <div class="dv rev">◆</div>
    <ul class="slist">
      <li class="si rev"><div class="st">07:30</div><div><div class="sit">Lễ Gia Tiên Nhà Trai</div><div class="sid">Nghi thức cưới truyền thống tại gia đình chú rể</div></div></li>
      <li class="si rev"><div class="st">09:30</div><div><div class="sit">Rước Dâu &amp; Lễ Gia Tiên Nhà Gái</div><div class="sid">Chú rể và đoàn rước dâu đến nhà gái làm lễ</div></div></li>
      <li class="si rev"><div class="st">10:00</div><div><div class="sit">Đón Khách — Tiệc Cưới</div><div class="sid">Đón tiếp quý khách tại Riverside Restaurant</div></div></li>
      <li class="si rev"><div class="st">10:30</div><div><div class="sit">Nhập Tiệc &amp; Khai Vị</div><div class="sid">Khai tiệc mừng hạnh phúc đôi uyên ương</div></div></li>
      <li class="si rev"><div class="st">11:00</div><div><div class="sit">Nghi Lễ Trao Nhẫn</div><div class="sid">Khoảnh khắc thiêng liêng nhất của buổi tiệc</div></div></li>
      <li class="si rev"><div class="st">12:30</div><div><div class="sit">Cắt Bánh &amp; Chụp Ảnh Lưu Niệm</div><div class="sid">Ký ức ngọt ngào cùng gia đình &amp; bạn bè thân yêu</div></div></li>
    </ul>
  </div>
</section>

<!-- S7: ALBUM -->
<section class="s-wrap alt" id="al">
  <div class="s-inner wide" style="text-align:center;">
    <div class="s-label rev">— Khoảnh Khắc Đẹp —</div>
    <h2 class="s-title rev">Album Ảnh Kỷ Niệm</h2>
    <div class="dv rev">◆</div>
    <div class="mosaic rev">
      <div class="album-random">
        <img class="album-img" src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img6-5.jpg" alt="Ảnh 1">
        <img class="album-img" src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img2-4.jpg" alt="Ảnh 2">
        <img class="album-img" src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img3-4.jpg" alt="Ảnh 3">
        <img class="album-img" src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img4-4.jpg" alt="Ảnh 4">
        <img class="album-img" src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img5-4.jpg" alt="Ảnh 5">
        <img class="album-img" src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img6-4.jpg" alt="Ảnh 6">
        <img class="album-img" src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img7-4.jpg" alt="Ảnh 7">
        <img class="album-img" src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img6-4.jpg" alt="Ảnh 8">
      </div>
      <div id="album-modal" class="album-modal" style="display:none;">
        <span class="album-modal-close" onclick="document.getElementById('album-modal').style.display='none'">&times;</span>
        <img class="album-modal-content" id="album-modal-img">
      </div>
      <style>
        .album-random {
          position: relative;
          display: flex;
          align-items: center;
          width: 100%;
          min-height: 320px;
          margin: 0 auto 18px auto;
        }
        .album-img {
          position: absolute;
          width: 110px;
          height: 140px;
          object-fit: cover;
          border-radius: 12px;
          box-shadow: 0 2px 8px 0 rgba(201,168,76,0.13);
          background: #fff;
          cursor: pointer;
          transition: transform 0.2s;
        }
        .album-img:hover {
          transform: scale(1.08) rotate(-2deg);
          z-index: 2;
        }
        /* Vị trí random cho từng ảnh */
        .album-img:nth-child(1) { left: 10%; top: 10px; transform: rotate(-7deg); }
        .album-img:nth-child(2) { left: 35%; top: 40px; transform: rotate(5deg); }
        .album-img:nth-child(3) { left: 60%; top: 0px; transform: rotate(-4deg); }
        .album-img:nth-child(4) { left: 20%; top: 120px; transform: rotate(8deg); }
        .album-img:nth-child(5) { left: 50%; top: 110px; transform: rotate(-6deg); }
        .album-img:nth-child(6) { left: 70%; top: 90px; transform: rotate(3deg); }
        .album-img:nth-child(7) { left: 30%; top: 200px; transform: rotate(-9deg); }
        .album-img:nth-child(8) { left: 60%; top: 200px; transform: rotate(7deg); }
        @media (max-width: 600px) {
          .album-random { min-height: 220px; }
          .album-img { width: 70px; height: 90px; }
          .album-img:nth-child(1) { left: 5%; top: 5px; }
          .album-img:nth-child(2) { left: 35%; top: 20px; }
          .album-img:nth-child(3) { left: 60%; top: 0px; }
          .album-img:nth-child(4) { left: 15%; top: 80px; }
          .album-img:nth-child(5) { left: 50%; top: 70px; }
          .album-img:nth-child(6) { left: 70%; top: 60px; }
          .album-img:nth-child(7) { left: 25%; top: 130px; }
          .album-img:nth-child(8) { left: 60%; top: 130px; }
        }
        .album-modal {
          display: flex;
          position: fixed;
          z-index: 9999;
          left: 0; top: 0; width: 100vw; height: 100vh;
          background: rgba(0,0,0,0.7);
          align-items: center; justify-content: center;
        }
        .album-modal-content {
          max-width: 90vw;
          max-height: 80vh;
          border-radius: 16px;
          box-shadow: 0 2px 16px 0 rgba(201,168,76,0.18);
        }
        .album-modal-close {
          position: absolute;
          top: 24px; right: 40px;
          color: #fff;
          font-size: 48px;
          font-weight: bold;
          cursor: pointer;
          z-index: 10001;
          text-shadow: 0 2px 8px #000;
        }
      </style>
      <script>
        document.querySelectorAll('.album-img').forEach(function(img) {
          img.onclick = function() {
            var modal = document.getElementById('album-modal');
            var modalImg = document.getElementById('album-modal-img');
            modal.style.display = 'flex';
            modalImg.src = this.src;
            modalImg.alt = this.alt;
          };
        });
        document.getElementById('album-modal').onclick = function(e) {
          if (e.target === this) this.style.display = 'none';
        };
      </script>
    </div>
    <p class="rev" style="margin-top:22px;font-family:'Cormorant Garamond',serif;font-size:15px;color:var(--muted);font-style:italic;">📷 Album ảnh cưới sẽ được cập nhật sau buổi chụp hình hoàn tất</p>
  </div>
</section>

<!-- S8: THIỆP MỜI -->
<section class="s-wrap" id="tm">
  <div class="s-inner" style="text-align:center;">
    <div class="s-label rev">— Kính Gửi —</div>
    <h2 class="s-title rev">Thiệp Mời Chính Thức</h2>
    <div class="dv rev">◆</div>
    <div class="fcard rev">
      <!-- polygon stamp -->
      <div class="fstamp">
        <svg viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg">
          <text x="14" y="11" text-anchor="middle" font-family="Great Vibes,cursive" font-size="9" fill="rgba(201,168,76,.9)">N</text>
          <text x="14" y="22" text-anchor="middle" font-family="Great Vibes,cursive" font-size="9" fill="rgba(201,168,76,.9)">K</text>
        </svg>
      </div>
      <span class="fc-sal">Trân Trọng Kính Mời</span>
      <p class="fc-inv">Gia đình chúng tôi trân trọng kính mời Quý Vị<br>đến dự lễ thành hôn của</p>
      <div class="dv" style="margin:14px 0;">◆</div>
      <div class="fc-ev">Lễ Cưới</div>
      <div class="fc-names">Nguyễn Thị Nhã An<br><small style="font-size:.55em;color:var(--muted);font-family:'Montserrat',sans-serif;letter-spacing:2px;">&</small><br>Lê Văn Duy Khánh</div>
      <div class="dv" style="margin:14px 0;">◆</div>
      <p class="fc-dt">
        <strong style="font-family:'Playfair Display',serif;font-style:normal;color:var(--forest);">Riverside Restaurant</strong><br>
        123 Trần Phú, Hải Châu, Đà Nẵng<br><br>
        Vào lúc <strong>10:00</strong> — Chủ Nhật<br>
        Nhập tiệc: 10:30 — Ngày <strong>28/02/2026</strong><br>
        Nhằm ngày 11 tháng Giêng Năm Bính Ngọ
      </p>
      <div class="dv" style="margin:14px 0;">◆</div>
      <p style="font-family:'Great Vibes',cursive;font-size:22px;color:var(--forest);line-height:1.6;">Sự hiện diện của Quý Khách<br>là niềm vinh hạnh cho gia đình chúng tôi!</p>
      <p style="font-family:'Great Vibes',cursive;font-size:18px;color:var(--muted);margin-top:10px;">Kính mời!</p>
    </div>
  </div>
</section>

<!-- S9: RSVP -->
<section class="s-wrap alt" id="rsvp">
  <div class="s-inner" style="max-width:520px;text-align:center;">
    <div class="s-label rev">— Xác Nhận —</div>
    <h2 class="s-title rev">Xác Nhận Tham Dự</h2>
    <div class="dv rev">◆</div>
    <p class="rev" style="font-family:'Cormorant Garamond',serif;font-style:italic;color:var(--muted);font-size:16px;margin-top:8px;">Vui lòng xác nhận trước ngày <strong>15/02/2026</strong><br>để chúng mình chuẩn bị tốt nhất cho quý khách 💛</p>
    <div class="rform rev" id="rform">
      <div class="ff"><label>Họ &amp; Tên</label><input type="text" id="rname" placeholder="Nguyễn Văn A…"></div>
      <div class="ff"><label>Số Điện Thoại</label><input type="tel" placeholder="0xxx xxx xxx"></div>
      <div class="ff"><label>Số Người Tham Dự</label>
        <select><option value="1">1 người</option><option value="2" selected>2 người</option><option value="3">3 người</option><option value="4">4 người trở lên</option></select>
      </div>
      <div class="ff"><label>Xác Nhận</label>
        <div class="aopts">
          <div class="aopt on" id="ay" onclick="selA('y')">✓ Tham Dự</div>
          <div class="aopt" id="an" onclick="selA('n')">✕ Không Thể</div>
        </div>
      </div>
      <div class="ff"><label>Lời Nhắn (tuỳ chọn)</label><textarea placeholder="Lời nhắn gửi đến đôi uyên ương…"></textarea></div>
      <button class="btn-sub" onclick="subR()">Xác Nhận Tham Dự</button>
    </div>
    <div class="rsuc" id="rsuc">Cảm ơn bạn đã xác nhận! 💛<br><span style="font-size:16px;font-family:'Montserrat',sans-serif;letter-spacing:2px;color:var(--muted);">Chúng mình mong chờ gặp bạn!</span></div>
  </div>
</section>

<!-- S10: LỜI CHÚC -->
<section class="s-wrap dark2" id="lc">
  <div class="s-inner wide" style="text-align:center;">
    <div class="s-label lw rev">— Cùng Chúc Mừng —</div>
    <h2 class="s-title tw rev">Gửi Lời Chúc</h2>
    <div class="dv dv-w rev">◆</div>
    <div class="wwall rev" id="wwall">
      <div class="wcard"><div class="wa">Anh Minh &amp; Chị Lan</div><div class="wt">Chúc hai bạn trăm năm hạnh phúc, mãi yêu thương và đồng hành bên nhau 🌿</div></div>
      <div class="wcard"><div class="wa">Gia Đình Chú Tám</div><div class="wt">Cầu chúc đôi uyên ương luôn vui vẻ, hạnh phúc và sớm có tin vui!</div></div>
      <div class="wcard"><div class="wa">Nhóm Bạn Đại Học</div><div class="wt">Cuối cùng cũng đến ngày này rồi! Chúc mừng hai đứa nhé 🎉💛</div></div>
    </div>
    <div class="wform rev">
      <input type="text" id="wn" placeholder="Tên của bạn…">
      <textarea id="wt2" placeholder="Viết lời chúc tốt đẹp nhất đến đôi uyên ương…"></textarea>
      <button class="btn-w" onclick="addW()">Gửi Lời Chúc 💛</button>
    </div>
  </div>
</section>

<!-- S11: LIÊN HỆ -->
<section class="s-wrap" id="lh">
  <div class="s-inner wide" style="text-align:center;">
    <div class="s-label rev">— Cần Hỗ Trợ —</div>
    <h2 class="s-title rev">Thông Tin Liên Hệ Gia Đình</h2>
    <div class="dv rev">◆</div>
    <div class="fgrid rev">
      <div class="fb"><div class="fbs">Nhà Gái</div><div class="fbn">Ông Nguyễn Văn Bình</div><a href="tel:0900000001" class="fbp">0900 000 001</a><div class="fbnt">Hải Châu, Đà Nẵng</div></div>
      <div class="fb"><div class="fbs">Nhà Gái</div><div class="fbn">Bà Trần Thị Mai</div><a href="tel:0900000002" class="fbp">0900 000 002</a><div class="fbnt">Hải Châu, Đà Nẵng</div></div>
      <div class="fb"><div class="fbs">Nhà Trai</div><div class="fbn">Ông Lê Văn Hùng</div><a href="tel:0900000003" class="fbp">0900 000 003</a><div class="fbnt">Thanh Khê, Đà Nẵng</div></div>
      <div class="fb"><div class="fbs">Nhà Trai</div><div class="fbn">Bà Phạm Thị Lan</div><a href="tel:0900000004" class="fbp">0900 000 004</a><div class="fbnt">Thanh Khê, Đà Nẵng</div></div>
      <div class="fb" style="border-color:var(--gold);"><div class="fbs" style="color:var(--forest);">Cô Dâu</div><div class="fbn">Nhã An</div><a href="tel:0900000005" class="fbp">0900 000 005</a><div class="fbnt">Liên hệ trực tiếp</div></div>
      <div class="fb" style="border-color:var(--gold);"><div class="fbs" style="color:var(--forest);">Chú Rể</div><div class="fbn">Duy Khánh</div><a href="tel:0900000006" class="fbp">0900 000 006</a><div class="fbnt">Liên hệ trực tiếp</div></div>
    </div>
  </div>
</section>

<!-- S12: KẾT THÚC -->
<section id="closing">
  <div class="cl-inner">
    <!-- big polygon bg -->
    <div style="position:absolute;width:300px;height:300px;border:1px solid rgba(201,168,76,.08);clip-path:polygon(26% 0%,74% 0%,100% 26%,100% 74%,74% 100%,26% 100%,0% 74%,0% 26%);top:50%;left:50%;transform:translate(-50%,-50%) scale(2.2);pointer-events:none;"></div>
    <div class="cl-t rev">Cảm Ơn Bạn!</div>
    <p class="cl-p rev">Cảm ơn bạn đã dành thời gian quý báu để cùng chia vui với chúng mình.<br>Mỗi lời chúc, mỗi nụ cười và sự hiện diện của bạn<br>là điều trân quý nhất trong ngày hạnh phúc này.</p>
    <div class="dv dv-w rev">◆</div>
    <div class="cl-nm rev">Nhã An &amp; Duy Khánh</div>
    <div class="cl-d rev">28 · 02 · 2026 — Mãi Mãi Yêu Nhau</div>
    <div class="rev" style="margin-top:36px;font-size:28px;letter-spacing:10px;">🌿 💍 🌿</div>
  </div>
</section>

<script>
/* ── INTRO SPARKLES (original kept, enhanced) ── */
const intro=document.getElementById('intro');
for(let i=0;i<55;i++){
  const s=document.createElement('div');s.className='sp';
  const sz=2+Math.random()*5;
  s.style.cssText=`width:${sz}px;height:${sz}px;left:${Math.random()*100}%;bottom:${Math.random()*15}%;animation-duration:${5+Math.random()*9}s;animation-delay:${Math.random()*6}s;`;
  intro.appendChild(s);
}

/* ── OPEN CARD ── */
const cta=document.getElementById('intro-cta');
function openCard(){intro.classList.add('open');}
cta.addEventListener('click',openCard);
setTimeout(()=>{if(!intro.classList.contains('open'))openCard();},5500);

/* ── SCROLL REVEAL ── */
const revs=document.querySelectorAll('.rev,.rev-l,.rev-r');
const obs=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('vis');obs.unobserve(e.target);}});},{threshold:.1});
revs.forEach(el=>obs.observe(el));

/* ── NAV DOTS ── */
const SIDS=['hero','lmd','gt','ct','tg','lt','al','tm','rsvp','lc','lh','closing'];
const navd=document.getElementById('navd');
SIDS.forEach(id=>{
  const d=document.createElement('div');d.className='nd';
  d.title=id;d.onclick=()=>document.getElementById(id)?.scrollIntoView({behavior:'smooth'});
  navd.appendChild(d);
});
function updDots(){
  const sy=window.scrollY+window.innerHeight/2;
  SIDS.forEach((id,i)=>{
    const el=document.getElementById(id);if(!el)return;
    const{offsetTop:ot,offsetHeight:oh}=el;
    navd.children[i].classList.toggle('on',sy>=ot&&sy<ot+oh);
  });
}
window.addEventListener('scroll',updDots);updDots();

/* ── RSVP ── */
let aC='y';
function selA(v){aC=v;document.getElementById('ay').classList.toggle('on',v==='y');document.getElementById('an').classList.toggle('on',v==='n');}
function subR(){if(!document.getElementById('rname').value.trim()){alert('Vui lòng nhập tên!');return;}document.getElementById('rform').style.display='none';document.getElementById('rsuc').style.display='block';}

/* ── WISHES ── */
function addW(){
  const n=document.getElementById('wn').value.trim(),t=document.getElementById('wt2').value.trim();
  if(!n||!t){alert('Vui lòng nhập tên và lời chúc!');return;}
  const w=document.getElementById('wwall'),c=document.createElement('div');c.className='wcard';
  c.innerHTML=`<div class="wa">${n}</div><div class="wt">${t}</div>`;w.prepend(c);
  document.getElementById('wn').value='';document.getElementById('wt2').value='';
}
</script>
</body>
</html>
