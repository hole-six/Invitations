<script>
/* ══ CONFETTI ══ */
(function(){
  const layer = document.getElementById('confetti-layer');
  const COLORS = ['#ffd700','#ffaa00','#ff6060','#ff9999','#fff0a0','#ffcc66','#e83030','#c8a020'];
  const SHAPES = ['circle','petal','diamond'];

  function spawnConf(){
    const el = document.createElement('div');
    const size = 6 + Math.random() * 12;
    const color = COLORS[Math.floor(Math.random() * COLORS.length)];
    const shape = SHAPES[Math.floor(Math.random() * SHAPES.length)];
    const dur = 4 + Math.random() * 5;
    const rot = (Math.random() < 0.5 ? '' : '-') + (200 + Math.random() * 400) + 'deg';

    el.className = 'cf';
    el.style.cssText = `
      left:${Math.random() * 100}%;
      width:${size}px; height:${size * (shape==='petal' ? 1.8 : 1)}px;
      background:${color};
      opacity:0;
      animation-duration:${dur}s;
      animation-delay:${Math.random() * 3}s;
      --rot:${rot};
      border-radius:${shape==='diamond' ? '0' : shape==='circle' ? '50%' : '60% 0 60% 0'};
      transform-origin:center;
      ${shape==='diamond' ? 'transform:rotate(45deg);' : ''}
    `;
    layer.appendChild(el);
    setTimeout(() => el.remove(), (dur + 4) * 1000);
  }

  for(let i = 0; i < 6; i++) setTimeout(spawnConf, i * 400);
  setInterval(spawnConf, 500);
})();

/* ══ ENVELOPE OPEN ══ */
let envOpened = false;
function openEnvelope() {
  if (envOpened) return;
  envOpened = true;

  const scene = document.getElementById('env-scene');
  const burst = document.getElementById('burst');
  const main  = document.getElementById('main');

  // Flash burst
  burst.classList.add('active');

  // Extra confetti burst
  const layer = document.getElementById('confetti-layer');
  for (let i = 0; i < 40; i++) {
    setTimeout(() => {
      const el = document.createElement('div');
      el.className = 'cf';
      const size = 8 + Math.random() * 14;
      const colors = ['#ffd700','#ffaa00','#ff6060','#fff0a0','#ffcc66','#e83030'];
      el.style.cssText = `
        left:${20 + Math.random() * 60}%;
        width:${size}px; height:${size}px;
        background:${colors[Math.floor(Math.random()*colors.length)]};
        opacity:0; animation-duration:${2 + Math.random()*3}s;
        animation-delay:0s; --rot:${(Math.random()<.5?'':'-')}${200+Math.random()*400}deg;
        border-radius:${Math.random()>.5?'50%':'60% 0 60% 0'};
      `;
      layer.appendChild(el);
      setTimeout(() => el.remove(), 6000);
    }, i * 30);
  }

  // Fade out envelope after short delay
  setTimeout(() => {
    scene.classList.add('fade-away');
    // Show main
    main.style.display = 'block';
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        main.classList.add('show');
        checkReveal();
      });
    });
  }, 500);
}

/* ══ SCROLL REVEAL ══ */
function checkReveal() {
  const vH = window.innerHeight;
  document.querySelectorAll('.rv:not(.show),.rv-l:not(.show),.rv-r:not(.show)').forEach(el => {
    const r = el.getBoundingClientRect();
    if (r.top < vH * .92) {
      const siblings = el.parentElement.querySelectorAll('.rv:not(.show),.rv-l:not(.show),.rv-r:not(.show)');
      let delay = 0;
      siblings.forEach(s => {
        const sr = s.getBoundingClientRect();
        if (sr.top < vH * .92) {
          setTimeout(() => s.classList.add('show'), delay);
          delay += 90;
        }
      });
    }
  });
}
window.addEventListener('scroll', checkReveal, { passive: true });

/* ══ NAV ACTIVE ══ */
const SEC_IDS = ['s-hero','s-invite','s-couple','s-story','s-events','s-rsvp','s-wishes'];
window.addEventListener('scroll', () => {
  const mid = window.scrollY + window.innerHeight * .35;
  const links = document.querySelectorAll('.main-nav a');
  SEC_IDS.forEach((id, i) => {
    const el = document.getElementById(id);
    if (!el) return;
    links[i]?.classList.toggle('active', mid >= el.offsetTop && mid < el.offsetTop + el.offsetHeight);
  });
}, { passive: true });

/* ══ RSVP ══ */
let attChoice = 'yes';
function setAtt(v) {
  attChoice = v;
  document.getElementById('attY').classList.toggle('on', v === 'yes');
  document.getElementById('attN').classList.toggle('on', v === 'no');
}
function submitRsvp() {
  const name = document.getElementById('rName').value.trim();
  if (!name) { alert('Vui lòng nhập tên!'); return; }
  document.getElementById('rsvpForm').style.display = 'none';
  document.getElementById('rsvpDone').style.display = 'block';
}

/* ══ WISHES ══ */
function addWish() {
  const name = document.getElementById('wName').value.trim();
  const text = document.getElementById('wText').value.trim();
  if (!name || !text) { alert('Vui lòng nhập tên và lời chúc!'); return; }
  const feed = document.getElementById('wishFeed');
  const el = document.createElement('div');
  el.className = 'wish-item';
  el.style.opacity = '0';
  el.style.transform = 'translateY(12px)';
  el.style.transition = 'opacity .5s, transform .5s';
  el.innerHTML = `<p class="wi-name" data-editable="year_10">${name}</p><p class="wi-text" data-editable="field_93">${text}</p>`;
  feed.prepend(el);
  requestAnimationFrame(() => requestAnimationFrame(() => {
    el.style.opacity = '1'; el.style.transform = 'none';
  }));
  document.getElementById('wName').value = '';
  document.getElementById('wText').value = '';
}
</script>
</body>
</html>
