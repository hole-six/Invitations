<!-- ══ 12. CẢM ƠN ══ -->
<section id="cam-on" style="max-width:100%;">
  <!-- Background ginkgo decor -->
  <svg class="bg-ginkgo tl" viewBox="0 0 200 240" fill="none">
    <g transform="translate(40,20)">
