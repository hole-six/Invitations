    <div class="thanks-names">✦ &nbsp; Happy wedding &nbsp; ✦</div>
  </div>
</section>

<script>
const time = new Date();
const formatted = time.toLocaleDateString('vi-VN', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});
const closingDateEl = document.getElementById('closing-date');
if (closingDateEl) {
  closingDateEl.textContent = `Ngày ${formatted} · TP. Đà Nẵng`;
}
</script>

<script>
// Keep hero/anchors below fixed nav even when nav height changes on mobile
const navEl = document.querySelector('nav');
const navLeftHint = document.querySelector('.nav-scroll-indicator.left');
const navRightHint = document.querySelector('.nav-scroll-indicator.right');
function updateNavScrollHints() {
  if (!navEl) return;
  const canScroll = navEl.scrollWidth > navEl.clientWidth + 2;
  const canLeft = canScroll && navEl.scrollLeft > 4;
  const canRight = canScroll && (navEl.scrollLeft + navEl.clientWidth) < (navEl.scrollWidth - 4);
  document.body.classList.toggle('nav-can-left', canLeft);
  document.body.classList.toggle('nav-can-right', canRight);
}
function syncNavOffset() {
  if (!navEl) return;
  const navH = Math.ceil(navEl.getBoundingClientRect().height);
  document.documentElement.style.setProperty('--nav-offset', `${navH}px`);
  updateNavScrollHints();
}
if (navEl) {
  navEl.addEventListener('scroll', updateNavScrollHints, { passive: true });
}
if (navEl && navLeftHint && navRightHint) {
  navLeftHint.addEventListener('click', function() {
    navEl.scrollBy({ left: -180, behavior: 'smooth' });
  });
  navRightHint.addEventListener('click', function() {
    navEl.scrollBy({ left: 180, behavior: 'smooth' });
  });
}
window.addEventListener('load', syncNavOffset);
window.addEventListener('resize', syncNavOffset);
syncNavOffset();

// Scroll reveal
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.08 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// RSVP
function submitRSVP() {
  const name = document.getElementById('r-name').value.trim();
  if (!name) { alert('Vui lòng điền tên của bạn!'); return; }
  const yes = document.querySelector('input[name="att"]:checked').value === 'yes';
  alert(yes
    ? `Cảm ơn ${name}! Chúng mình rất vui khi được đón bạn trong ngày trọng đại. 🌿`
    : `Cảm ơn ${name} đã thông báo. Chúng mình luôn nhớ đến bạn trong ngày vui! 🍃`
  );
}

// Wishes
function addWish() {
  const name = document.getElementById('w-name').value.trim();
  const rel  = document.getElementById('w-rel').value.trim();
  const txt  = document.getElementById('w-txt').value.trim();
  if (!name || !txt) { alert('Vui lòng điền tên và lời chúc!'); return; }
  const feed = document.getElementById('wishes-feed');
  const d = document.createElement('div');
  d.className = 'wi';
  d.style.cssText = 'opacity:0;transition:opacity .5s ease;';
  d.innerHTML = `<div class="wi-author">${name}${rel ? ' — '+rel : ''}</div><div class="wi-txt">${txt}</div>`;
  feed.insertBefore(d, feed.firstChild);
  requestAnimationFrame(() => { d.style.opacity = '1'; });
  document.getElementById('w-name').value = '';
  document.getElementById('w-rel').value = '';
  document.getElementById('w-txt').value = '';
}

// Music toggle (copied behavior from mau5)
(function initMusicPlayer() {
  const audio = document.getElementById('background-music');
  const toggleButton = document.getElementById('music-toggle');
  const playIcon = document.getElementById('play-icon');
  const pauseIcon = document.getElementById('pause-icon');
  if (!audio || !toggleButton || !playIcon || !pauseIcon) return;

  let isPlaying = false;
  let hasStarted = false;

  document.body.addEventListener('click', function firstTap() {
    if (hasStarted) return;
    audio.play().then(() => {
      isPlaying = true;
      hasStarted = true;
      playIcon.style.display = 'none';
      pauseIcon.style.display = 'block';
      toggleButton.classList.add('vibrating');
    }).catch(() => {
      // ignore autoplay error
    });
  }, { once: true });

  toggleButton.addEventListener('click', function(event) {
    event.stopPropagation();
    if (isPlaying) {
      audio.pause();
      isPlaying = false;
      playIcon.style.display = 'block';
      pauseIcon.style.display = 'none';
      toggleButton.classList.remove('vibrating');
    } else {
      audio.play().then(() => {
        isPlaying = true;
        playIcon.style.display = 'none';
        pauseIcon.style.display = 'block';
        toggleButton.classList.add('vibrating');
      });
    }
  });

  audio.addEventListener('play', function() {
    isPlaying = true;
    playIcon.style.display = 'none';
    pauseIcon.style.display = 'block';
    toggleButton.classList.add('vibrating');
  });
  audio.addEventListener('pause', function() {
    isPlaying = false;
    playIcon.style.display = 'block';
    pauseIcon.style.display = 'none';
    toggleButton.classList.remove('vibrating');
  });
})();
</script>
</body>
</html>
