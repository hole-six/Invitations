          <label class="radio-o"><input type="radio" name="att" value="yes" checked> Tôi sẽ có mặt 🌿</label>
          <label class="radio-o"><input type="radio" name="att" value="no"> Rất tiếc vắng mặt</label>
        </div>
      </div>
      <div class="ff">
        <label>Ghi Chú</label>
