<!-- 6 LỊCH TRÌNH -->
<section id="lich-trinh">
  <div class="si-wrap reveal">
    <p class="sec-label">✈ Flight Schedule</p>
    <h2 class="sec-title">Lịch Trình Buổi Lễ</h2>
    <div class="tline"></div>
    <ul class="itinerary">
      <li class="it-item"><span class="it-time">09:00</span><div class="it-dot"></div><div class="it-content"><h4>Mở Cửa Boarding</h4><p>Hai họ và quý khách đến, trà thơm và bánh ngọt phục vụ tại sảnh đón.</p></div></li>
      <li class="it-item"><span class="it-time">09:30</span><div class="it-dot"></div><div class="it-content"><h4>Đón Khách Chính Thức</h4><p>Ban nhạc biểu diễn, gia đình hai bên chào đón quý hành khách an tọa.</p></div></li>
      <li class="it-item"><span class="it-time">10:30</span><div class="it-dot"></div><div class="it-content"><h4>✈ Cất Cánh – Nghi Thức Thành Hôn</h4><p>Lễ gia tiên, trao nhẫn và nghi thức cưới truyền thống. Hành trình mới bắt đầu!</p></div></li>
      <li class="it-item"><span class="it-time">11:00</span><div class="it-dot"></div><div class="it-content"><h4>Khai Tiệc &amp; Chúc Rượu</h4><p>Bữa tiệc ấm cúng cùng gia đình và bạn bè. Cơ trưởng phát biểu và nâng ly.</p></div></li>
      <li class="it-item"><span class="it-time">13:00</span><div class="it-dot"></div><div class="it-content"><h4>Chụp Ảnh &amp; Cảm Ơn</h4><p>Cô dâu chú rể đến từng bàn cảm ơn và lưu kỷ niệm.</p></div></li>
      <li class="it-item"><span class="it-time">13:30</span><div class="it-dot"></div><div class="it-content"><h4>✈ Hạ Cánh – Kết Thúc Hành Trình</h4><p>Cảm ơn quý hành khách đã đồng hành trên chuyến bay đặc biệt này!</p></div></li>
    </ul>
  </div>
</section>

<!-- 7 ALBUM -->
<section id="album">
  <div class="alb-wrap reveal">
    <p class="sec-label" style="color:var(--accent);">✈ In-Flight Gallery</p>
    <h2 class="sec-title" style="color:white;">Album Ảnh Kỷ Niệm</h2>
    <div class="tline" style="background:linear-gradient(90deg,transparent,var(--accent),transparent);"></div>

    <!-- MOSAIC GRID — 5 ô chính -->
    <div class="mosaic">

      <!-- 1 — Hero lớn, 2 col × 2 row -->
      <div class="mc big" onclick="albOpen(0)">
        <img src="https://images.unsplash.com/photo-1519741497674-611481863552?w=900&q=80&fit=crop" alt="Cô dâu chú rể" loading="lazy">
        <span class="mc-date">2026</span>
        <div class="mc-cap">
          <div class="mc-tag">✈ Pre-Wedding</div>
          <div class="mc-title">Hành trình bắt đầu từ đây</div>
        </div>
      </div>

      <!-- 2 — Top right -->
      <div class="mc" onclick="albOpen(1)">
        <img src="https://images.unsplash.com/photo-1606800052052-a08af7148866?w=600&q=80&fit=crop" alt="Lễ cưới" loading="lazy">
        <span class="mc-date">2025</span>
        <div class="mc-cap">
          <div class="mc-tag">✈ Love Story</div>
          <div class="mc-title">Lời hứa trọn đời</div>
        </div>
      </div>

      <!-- 3 — Middle right -->
      <div class="mc" onclick="albOpen(2)">
        <img src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=600&q=80&fit=crop" alt="Kỷ niệm" loading="lazy">
        <span class="mc-date">2024</span>
        <div class="mc-cap">
          <div class="mc-tag">✈ Kỷ Niệm</div>
          <div class="mc-title">Những khoảnh khắc đẹp</div>
        </div>
      </div>

      <!-- 4 — Bottom mid -->
      <div class="mc" onclick="albOpen(3)">
        <img src="https://images.unsplash.com/photo-1537633552985-df8429e8048b?w=600&q=80&fit=crop" alt="Hạnh phúc" loading="lazy">
        <span class="mc-date">2025</span>
        <div class="mc-cap">
          <div class="mc-tag">✈ Together</div>
          <div class="mc-title">Bên nhau mãi mãi</div>
        </div>
      </div>

      <!-- 5 — Bottom right -->
      <div class="mc" onclick="albOpen(4)">
        <img src="https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=600&q=80&fit=crop" alt="Nhẫn cưới" loading="lazy">
        <span class="mc-date">2026</span>
        <div class="mc-cap">
          <div class="mc-tag">✈ Wedding</div>
          <div class="mc-title">Ngày trọng đại</div>
        </div>
      </div>

    </div>

    <!-- POLAROID STRIP — ảnh nhỏ phong cách cổ điển -->
    <div class="pol-strip">
      <div class="pol" onclick="albOpen(5)">
        <img src="https://images.unsplash.com/photo-1518049362265-d5b2a6467637?w=300&q=75&fit=crop" alt="">
        <span class="pol-label">Nụ cười đầu tiên</span>
      </div>
      <div class="pol" onclick="albOpen(6)">
        <img src="https://images.unsplash.com/photo-1491438590914-bc09fcaaf77a?w=300&q=75&fit=crop" alt="">
        <span class="pol-label">Ngày hẹn hò</span>
      </div>
      <div class="pol" onclick="albOpen(7)">
        <img src="https://images.unsplash.com/photo-1524863479829-916d8e77f114?w=300&q=75&fit=crop" alt="">
        <span class="pol-label">Cầu hôn</span>
      </div>
      <div class="pol" onclick="albOpen(8)">
        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&q=75&fit=crop" alt="">
        <span class="pol-label">Chụp ảnh cưới</span>
      </div>
      <div class="pol" onclick="albOpen(9)">
        <img src="https://images.unsplash.com/photo-1469371670807-013ccf25f16a?w=300&q=75&fit=crop" alt="">
        <span class="pol-label">Hạnh phúc mãi mãi</span>
      </div>
      <div class="pol" onclick="albOpen(10)">
        <img src="https://images.unsplash.com/photo-1550005809-91ad75fb315f?w=300&q=75&fit=crop" alt="">
        <span class="pol-label">Về chung một nhà</span>
      </div>
    </div>

    <p style="text-align:center;margin-top:18px;font-size:.6rem;color:rgba(255,255,255,.22);font-style:italic;font-family:'Lato',sans-serif;">* Ảnh minh hoạ · Bấm để xem lớn · Ảnh thật sẽ được cập nhật sau buổi chụp chính thức</p>
  </div>
</section>

<!-- ALBUM LIGHTBOX -->
<div class="alb-lb" id="albLb">
  <div class="alb-lb-close" onclick="albClose()">✕ &nbsp; Đóng</div>
  <img class="alb-lb-img" id="albLbImg" src="" alt="">
  <div class="alb-lb-caption" id="albLbCap"></div>
  <div class="alb-lb-nav">
    <button class="alb-lb-btn" onclick="albNav(-1)">← Trước</button>
    <button class="alb-lb-btn" onclick="albNav(1)">Sau →</button>
  </div>
</div>

<!-- 8 THIỆP MỜI -->
<section id="thiep-moi">
  <div class="si-wrap reveal" style="text-align:center;">
    <p class="sec-label">✈ Vé Boarding Chính Thức</p>
    <h2 class="sec-title">Thiệp Mời Chính Thức</h2>
    <div class="tline"></div>
    <div class="ticket-wrap">
      <div class="tw-hd">
        <div class="tw-airline"><svg width="15" height="15" viewBox="0 0 24 24" fill="white"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>Hiền Tuyền Airlines</div>
        <div class="tw-class">✦ Hạng Thương Gia ✦</div>
      </div>
      <div class="tw-body">
        <div class="tw-l">
          <div class="tw-field"><div class="tw-fl">Trân Trọng Kính Mời</div><div style="height:1px;background:var(--border);margin:6px 0 11px;"></div></div>
          <div class="tw-field"><div class="tw-fl">Cơ Trưởng – Cơ Phó</div><div class="tw-fv script">Tống Hiền &amp; Thanh Tuyền</div></div>
          <div class="tw-field"><div class="tw-fl">Chuyến Bay</div><div class="tw-fv xl">LỄ THÀNH HÔN</div></div>
          <div class="tw-field"><div class="tw-fl">Ngày</div><div class="tw-fv">Thứ Bảy — 20 . 09 . 2026</div></div>
          <div class="tw-note">Ông Tống Văn A &amp; Bà Nguyễn Thị B (Hải Hậu, Nam Định)<br>Ông Lê Văn C &amp; Bà Phạm Thị D (Nam Định)<br>Trân trọng thông báo lễ thành hôn của con chúng tôi.</div>
        </div>
        <div class="tw-sep"></div>
        <div class="tw-r">
          <div class="tw-field"><div class="tw-fl">Sân Bay</div><div class="tw-fv">Xóm 2B, Hải Anh<br>Hải Hậu, Nam Định</div></div>
          <div class="tw-field"><div class="tw-fl">Boarding</div><div class="tw-fv xl">09:30</div></div>
          <div class="tw-field"><div class="tw-fl">Take-off</div><div class="tw-fv xl">10:30</div></div>
          <div class="tw-field"><div class="tw-fl">Hạng</div><div class="tw-fv">Hạng Thương Gia</div></div>
          <div class="tw-note"><em>Hãy đến trong bộ trang phục cổ điển nhất!</em><br>Xác nhận trước 10.09.2026 · <strong>09xx.xxx.xxx</strong></div>
        </div>
      </div>
      <div class="tw-ft">
        <span class="tw-ft-txt">THẺ ĐI ĂN CƯỚI / BOARDING PASS</span>
        <span class="tw-ft-txt" style="color:var(--accent);">20 . 09 . 2026</span>
      </div>
    </div>
  </div>
</section>

<!-- 9 RSVP -->
<section id="rsvp">
  <div class="si-wrap reveal">
    <p class="sec-label">✈ Online Check-In</p>
    <h2 class="sec-title">RSVP — Xác Nhận Tham Dự</h2>
    <div class="tline"></div>
    <p style="text-align:center;font-size:13px;color:var(--mid);margin-bottom:26px;font-weight:300;">Check-in trước ngày <strong style="color:var(--navy);font-family:'Barlow Condensed',sans-serif;">10 . 09 . 2026</strong></p>
    <div class="checkin-form">
      <div class="ci-hd"><span>✈ Online Check-In Form</span><span class="icon">Hiền Tuyền Airlines</span></div>
      <div class="ci-body">
        <div class="ff"><label>Họ Và Tên</label><input type="text" id="r-name" placeholder="NGUYEN VAN A"></div>
        <div class="ff"><label>Số Điện Thoại</label><input type="tel" placeholder="09xx xxx xxx"></div>
        <div class="ff"><label>Số Hành Khách</label><select><option>1 hành khách</option><option>2 hành khách</option><option>3 hành khách</option><option>4+ hành khách</option></select></div>
        <div class="ff"><label>Xác Nhận Bay</label><div class="radio-g"><label class="radio-o"><input type="radio" name="att" value="yes" checked> ✈ Có mặt</label><label class="radio-o"><input type="radio" name="att" value="no"> ✗ Vắng mặt</label></div></div>
        <div class="ff"><label>Yêu Cầu Đặc Biệt</label><input type="text" placeholder="Dị ứng thực phẩm..."></div>
        <button class="navy-btn" onclick="submitRSVP()">Xác Nhận Check-In</button>
      </div>
    </div>
  </div>
</section>

<!-- 10 LỜI CHÚC -->
<section id="loi-chuc">
  <div class="si-wrap reveal">
    <p class="sec-label">✈ In-Flight Message</p>
    <h2 class="sec-title">Gửi Lời Chúc Phúc</h2>
    <div class="tline"></div>
    <div class="guestbook">
      <div class="gb-meta">
        <input type="text" id="w-name" placeholder="Tên hành khách...">
        <input type="text" id="w-rel" placeholder="Hạng ghế (bạn thân / gia đình...)">
      </div>
      <textarea class="gb-ta" id="w-txt" placeholder="Gửi lời chúc đến Tống Hiền &amp; Thanh Tuyền..."></textarea>
      <button class="gb-send" onclick="addWish()">Gửi Lời Chúc Bay</button>
      <div class="gb-feed" id="wfeed">
        <div class="gb-item"><div class="gb-author">✈ Hoa &amp; Nam — Bạn Thân · Hạng VIP</div><div class="gb-txt">Chúc chuyến bay tình yêu mãi êm ái! 💙</div></div>
        <div class="gb-item"><div class="gb-author">✈ Gia Đình Chị Hằng · Hạng Thương Gia</div><div class="gb-txt">Bay bổng hạnh phúc, hạ cánh an toàn tại mái ấm gia đình!</div></div>
      </div>
    </div>
  </div>
</section>

<!-- 11 LIÊN HỆ -->
<section id="lien-he">
  <div class="si-wrap reveal">
    <p class="sec-label">✈ Crew Information</p>
    <h2 class="sec-title">Thông Tin Liên Hệ</h2>
    <div class="tline"></div>
    <div class="crew-grid">
      <div class="crew-card">
        <div class="crew-hd"><span class="crew-role">✈ Nhà Trai / Groom's Family</span><span style="color:var(--accent);font-size:.58rem;">ĐỘI A</span></div>
        <div class="crew-body">
          <div class="crew-name">Họ Tống</div>
          <div class="crew-item"><strong>Ông Tống Văn A</strong>📞 09xx xxx xxx</div>
          <div class="crew-item"><strong>Bà Nguyễn Thị B</strong>📞 09xx xxx xxx</div>
          <div class="crew-div"></div>
          <div class="crew-item"><strong>✈ Cơ Trưởng — Tống Hiền</strong>📞 09xx xxx xxx</div>
        </div>
      </div>
      <div class="crew-card">
        <div class="crew-hd"><span class="crew-role">✈ Nhà Gái / Bride's Family</span><span style="color:var(--accent);font-size:.58rem;">ĐỘI B</span></div>
        <div class="crew-body">
          <div class="crew-name">Họ Lê</div>
          <div class="crew-item"><strong>Ông Lê Văn C</strong>📞 09xx xxx xxx</div>
          <div class="crew-item"><strong>Bà Phạm Thị D</strong>📞 09xx xxx xxx</div>
          <div class="crew-div"></div>
          <div class="crew-item"><strong>✈ Cơ Phó — Thanh Tuyền</strong>📞 09xx xxx xxx</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 12 CẢM ƠN -->
<section id="cam-on">
  <div class="co-stars"></div>
  <div class="inner reveal" style="max-width:500px;margin:0 auto;position:relative;z-index:1;">
    <div class="co-icon">✈ ✈ ✈</div>
    <h2>Cảm Ơn Quý Hành Khách</h2>
    <p class="subtitle">Cảm ơn quý vị đã đồng hành trên chuyến bay đặc biệt<br>và ý nghĩa nhất trong cuộc đời chúng tôi.<br>Sự hiện diện của quý vị chính là "nhiên liệu"<br>giúp chuyến bay tình yêu bay cao mãi mãi.</p>
    <div class="thanks-names">Tống Hiền &amp; Thanh Tuyền</div>
    <div style="opacity:.16;margin:12px 0;letter-spacing:8px;">✈ &nbsp; ✈ &nbsp; ✈</div>
    <div class="c-date">Flight Date: 20 . 09 . 2026 · Hải Hậu · Nam Định</div>
  </div>
</section>

</div>

<!-- WISH LOADING -->
<div class="wish-loading" id="wish-loading">
  <div class="wl-card">
    <div class="wl-title">In-Flight Message</div>
    <div class="wl-track"><span class="wl-plane">✈</span></div>
    <div class="wl-text">Đang Bay Gửi Lời Chúc...</div>
  </div>
</div>

<script>
// ── Config ──
const GUEST_NAME = 'Nguyễn Văn Khách'; // ← đổi tên thật ở đây

// ── Barcode ──
const bc = document.getElementById('bc');
if(bc){
  [26,14,26,10,20,26,12,26,16,22,26,10,18,26,14,20,26,16].forEach(h=>{
    const s=document.createElement('span');s.style.height=h+'px';bc.appendChild(s);
  });
}

// ── Open ──
function handleOpen(){
  const btn=document.getElementById('open-btn');
  btn.disabled=true;btn.style.opacity='.55';
  const overlay=document.getElementById('stamp-overlay');
  overlay.classList.add('active');
  setTimeout(()=>{
    document.getElementById('stamp-mark').classList.add('stamped');
    setTimeout(()=>{
      overlay.style.transition='opacity .55s ease';overlay.style.opacity='0';
      const gate=document.getElementById('passport-gate');
      gate.style.transition='opacity .85s ease';gate.style.opacity='0';
      setTimeout(()=>{
        gate.classList.add('hidden');
        overlay.classList.remove('active');overlay.style.opacity='';
        const main=document.getElementById('main-content');
        main.classList.add('revealed');
        ['hero-pax-name','stub-pax-name'].forEach(id=>{
          const el=document.getElementById(id);
          if(el)el.textContent=GUEST_NAME;
        });
        setTimeout(initReveal,120);
      },680);
    },1500);
  },580);
}

// ── Album Lightbox ──
const ALB_IMGS = [
  {src:'https://images.unsplash.com/photo-1519741497674-611481863552?w=1200&q=90&fit=crop',cap:'Hành trình bắt đầu từ đây'},
  {src:'https://images.unsplash.com/photo-1606800052052-a08af7148866?w=1200&q=90&fit=crop',cap:'Lời hứa trọn đời'},
  {src:'https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=1200&q=90&fit=crop',cap:'Những khoảnh khắc đẹp'},
  {src:'https://images.unsplash.com/photo-1537633552985-df8429e8048b?w=1200&q=90&fit=crop',cap:'Bên nhau mãi mãi'},
  {src:'https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=1200&q=90&fit=crop',cap:'Ngày trọng đại'},
  {src:'https://images.unsplash.com/photo-1518049362265-d5b2a6467637?w=1200&q=90&fit=crop',cap:'Nụ cười đầu tiên'},
  {src:'https://images.unsplash.com/photo-1491438590914-bc09fcaaf77a?w=1200&q=90&fit=crop',cap:'Ngày hẹn hò'},
  {src:'https://images.unsplash.com/photo-1524863479829-916d8e77f114?w=1200&q=90&fit=crop',cap:'Cầu hôn'},
  {src:'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1200&q=90&fit=crop',cap:'Chụp ảnh cưới'},
  {src:'https://images.unsplash.com/photo-1469371670807-013ccf25f16a?w=1200&q=90&fit=crop',cap:'Hạnh phúc mãi mãi'},
  {src:'https://images.unsplash.com/photo-1550005809-91ad75fb315f?w=1200&q=90&fit=crop',cap:'Về chung một nhà'},
];
let albIdx=0;
function albOpen(i){
  albIdx=i;
  const lb=document.getElementById('albLb');
  document.getElementById('albLbImg').src=ALB_IMGS[i].src;
  document.getElementById('albLbCap').textContent=ALB_IMGS[i].cap;
  lb.classList.add('open');
}
function albClose(){document.getElementById('albLb').classList.remove('open');}
function albNav(d){
  albIdx=(albIdx+d+ALB_IMGS.length)%ALB_IMGS.length;
  document.getElementById('albLbImg').src=ALB_IMGS[albIdx].src;
  document.getElementById('albLbCap').textContent=ALB_IMGS[albIdx].cap;
}
document.getElementById('albLb').addEventListener('click',function(e){if(e.target===this)albClose();});
document.addEventListener('keydown',e=>{
  if(document.getElementById('albLb').classList.contains('open')){
    if(e.key==='Escape')albClose();
    if(e.key==='ArrowLeft')albNav(-1);
    if(e.key==='ArrowRight')albNav(1);
  }
});

// ── Reveal ──
  const obs=new IntersectionObserver(entries=>{
    entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible');});
  },{threshold:0.07});
  document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));

// ── RSVP ──
function submitRSVP(){
  const name=document.getElementById('r-name').value.trim();
  if(!name){alert('Vui lòng điền tên hành khách!');return;}
  const yes=document.querySelector('input[name="att"]:checked').value==='yes';
  alert(yes?`✈ Check-in thành công! Cảm ơn ${name}. Chúng mình rất vui! 🎊`:`Cảm ơn ${name} đã thông báo. Rất tiếc khi bạn không thể tham dự! 💙`);
}

// ── Wishes ──
function wait(ms){return new Promise(r=>setTimeout(r,ms));}
async function addWish(){
  const name=document.getElementById('w-name').value.trim();
  const rel=document.getElementById('w-rel').value.trim();
  const txt=document.getElementById('w-txt').value.trim();
  if(!name||!txt){alert('Vui lòng điền tên và lời chúc!');return;}
  const btn=document.querySelector('.gb-send');
  if(btn&&btn.disabled)return;
  if(btn){btn.disabled=true;btn.textContent='✈ Đang Bay...';}
  document.getElementById('wish-loading').classList.add('active');
  try{
    await wait(1100);
    const feed=document.getElementById('wfeed');
    const d=document.createElement('div');
    d.className='gb-item';
    d.style.cssText='opacity:0;transform:translateY(8px);transition:opacity .4s,transform .4s;';
    d.innerHTML=`<div class="gb-author">✈ ${name}${rel?' · '+rel:''}</div><div class="gb-txt">${txt}</div>`;
    feed.insertBefore(d,feed.firstChild);
    requestAnimationFrame(()=>{d.style.opacity='1';d.style.transform='translateY(0)';});
    document.getElementById('w-name').value='';
    document.getElementById('w-rel').value='';
    document.getElementById('w-txt').value='';
  }finally{
    document.getElementById('wish-loading').classList.remove('active');
    if(btn){btn.disabled=false;btn.textContent='Gửi Lời Chúc Bay';}
  }
}
</script>
</body>
</html>