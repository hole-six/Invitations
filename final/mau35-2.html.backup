<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Thiệp Cưới – Tống Hiền & Thanh Tuyền Airlines</title>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;700&family=Dancing+Script:wght@400;600;700&family=Barlow+Condensed:ital,wght@0,300;0,400;0,600;0,700;1,300&family=Lato:wght@300;400&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#1a2744;--navy2:#233060;--blue:#2a3f7e;
  --accent:#c8a84b;--cream:#f5f2ec;--paper:#faf8f3;
  --text:#1a1a2e;--mid:#4a4a6a;--light:#8a8aaa;--border:#d0cfc0;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{background:#0d1117;font-family:'Barlow Condensed',sans-serif;color:var(--text);overflow-x:hidden;}

/* ══ PASSPORT GATE ══ */
#passport-gate{
  position:fixed;inset:0;z-index:9999;
  background:linear-gradient(160deg,#080c14 0%,#0f1a2e 45%,#1a2744 100%);
  display:flex;align-items:center;justify-content:center;
  overflow:hidden;
  transition:opacity .9s ease,visibility .9s ease;
}
#passport-gate.hidden{opacity:0;visibility:hidden;pointer-events:none;}
#passport-gate::before{
  content:'';position:absolute;inset:0;
  background-image:linear-gradient(rgba(200,168,75,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(200,168,75,.03) 1px,transparent 1px);
  background-size:44px 44px;
}
#passport-gate::after{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse at 15% 15%,rgba(200,168,75,.07) 0%,transparent 50%),radial-gradient(ellipse at 85% 85%,rgba(42,63,126,.14) 0%,transparent 50%);
}
.scan-line{
  position:absolute;left:0;right:0;height:1px;top:0;z-index:10;
  background:linear-gradient(90deg,transparent,rgba(200,168,75,.45) 30%,rgba(200,168,75,.85) 50%,rgba(200,168,75,.45) 70%,transparent);
  animation:scan 3s ease-in-out infinite;
}
@keyframes scan{0%{top:0;opacity:0;}8%{opacity:1;}92%{opacity:1;}100%{top:100%;opacity:0;}}

.gate-topbar{
  position:absolute;top:0;left:0;right:0;z-index:20;
  background:rgba(26,39,68,.75);backdrop-filter:blur(10px);
  border-bottom:1px solid rgba(200,168,75,.18);
  padding:10px 18px;
  display:flex;align-items:center;justify-content:space-between;
}
.gate-airline{font-family:'Oswald',sans-serif;font-size:.62rem;letter-spacing:4px;color:rgba(200,168,75,.82);text-transform:uppercase;display:flex;align-items:center;gap:7px;}
.gate-label{font-size:.46rem;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,.28);}
.status-dots{display:flex;gap:5px;align-items:center;}
.status-dot{width:5px;height:5px;border-radius:50%;background:rgba(200,168,75,.4);animation:dotPulse 1.5s ease-in-out infinite;}
.status-dot:nth-child(2){animation-delay:.2s;}
.status-dot:nth-child(3){animation-delay:.4s;}
@keyframes dotPulse{0%,100%{opacity:.3;}50%{opacity:1;}}

.passport-wrap{
  position:relative;z-index:5;
  display:flex;flex-direction:column;align-items:center;gap:24px;
  padding:72px 16px 90px;width:100%;max-width:360px;
}
.gate-heading{text-align:center;}
.gate-heading .gl{font-size:.46rem;letter-spacing:5px;text-transform:uppercase;color:rgba(200,168,75,.5);margin-bottom:5px;}
.gate-heading .gm{font-family:'Oswald',sans-serif;font-size:.95rem;letter-spacing:3px;color:rgba(255,255,255,.8);text-transform:uppercase;}

/* passport book */
.passport-book{
  width:100%;
  background:linear-gradient(150deg,#1b3a5a 0%,#0d2035 55%,#152840 100%);
  border-radius:10px;overflow:hidden;
  box-shadow:0 28px 65px rgba(0,0,0,.65),0 0 0 1px rgba(200,168,75,.16),inset 0 1px 0 rgba(255,255,255,.05);
  position:relative;
}
.passport-book::before{content:'';position:absolute;left:12px;top:0;bottom:0;width:1px;background:linear-gradient(to bottom,transparent,rgba(200,168,75,.12),transparent);}
.pp-cover{padding:22px 18px 0;position:relative;z-index:1;}
.pp-country{font-size:.42rem;letter-spacing:5px;text-transform:uppercase;color:rgba(200,168,75,.68);text-align:center;margin-bottom:12px;}
.pp-emblem{text-align:center;margin-bottom:10px;}
.pp-emblem svg{width:44px;height:44px;}
.pp-title{font-family:'Oswald',sans-serif;font-size:1.25rem;font-weight:400;letter-spacing:5px;color:rgba(255,255,255,.9);text-align:center;text-transform:uppercase;margin-bottom:2px;}
.pp-sub{font-size:.4rem;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,.25);text-align:center;margin-bottom:16px;}
.pp-rule{height:1px;background:linear-gradient(90deg,transparent,rgba(200,168,75,.32),transparent);margin-bottom:16px;}
.pp-data{background:linear-gradient(180deg,#f8f5ec,#ede9de);padding:16px 14px 0;position:relative;}
.pp-data::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#1a3a5c,#c8a84b,#1a3a5c);}
.pp-field{margin-bottom:11px;}
.pp-fl{font-size:.4rem;letter-spacing:3px;text-transform:uppercase;color:var(--light);margin-bottom:2px;font-family:'Lato',sans-serif;}
.pp-fv{font-family:'Oswald',sans-serif;font-size:.9rem;font-weight:500;color:var(--navy);letter-spacing:1px;border-bottom:1px solid var(--border);padding-bottom:3px;}
.pp-name{font-family:'Dancing Script',cursive;font-size:1.3rem;font-weight:700;color:var(--navy2);border-bottom:2px solid var(--accent);padding-bottom:3px;}
.pp-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:11px;}
.pp-grid .pp-field{margin-bottom:0;}
.mrz{background:#e0dbd0;padding:8px 10px 10px;margin:12px -14px 0;border-top:1px solid #ccc8b5;}
.mrz-line{font-family:'Courier New',monospace;font-size:.46rem;color:rgba(26,39,68,.45);letter-spacing:1.5px;line-height:1.7;word-break:break-all;}
.mrz-hl{color:rgba(26,39,68,.72);font-weight:700;}

/* open button */
.open-btn{
  width:100%;padding:15px 20px;
  background:linear-gradient(135deg,var(--navy),var(--blue));
  border:1px solid rgba(200,168,75,.38);
  color:rgba(200,168,75,.92);
  font-family:'Oswald',sans-serif;font-size:.68rem;letter-spacing:5px;text-transform:uppercase;
  cursor:pointer;transition:all .3s;border-radius:2px;
  display:flex;align-items:center;justify-content:center;gap:10px;
  position:relative;overflow:hidden;
}
.open-btn::before{content:'';position:absolute;inset:0;background:rgba(200,168,75,.0);transition:background .3s;}
.open-btn:hover::before{background:rgba(200,168,75,.08);}
.open-btn:hover{border-color:var(--accent);}
.open-btn:disabled{opacity:.5;cursor:not-allowed;}
.btn-plane{font-size:1.05rem;animation:bfloat 2s ease-in-out infinite;}
.btn-plane.flip{transform:scaleX(-1);display:inline-block;animation:bfloat 2s ease-in-out infinite .5s;}
@keyframes bfloat{0%,100%{transform:translateY(0);}50%{transform:translateY(-2px);}}

/* ══ STAMP OVERLAY ══ */
#stamp-overlay{
  position:fixed;inset:0;z-index:10000;
  background:rgba(6,10,20,.88);backdrop-filter:blur(7px);
  display:flex;align-items:center;justify-content:center;
  opacity:0;visibility:hidden;pointer-events:none;transition:opacity .3s;
}
#stamp-overlay.active{opacity:1;visibility:visible;pointer-events:auto;}
.stamp-card{
  width:min(330px,90vw);
  background:linear-gradient(155deg,#faf8f0,#ede9de);
  border-radius:5px;padding:26px 22px;
  box-shadow:0 35px 75px rgba(0,0,0,.6),0 0 0 1px rgba(200,168,75,.18);
  position:relative;overflow:hidden;transform:rotate(-1.5deg);
}
.stamp-card::before{content:'';position:absolute;inset:0;opacity:.02;background:repeating-linear-gradient(0deg,#000 0,#000 1px,transparent 1px,transparent 4px);}
.si{padding-bottom:14px;border-bottom:1px dashed #c0bba8;margin-bottom:14px;}
.si-label{font-size:.4rem;letter-spacing:3px;text-transform:uppercase;color:var(--light);font-family:'Lato',sans-serif;margin-bottom:2px;}
.si-val{font-family:'Oswald',sans-serif;font-size:.88rem;color:var(--navy);letter-spacing:1px;}
.si-val.big{font-family:'Dancing Script',cursive;font-size:1.35rem;color:var(--navy2);}
.si-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:9px;}
.stamp-ev{text-align:center;}
.stamp-ev-t{font-family:'Oswald',sans-serif;font-size:.9rem;letter-spacing:3px;color:var(--navy);text-transform:uppercase;}
.stamp-ev-d{font-size:.52rem;letter-spacing:3px;color:var(--accent);margin-top:2px;}
.stamp-mark{
  position:absolute;top:50%;left:50%;
  width:190px;height:190px;border-radius:50%;
  border:5px solid transparent;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  transform:translate(-50%,-50%) rotate(-18deg) scale(0);z-index:10;
}
.stamp-mark.stamped{animation:stampDrop .42s cubic-bezier(.2,1.6,.4,1) forwards;border-color:rgba(26,107,58,.78);}
@keyframes stampDrop{0%{transform:translate(-50%,-50%) rotate(-18deg) scale(2.4);opacity:0;}55%{opacity:1;}100%{transform:translate(-50%,-50%) rotate(-18deg) scale(1);opacity:1;}}
.stamp-mark::before{content:'';position:absolute;inset:7px;border:2px dashed rgba(26,107,58,.38);border-radius:50%;}
.stamp-mark::after{content:'';position:absolute;inset:16px;border:1.5px solid rgba(26,107,58,.22);border-radius:50%;}
.sm-text{font-family:'Oswald',sans-serif;font-size:2.3rem;font-weight:700;color:rgba(26,107,58,.82);letter-spacing:3px;line-height:1;text-align:center;}
.sm-sub{font-size:.38rem;letter-spacing:4px;text-transform:uppercase;color:rgba(26,107,58,.62);text-align:center;margin-top:4px;}
.sm-date{font-size:.42rem;color:rgba(26,107,58,.52);margin-top:5px;font-family:'Courier New',monospace;}

/* ══ MAIN CONTENT ══ */
#main-content{opacity:0;transition:opacity 1s ease;}
#main-content.revealed{opacity:1;}

/* ══ NAV ══ */
nav{
  position:fixed;top:0;left:0;right:0;z-index:300;
  display:flex;justify-content:center;gap:8px;flex-wrap:wrap;
  padding:7px 10px;
  background:rgba(26,39,68,.97);backdrop-filter:blur(8px);
  border-bottom:2px solid var(--accent);
}
nav a{font-size:20px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.62);text-decoration:none;transition:color .3s;font-family:'Barlow Condensed',sans-serif;white-space:nowrap;padding-right: 20px;}
nav a:hover{color:var(--accent);}
nav .pi{color:var(--accent);font-size:25px;}

/* ══ REVEAL ══ */
.reveal{opacity:0;transform:translateY(22px);transition:opacity .9s ease,transform .9s ease;}
.reveal.visible{opacity:1;transform:translateY(0);}

/* ══ SECTION INNER ══ */
.si-wrap{max-width:900px;margin:0 auto;padding:0 16px;}
.sec-label{font-size:.5rem;letter-spacing:5px;text-transform:uppercase;color:var(--blue);text-align:center;margin-bottom:7px;}
h2.sec-title{font-family:'Oswald',sans-serif;font-size:1.9rem;font-weight:400;color:var(--navy);text-align:center;letter-spacing:3px;text-transform:uppercase;}
.tline{width:52px;height:2px;background:linear-gradient(90deg,transparent,var(--accent),transparent);margin:11px auto 30px;}

/* ══ HERO BOARDING PASS ══ */
#hero{
  min-height:100svh;background:var(--cream);
  display:flex;align-items:center;justify-content:center;
  padding:76px 14px 56px;position:relative;overflow:hidden;
}
#hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 20% 20%,rgba(42,63,126,.1) 0%,transparent 50%),radial-gradient(ellipse at 80% 80%,rgba(26,39,68,.07) 0%,transparent 50%);}
.cloud{position:absolute;background:rgba(255,255,255,.5);border-radius:50px;filter:blur(2px);}
.c1{width:90px;height:30px;top:10%;left:4%;animation:drift 18s ease-in-out infinite;}
.c2{width:65px;height:22px;top:18%;right:6%;animation:drift 22s ease-in-out infinite reverse;}
.c3{width:115px;height:38px;bottom:28%;left:3%;animation:drift 25s ease-in-out infinite 3s;}
.c4{width:70px;height:24px;bottom:38%;right:5%;animation:drift 20s ease-in-out infinite 5s;}
@keyframes drift{0%,100%{transform:translateX(0);}50%{transform:translateX(14px);}}
.fp{position:absolute;top:50%;left:3%;right:3%;height:1px;border-top:2px dashed rgba(42,63,126,.1);transform:translateY(-50%);}

/* boarding pass */
.hero-bp{
  width:100%;max-width:940px;
  background:var(--paper);border-radius:14px;overflow:hidden;
  box-shadow:0 28px 72px rgba(26,39,68,.2),0 0 0 1px rgba(200,168,75,.1);
  position:relative;z-index:2;
  animation:bpReveal .9s ease .15s both;
}
@keyframes bpReveal{from{opacity:0;transform:translateY(28px);}to{opacity:1;transform:translateY(0);}}

/* bp header */
.bp-hd{
  background:linear-gradient(90deg,var(--navy),#1e3060);
  padding:13px 22px;
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  position:relative;overflow:hidden;
}
.bp-hd::after{content:'BOARDING PASS';position:absolute;right:-8px;top:50%;transform:translateY(-50%);font-family:'Oswald',sans-serif;font-size:2.6rem;font-weight:700;color:rgba(255,255,255,.04);letter-spacing:5px;pointer-events:none;}
.bp-airline{font-family:'Oswald',sans-serif;font-size:.82rem;letter-spacing:3px;text-transform:uppercase;color:white;display:flex;align-items:center;gap:7px;}
.bp-badge{background:rgba(200,168,75,.14);border:1px solid rgba(200,168,75,.38);padding:4px 10px;border-radius:2px;font-size:.48rem;letter-spacing:4px;text-transform:uppercase;color:var(--accent);font-weight:600;white-space:nowrap;}

/* passenger strip */
.bp-pax{
  background:linear-gradient(90deg,rgba(200,168,75,.05),transparent);
  border-bottom:2px dashed var(--border);
  padding:13px 22px;
  display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;
}
.pax-l .lbl{font-size:.42rem;letter-spacing:3px;text-transform:uppercase;color:var(--light);font-family:'Lato',sans-serif;margin-bottom:2px;}
.pax-name{font-family:'Dancing Script',cursive;font-size:1.5rem;font-weight:700;color:var(--navy2);}
.pax-r{text-align:right;}
.pax-r .lbl{font-size:.42rem;letter-spacing:3px;text-transform:uppercase;color:var(--light);font-family:'Lato',sans-serif;margin-bottom:2px;}
.pax-flight{font-family:'Oswald',sans-serif;font-size:.95rem;letter-spacing:2px;color:var(--navy);}

/* bp body */
.bp-body{display:grid;grid-template-columns:1fr 200px;}

/* main left */
.bp-main{padding:20px 22px 18px;border-right:2px dashed var(--border);display:flex;flex-direction:column;gap:14px;}

/* route */
.bp-route{display:flex;align-items:center;gap:0;}
.bp-port{flex:1;}
.bp-port .code{font-family:'Oswald',sans-serif;font-size:2.2rem;font-weight:700;color:var(--navy);letter-spacing:2px;line-height:1;}
.bp-port .city{font-size:.46rem;letter-spacing:3px;text-transform:uppercase;color:var(--light);margin-top:2px;}
.bp-route-mid{flex:1.2;display:flex;flex-direction:column;align-items:center;gap:3px;padding:0 8px;}
.route-line{width:100%;height:1px;background:linear-gradient(90deg,var(--border),var(--accent),var(--border));position:relative;}
.route-line::after{content:'✈';position:absolute;right:-1px;top:50%;transform:translateY(-50%);font-size:.85rem;color:var(--accent);background:var(--paper);padding:0 2px;}
.route-lbl{font-size:.4rem;letter-spacing:3px;color:var(--light);text-transform:uppercase;}

/* fields grid */
.bp-fields{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;}
.bp-field{display:flex;flex-direction:column;gap:2px;}
.bfl{font-size:.4rem;letter-spacing:3px;text-transform:uppercase;color:var(--light);font-family:'Lato',sans-serif;}
.bfv{font-family:'Oswald',sans-serif;font-size:.92rem;font-weight:600;color:var(--navy);letter-spacing:1px;border-bottom:1px solid var(--border);padding-bottom:2px;}
.bfv.xl{font-size:1.45rem;font-weight:700;border-bottom:none;}
.bfv.sm{font-size:.78rem;color:var(--mid);}
.bfv.script{font-family:'Dancing Script',cursive;font-size:1.05rem;border-bottom:none;}

.bp-notice{border-top:1px dotted var(--border);padding-top:9px;font-size:14px;color:var(--light);line-height:1.65;font-family:'Lato',sans-serif;font-weight:300;}

/* stub */
.bp-stub{padding:18px 14px;display:flex;flex-direction:column;gap:11px;}
.st-head{font-family:'Oswald',sans-serif;font-size:.65rem;letter-spacing:2px;color:var(--navy);display:flex;align-items:center;gap:5px;}
.st-sep{width:100%;height:1px;background:var(--border);}
.st-row .sl{font-size:.38rem;letter-spacing:3px;text-transform:uppercase;color:var(--light);font-family:'Lato',sans-serif;margin-bottom:1px;}
.st-row .sv{font-family:'Oswald',sans-serif;font-size:.9rem;color:var(--navy);letter-spacing:1px;}
.st-row .sv.script{font-family:'Dancing Script',cursive;font-size:1.15rem;color:var(--navy2);}
.st-verse{font-family:'Dancing Script',cursive;font-size:15px;color:var(--mid);line-height:1.65;font-style:italic;}
.barcode{display:flex;gap:2px;align-items:flex-end;height:30px;}
.barcode span{background:var(--navy);width:2px;}
.qr-box{width:48px;height:48px;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:.38rem;letter-spacing:1px;text-transform:uppercase;color:var(--light);position:relative;overflow:hidden;flex-shrink:0;}
.qr-box::before{content:'';position:absolute;inset:3px;background:repeating-linear-gradient(0deg,var(--border) 0,var(--border) 1px,transparent 1px,transparent 3px),repeating-linear-gradient(90deg,var(--border) 0,var(--border) 1px,transparent 1px,transparent 3px);opacity:.4;}

/* bp footer */
.bp-ft{background:var(--navy);padding:9px 22px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;}
.bp-ft-txt{font-family:'Oswald',sans-serif;font-size:.56rem;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,.68);}

.scroll-cue{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:4px;animation:fadeIn 1.4s ease 1.5s both;}
.scroll-cue span{font-size:.45rem;letter-spacing:3px;color:var(--mid);}
.scl{width:1px;height:26px;background:linear-gradient(to bottom,var(--navy),transparent);animation:pulse 2s infinite;}
@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
@keyframes pulse{0%,100%{opacity:.3;}50%{opacity:1;}}

/* ══ SECTIONS ══ */
/* 2 loi mo */
#loi-mo{background:var(--navy);padding:76px 0;}
#loi-mo .inner{max-width:580px;margin:0 auto;text-align:center;padding:0 16px;}
#loi-mo .sec-label{color:var(--accent);}
#loi-mo h2.sec-title{color:white;}
#loi-mo .tline{background:linear-gradient(90deg,transparent,var(--accent),transparent);}
.quote{font-family:'Dancing Script',cursive;font-size:1.45rem;font-weight:600;color:var(--accent);line-height:1.8;margin-bottom:18px;}
.body-txt{font-size:.86rem;font-weight:300;color:rgba(255,255,255,.73);line-height:2;font-family:'Lato',sans-serif;}
.fdiv{display:flex;align-items:center;gap:12px;margin:18px 0;opacity:.2;}
.fdiv::before,.fdiv::after{content:'';flex:1;height:1px;background:white;}
.fdiv span{color:white;}

/* 3 gioi thieu */
#gioi-thieu{background:var(--cream);padding:76px 0;}
.pcards{display:grid;grid-template-columns:1fr 46px 1fr;}
.pcard{background:var(--paper);border:1px solid var(--border);}
.pcard-hd{background:var(--navy);padding:11px 18px;display:flex;align-items:center;justify-content:space-between;}
.pcard-hd .role{font-size:.5rem;letter-spacing:4px;text-transform:uppercase;color:var(--accent);}
.pcard-body{padding:18px;}
.pcard-name{font-family:'Dancing Script',cursive;font-size:1.9rem;font-weight:700;color:var(--navy);margin-bottom:9px;}
.pcard-row{display:flex;gap:7px;margin-bottom:8px;align-items:flex-start;}
.pcfl{font-size:.44rem;letter-spacing:3px;text-transform:uppercase;color:var(--light);min-width:68px;padding-top:2px;font-family:'Lato',sans-serif;}
.pcfv{font-size:.78rem;color:var(--mid);line-height:1.6;font-family:'Lato',sans-serif;font-weight:300;}
.pcfv em{font-style:italic;color:var(--blue);}
.pcard-sep{border-top:1px dashed var(--border);margin:11px 0;}
.pcard-seat{display:flex;gap:10px;}
.seat-box{background:var(--navy);color:white;width:38px;height:38px;display:flex;align-items:center;justify-content:center;font-family:'Oswald',sans-serif;font-size:.95rem;font-weight:700;}
.pcard-mid{background:var(--navy);display:flex;align-items:center;justify-content:center;}
.pcard-mid span{font-family:'Dancing Script',cursive;font-size:1.3rem;color:white;font-weight:600;writing-mode:vertical-rl;letter-spacing:4px;}

/* 4 chuyen tinh */
#chuyen-tinh{background:var(--navy);padding:76px 0;}
#chuyen-tinh .sec-label{color:var(--accent);}
#chuyen-tinh h2.sec-title{color:white;}
#chuyen-tinh .tline{background:linear-gradient(90deg,transparent,var(--accent),transparent);}
.fl-route{display:flex;align-items:center;margin-bottom:24px;}
.fl-ap{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);padding:14px 16px;flex:1;}
.fl-ap .code{font-family:'Oswald',sans-serif;font-size:1.9rem;font-weight:700;color:white;letter-spacing:2px;margin-bottom:2px;}
.fl-ap .city{font-size:.56rem;letter-spacing:3px;text-transform:uppercase;color:var(--accent);}
.fl-mid{padding:0 14px;font-size:1.2rem;color:var(--accent);display:flex;flex-direction:column;align-items:center;gap:3px;}
.fl-mid span{font-size:.42rem;letter-spacing:2px;color:rgba(255,255,255,.32);}
.fl-items{list-style:none;}
.fl-item{display:flex;gap:14px;align-items:flex-start;padding:14px 0;border-bottom:1px solid rgba(255,255,255,.07);}
.fl-item:last-child{border-bottom:none;}
.fl-time{font-family:'Oswald',sans-serif;font-size:.88rem;color:var(--accent);min-width:48px;letter-spacing:1px;}
.fl-content h4{font-family:'Oswald',sans-serif;font-size:.85rem;font-weight:400;color:white;letter-spacing:1px;margin-bottom:4px;text-transform:uppercase;}
.fl-content p{font-size:.74rem;color:rgba(255,255,255,.55);line-height:1.7;font-family:'Lato',sans-serif;font-weight:300;}

/* 5 thoi gian */
#thoi-gian{background:var(--cream);padding:76px 0;}
.dep-board{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--border);overflow:hidden;}
.dep-card{background:var(--paper);padding:28px 24px;border-right:2px dashed var(--border);position:relative;}
.dep-card:last-child{border-right:none;}
.dep-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--navy),var(--blue),transparent);}
.dep-type{font-size:12px;letter-spacing:4px;text-transform:uppercase;color:var(--accent);margin-bottom:10px;display:flex;align-items:center;gap:7px;}
.dep-type::before{content:'✈';}
.dep-name{font-family:'Oswald',sans-serif;font-size:1.2rem;font-weight:600;color:var(--navy);letter-spacing:2px;text-transform:uppercase;margin-bottom:16px;line-height:1.4;}
.dep-row{display:flex;gap:7px;margin-bottom:9px;align-items:flex-start;}
.dep-lbl{font-size:.44rem;letter-spacing:3px;text-transform:uppercase;color:var(--light);min-width:68px;padding-top:2px;font-family:'Lato',sans-serif;}
.dep-val{font-size:.78rem;color:var(--mid);line-height:1.6;font-family:'Barlow Condensed',sans-serif;}
.dep-val strong{color:var(--navy);}
.map-btn{display:inline-flex;align-items:center;gap:5px;margin-top:12px;padding:7px 16px;border:1px solid var(--navy);font-size:.52rem;letter-spacing:3px;text-transform:uppercase;color:var(--navy);background:none;text-decoration:none;cursor:pointer;font-family:'Barlow Condensed',sans-serif;transition:all .3s;}
.map-btn:hover{background:var(--navy);color:white;}
.map-btn::before{content:'✈';font-size:.72rem;}

/* 6 lich trinh */
#lich-trinh{background:white;padding:76px 0;}
.itinerary{list-style:none;position:relative;max-width:560px;margin:0 auto;}
.itinerary::before{content:'';position:absolute;left:56px;top:0;bottom:0;width:1px;background:var(--border);}
.it-item{display:flex;gap:0;align-items:flex-start;padding:14px 0;}
.it-time{font-family:'Oswald',sans-serif;font-size:.88rem;color:var(--navy);min-width:56px;letter-spacing:1px;padding-right:16px;text-align:right;}
.it-dot{width:10px;height:10px;border-radius:50%;background:var(--navy);border:2px solid white;box-shadow:0 0 0 1px var(--navy);flex-shrink:0;margin-top:4px;position:relative;z-index:1;}
.it-content{padding-left:16px;}
.it-content h4{font-family:'Oswald',sans-serif;font-size:.85rem;color:var(--navy);font-weight:500;letter-spacing:1px;text-transform:uppercase;margin-bottom:3px;}
.it-content p{font-size:.72rem;color:var(--mid);line-height:1.7;font-family:'Lato',sans-serif;font-weight:300;}

/* ══ 7 ALBUM ══ */
#album{background:var(--navy);padding:76px 0;position:relative;overflow:hidden;}
#album::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 20% 50%,rgba(200,168,75,.05) 0%,transparent 60%),radial-gradient(ellipse at 80% 50%,rgba(42,63,126,.1) 0%,transparent 60%);pointer-events:none;}

.alb-wrap{max-width:960px;margin:0 auto;padding:0 16px;position:relative;z-index:1;}

/* ── MOSAIC GRID ── */
.mosaic{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  grid-template-rows:300px 220px;
  gap:4px;
}
/* hero cell spans 2 cols × 2 rows */
.mc{position:relative;overflow:hidden;cursor:pointer;background:#0d1828;}
.mc img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s ease,filter .6s ease;filter:brightness(.88) saturate(.9);}
.mc:hover img{transform:scale(1.07);filter:brightness(1) saturate(1.05);}
.mc.big{grid-column:1/3;grid-row:1/3;}
/* gradient fade at bottom */
.mc::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(10,16,30,.75) 0%,transparent 55%);pointer-events:none;}
/* caption */
.mc-cap{position:absolute;bottom:0;left:0;right:0;padding:16px 18px 14px;z-index:2;transform:translateY(6px);transition:transform .35s;}
.mc:hover .mc-cap{transform:translateY(0);}
.mc-cap .mc-tag{font-size:.38rem;letter-spacing:4px;text-transform:uppercase;color:var(--accent);font-family:'Barlow Condensed',sans-serif;margin-bottom:3px;}
.mc-cap .mc-title{font-family:'Dancing Script',cursive;font-size:1rem;color:white;font-weight:600;line-height:1.3;}
/* small date badge top-right */
.mc-date{position:absolute;top:10px;right:10px;z-index:3;background:rgba(8,14,26,.7);border:1px solid rgba(200,168,75,.22);padding:3px 8px;font-family:'Oswald',sans-serif;font-size:.4rem;letter-spacing:2px;color:rgba(200,168,75,.7);}
/* golden border on hover */
.mc:hover{outline:2px solid rgba(200,168,75,.45);outline-offset:-2px;}

/* ── POLAROID STRIP ── */
.pol-strip{
  display:flex;gap:14px;padding:28px 2px 4px;
  overflow-x:auto;scrollbar-width:none;
}
.pol-strip::-webkit-scrollbar{display:none;}
.pol{
  flex-shrink:0;background:#f8f5ec;
  padding:7px 7px 24px;
  box-shadow:0 6px 22px rgba(0,0,0,.55),0 1px 4px rgba(0,0,0,.3);
  position:relative;cursor:pointer;
  transition:transform .38s ease,box-shadow .38s ease;
  transform:rotate(var(--r));
}
.pol:nth-child(odd){--r:-2deg;}
.pol:nth-child(even){--r:1.8deg;}
.pol:nth-child(3n){--r:0.5deg;}
.pol:hover{transform:rotate(0deg) scale(1.1) translateY(-8px)!important;box-shadow:0 18px 44px rgba(0,0,0,.65);z-index:5;}
.pol img{width:110px;height:90px;object-fit:cover;display:block;filter:saturate(.88);}
.pol:hover img{filter:saturate(1);}
.pol .pol-label{position:absolute;bottom:5px;left:0;right:0;text-align:center;font-family:'Dancing Script',cursive;font-size:.72rem;color:#555;line-height:1;}
.pol::before{content:'';position:absolute;top:-7px;left:50%;transform:translateX(-50%);width:10px;height:10px;border-radius:50%;background:radial-gradient(circle at 38% 32%,#e5bb55,#b07e1e);box-shadow:0 2px 5px rgba(0,0,0,.45);}

/* ── LIGHTBOX ── */
.alb-lb{position:fixed;inset:0;z-index:6000;background:rgba(4,7,14,.96);backdrop-filter:blur(14px);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px;opacity:0;visibility:hidden;transition:opacity .32s,visibility .32s;padding:20px;}
.alb-lb.open{opacity:1;visibility:visible;}
.alb-lb-img{max-width:88vw;max-height:76vh;object-fit:contain;box-shadow:0 22px 65px rgba(0,0,0,.7);display:block;}
.alb-lb-caption{font-family:'Dancing Script',cursive;font-size:1.1rem;color:rgba(200,168,75,.78);text-align:center;}
.alb-lb-close{position:absolute;top:16px;right:18px;font-family:'Oswald',sans-serif;font-size:.52rem;letter-spacing:4px;color:rgba(200,168,75,.6);cursor:pointer;text-transform:uppercase;background:rgba(26,39,68,.6);padding:6px 14px;border:1px solid rgba(200,168,75,.2);transition:all .25s;}
.alb-lb-close:hover{color:var(--accent);border-color:var(--accent);}
.alb-lb-nav{display:flex;gap:10px;}
.alb-lb-btn{background:rgba(26,39,68,.55);border:1px solid rgba(200,168,75,.22);color:rgba(200,168,75,.65);padding:7px 18px;cursor:pointer;font-family:'Oswald',sans-serif;font-size:.56rem;letter-spacing:3px;transition:all .25s;}
.alb-lb-btn:hover{background:var(--navy);color:var(--accent);border-color:var(--accent);}

/* mobile album */
@media(max-width:600px){
  .mosaic{grid-template-columns:1fr 1fr;grid-template-rows:200px 160px 160px;}
  .mc.big{grid-column:1/3;grid-row:1/2;}
  .pol img{width:90px;height:75px;}
  .pol{padding:6px 6px 22px;}
}

/* 8 thiep moi */
#thiep-moi{background:white;padding:76px 0;}
.ticket-wrap{max-width:640px;margin:0 auto;background:var(--paper);border:1px solid var(--border);border-radius:10px;overflow:hidden;box-shadow:0 10px 36px rgba(26,39,68,.1);}
.tw-hd{background:var(--navy);padding:13px 22px;display:flex;align-items:center;justify-content:space-between;position:relative;overflow:hidden;}
.tw-hd::after{content:'TRAVEL';position:absolute;right:14px;top:50%;transform:translateY(-50%);font-family:'Oswald',sans-serif;font-size:1.9rem;color:rgba(255,255,255,.05);letter-spacing:4px;font-weight:700;}
.tw-airline{font-family:'Oswald',sans-serif;font-size:.8rem;letter-spacing:3px;color:white;display:flex;align-items:center;gap:7px;}
.tw-class{font-size:.52rem;letter-spacing:4px;color:var(--accent);font-family:'Barlow Condensed',sans-serif;}
.tw-body{display:grid;grid-template-columns:1fr 2px 1fr;}
.tw-l,.tw-r{padding:26px 22px;}
.tw-sep{background:repeating-linear-gradient(to bottom,var(--border) 0,var(--border) 6px,transparent 6px,transparent 12px);}
.tw-field{margin-bottom:13px;}
.tw-fl{font-size:.44rem;letter-spacing:3px;text-transform:uppercase;color:var(--light);font-family:'Lato',sans-serif;margin-bottom:2px;}
.tw-fv{font-family:'Oswald',sans-serif;font-size:.92rem;color:var(--navy);letter-spacing:1px;font-weight:500;}
.tw-fv.script{font-family:'Dancing Script',cursive;font-size:1.45rem;font-weight:700;color:var(--navy2);}
.tw-fv.xl{font-size:1.35rem;font-weight:700;}
.tw-note{font-size:.65rem;color:var(--mid);line-height:1.7;font-family:'Lato',sans-serif;font-weight:300;border-top:1px dashed var(--border);padding-top:11px;margin-top:3px;}
.tw-ft{background:var(--navy);padding:9px 22px;display:flex;align-items:center;justify-content:space-between;}
.tw-ft-txt{font-family:'Oswald',sans-serif;font-size:.58rem;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,.68);}

/* 9 rsvp */
#rsvp{background:var(--cream);padding:76px 0;}
.checkin-form{background:var(--paper);border:1px solid var(--border);max-width:480px;margin:0 auto;overflow:hidden;}
.ci-hd{background:var(--navy);padding:13px 22px;font-family:'Oswald',sans-serif;font-size:.75rem;letter-spacing:3px;color:white;text-transform:uppercase;display:flex;align-items:center;justify-content:space-between;}
.ci-hd .icon{color:var(--accent);}
.ci-body{padding:26px 22px;}
.ff{margin-bottom:15px;}
.ff label{display:block;font-size:12px;letter-spacing:3px;text-transform:uppercase;color:var(--blue);margin-bottom:5px;font-family:'Barlow Condensed',sans-serif;}
.ff input,.ff select{width:100%;border:none;border-bottom:2px solid var(--border);background:transparent;padding:7px 0;font-family:'Barlow Condensed',sans-serif;font-size:.9rem;color:var(--text);outline:none;transition:border-color .3s;letter-spacing:1px;}
.ff input:focus,.ff select:focus{border-bottom-color:var(--navy);}
.radio-g{display:flex;gap:12px;flex-wrap:wrap;margin-top:6px;}
.radio-o{display:flex;align-items:center;gap:6px;font-size:.8rem;color:var(--mid);cursor:pointer;font-family:'Barlow Condensed',sans-serif;}
.radio-o input{accent-color:var(--navy);}
.navy-btn{width:100%;padding:12px;background:var(--navy);color:white;border:none;font-size:.56rem;letter-spacing:5px;text-transform:uppercase;cursor:pointer;font-family:'Barlow Condensed',sans-serif;margin-top:7px;transition:background .3s;display:flex;align-items:center;justify-content:center;gap:7px;}
.navy-btn:hover{background:var(--blue);}
.navy-btn::before{content:'✈';}

/* 10 loi chuc */
#loi-chuc{background:white;padding:76px 0;}
.guestbook{background:var(--cream);border:1px solid var(--border);padding:24px;max-width:640px;margin:0 auto;}
.gb-meta{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:9px;}
.gb-meta input{border:none;border-bottom:2px solid var(--border);background:transparent;padding:7px 0;font-family:'Barlow Condensed',sans-serif;font-size:.85rem;color:var(--text);outline:none;letter-spacing:1px;width:100%;}
.gb-ta{width:100%;border:2px solid var(--border);background:white;padding:11px;font-family:'Barlow Condensed',sans-serif;font-size:.85rem;color:var(--text);outline:none;resize:none;min-height:70px;}
.gb-send{display:inline-flex;align-items:center;gap:7px;margin-top:9px;padding:8px 22px;background:transparent;border:2px solid var(--navy);font-size:.54rem;letter-spacing:4px;text-transform:uppercase;color:var(--navy);cursor:pointer;font-family:'Barlow Condensed',sans-serif;transition:all .3s;}
.gb-send::before{content:'✈';}
.gb-send:hover{background:var(--navy);color:white;}
.gb-feed{margin-top:22px;max-height:220px;overflow-y:auto;}
.gb-item{padding:11px 0;border-bottom:1px solid var(--border);}
.gb-item:last-child{border-bottom:none;}
.gb-author{font-size:.5rem;letter-spacing:3px;text-transform:uppercase;color:var(--blue);margin-bottom:3px;font-family:'Barlow Condensed',sans-serif;}
.gb-txt{font-family:'Dancing Script',cursive;font-size:1rem;color:var(--mid);line-height:1.6;}

/* 11 lien he */
#lien-he{background:var(--cream);padding:76px 0;}
.crew-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.crew-card{background:var(--paper);border:1px solid var(--border);overflow:hidden;}
.crew-hd{background:var(--navy);padding:11px 16px;display:flex;align-items:center;justify-content:space-between;}
.crew-role{font-size:.48rem;letter-spacing:4px;text-transform:uppercase;color:var(--accent);font-family:'Barlow Condensed',sans-serif;}
.crew-body{padding:18px 16px;}
.crew-name{font-family:'Oswald',sans-serif;font-size:1.05rem;font-weight:500;color:var(--navy);letter-spacing:2px;text-transform:uppercase;margin-bottom:12px;}
.crew-item{font-size:.76rem;color:var(--mid);margin-bottom:7px;line-height:1.65;font-family:'Lato',sans-serif;font-weight:300;}
.crew-item strong{display:block;color:var(--navy);font-weight:400;font-family:'Barlow Condensed',sans-serif;letter-spacing:1px;margin-bottom:1px;}
.crew-div{width:100%;height:1px;background:var(--border);margin:10px 0;}

/* 12 cam on */
#cam-on{background:var(--navy);padding:90px 16px;text-align:center;color:white;position:relative;overflow:hidden;}
.co-stars{position:absolute;inset:0;background:radial-gradient(1px 1px at 20% 20%,rgba(255,255,255,.4) 0%,transparent 100%),radial-gradient(1px 1px at 65% 12%,rgba(255,255,255,.28) 0%,transparent 100%),radial-gradient(1px 1px at 80% 30%,rgba(255,255,255,.28) 0%,transparent 100%);pointer-events:none;}
#cam-on .inner{max-width:500px;margin:0 auto;position:relative;z-index:1;}
.co-icon{font-size:2.2rem;opacity:.16;margin-bottom:16px;letter-spacing:8px;}
#cam-on h2{font-family:'Oswald',sans-serif;font-size:2rem;font-weight:400;color:white;margin-bottom:9px;letter-spacing:4px;text-transform:uppercase;}
#cam-on .subtitle{font-size:.8rem;font-weight:300;opacity:.66;line-height:2;margin-bottom:26px;font-family:'Lato',sans-serif;}
#cam-on .thanks-names{font-family:'Dancing Script',cursive;font-size:2.1rem;color:var(--accent);margin-bottom:20px;}
#cam-on .c-date{font-family:'Oswald',sans-serif;font-size:.55rem;letter-spacing:5px;opacity:.32;text-transform:uppercase;}

/* wish loading */
.wish-loading{position:fixed;inset:0;z-index:1200;display:flex;align-items:center;justify-content:center;background:rgba(26,39,68,.56);backdrop-filter:blur(3px);opacity:0;visibility:hidden;pointer-events:none;transition:opacity .26s ease,visibility .26s ease;}
.wish-loading.active{opacity:1;visibility:visible;pointer-events:auto;}
.wl-card{min-width:250px;max-width:86vw;background:rgba(250,248,243,.97);border:1px solid rgba(200,168,75,.72);box-shadow:0 16px 38px rgba(0,0,0,.22);border-radius:10px;padding:17px 20px;text-align:center;}
.wl-title{font-size:.56rem;letter-spacing:4px;text-transform:uppercase;color:var(--blue);margin-bottom:11px;}
.wl-track{position:relative;height:24px;margin:0 auto 11px;}
.wl-track::before{content:'';position:absolute;left:0;right:0;top:50%;border-top:2px dashed rgba(42,63,126,.32);transform:translateY(-50%);}
.wl-plane{position:absolute;left:0;top:50%;transform:translateY(-50%) rotate(-10deg);font-size:1.15rem;color:var(--navy);animation:wishFly 1.1s cubic-bezier(.4,0,.2,1) infinite;}
.wl-text{font-family:'Oswald',sans-serif;color:var(--navy);letter-spacing:2px;text-transform:uppercase;font-size:.85rem;}
@keyframes wishFly{0%{left:0;opacity:.3;transform:translateY(-50%) rotate(-16deg);}18%{opacity:1;}58%{transform:translateY(calc(-50% - 4px)) rotate(5deg);}100%{left:calc(100% - 20px);opacity:.3;transform:translateY(-50%) rotate(11deg);}}

/* ══ MOBILE ══ */
@media(max-width:600px){
  nav{padding:5px 7px;gap:5px;}
  nav a{font-size:.4rem;letter-spacing:1.5px;}

  /* passport gate */
  .passport-wrap{padding:66px 14px 80px;max-width:100%;}
  .gate-heading .gm{font-size:.82rem;}
  .gate-topbar{padding:8px 14px;}
  .gate-label{display:none;}

  /* hero bp — stack */
  .bp-hd{padding:11px 14px;flex-wrap:wrap;gap:7px;}
  .bp-hd::after{display:none;}
  .bp-pax{padding:11px 14px;flex-direction:column;align-items:flex-start;gap:7px;}
  .pax-r{text-align:left;}
  .bp-body{grid-template-columns:1fr;}
  .bp-main{border-right:none;border-bottom:2px dashed var(--border);padding:16px 14px 14px;}
  .bp-stub{padding:14px;}
  .bp-port .code{font-size:1.75rem;}
  .bp-fields{grid-template-columns:1fr 1fr;gap:11px;}
  .bfv.xl{font-size:1.2rem;}
  .bp-ft{padding:9px 14px;flex-wrap:wrap;gap:5px;}

  /* passenger cards */
  .pcards{grid-template-columns:1fr;}
  .pcard-mid{display:none;}

  /* dep board */
  .dep-board{grid-template-columns:1fr;}
  .dep-card{border-right:none;border-bottom:2px dashed var(--border);padding:22px 18px;}
  .dep-card:last-child{border-bottom:none;}

  /* ticket */
  .tw-body{grid-template-columns:1fr;}
  .tw-sep{display:none;}
  .tw-l,.tw-r{padding:20px 16px;}

  /* crew */
  .crew-grid{grid-template-columns:1fr;}

  /* guestbook */
  .gb-meta{grid-template-columns:1fr;}

  /* album — handled by album CSS block above */

  /* itinerary */
  .itinerary::before{left:50px;}
  .it-time{min-width:50px;font-size:.8rem;}

  /* flight log */
  .fl-route{flex-direction:column;gap:6px;}
  .fl-mid{flex-direction:row;padding:3px 0;}
  .fl-ap{width:100%;}

  /* sections */
  #loi-mo,#gioi-thieu,#chuyen-tinh,#thoi-gian,#lich-trinh,#album,#thiep-moi,#rsvp,#loi-chuc,#lien-he{padding:56px 0;}
  #cam-on{padding:66px 14px;}
  #hero{padding:66px 12px 46px;}
  .si-wrap{padding:0 12px;}
  h2.sec-title{font-size:1.65rem;}
  .quote{font-size:1.25rem;}
  #cam-on h2{font-size:1.75rem;}

  /* stamp */
  .stamp-mark{width:170px;height:170px;}
  .sm-text{font-size:2rem;}
}
</style>
</head>
<body>

<!-- PASSPORT GATE -->
<div id="passport-gate">
  <div class="scan-line"></div>
  <div class="gate-topbar">
    <div class="gate-airline">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="rgba(200,168,75,.8)"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
      Hiền Tuyền Airlines
    </div>
    <div class="status-dots"><div class="status-dot"></div><div class="status-dot"></div><div class="status-dot"></div></div>
    <div class="gate-label">Immigration · Passport Control</div>
  </div>

  <div class="passport-wrap">
    <div class="gate-heading">
      <div class="gl">✈ &nbsp; Cổng Kiểm Soát Xuất Cảnh &nbsp; ✈</div>
