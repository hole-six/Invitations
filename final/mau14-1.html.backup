  <!-- ──── SỰ KIỆN ──── -->
  <section id="s-event" class="band">
    <div class="band-inner">
      <p class="sec-label rv" style="color:var(--gold-light)">— Thời Gian & Địa Điểm —</p>
      <h2 class="sec-title rv light">Sự Kiện Trọng Đại</h2>
      <div class="ornament-rule rv" style="--sage-light:var(--gold)"><em style="color:var(--gold-light)">✦</em></div>

      <div class="event-trio rv">
        <div class="ev-card">
          <p class="ev-type">Lễ Gia Tiên</p>
          <p class="ev-name">Nghi Lễ Sáng</p>
          <p class="ev-detail">
            <strong>09:00 AM</strong><br>
            Chủ Nhật, 28/02/2021<br>
            Nhà cô dâu, Đồng Nai
          </p>
        </div>
        <div class="ev-card">
          <p class="ev-type">Tiệc Cưới</p>
          <p class="ev-name">Buổi Tối Trọng Đại</p>
