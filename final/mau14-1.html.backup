<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Thiệp Cưới | Nhã An & Duy Khánh</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=DM+Serif+Display:ital@0;1&family=Nunito:wght@300;400;500;600&family=Dancing+Script:wght@500;600;700&display=swap" rel="stylesheet">

<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}

:root{
  --ink:#1a2318;
  --sage:#2d4a38;
  --sage-mid:#3d6b50;
  --sage-light:#6a9e7f;
  --sage-pale:#b8d9c6;
  --cream:#f8f4ec;
  --cream-warm:#f2ead8;
  --petal:#e8a0a6;
  --petal-deep:#c96a72;
  --gold:#c9a84c;
  --gold-light:#e8cc82;
  --white:#fdfaf5;
}

html{scroll-behavior:smooth}

body{
  background:var(--cream);
  font-family:'Nunito',sans-serif;
  font-size:16px;
  color:var(--ink);
  overflow-x:hidden;
  cursor:default;
}

/* ═══════════════════════════════
   CANVAS - FALLING PETALS
════════════════════════════════ */
#petal-canvas{
  position:fixed;
  inset:0;
  z-index:9999;
  pointer-events:none;
}

/* ═══════════════════════════════
   INTRO / GATE
════════════════════════════════ */
#intro{
  position:fixed;
  inset:0;
  z-index:5000;
  background:var(--sage);
  display:flex;
  align-items:center;
  justify-content:center;
  transition:opacity 1.2s ease, visibility 1.2s;
  overflow:hidden;
}
#intro.away{opacity:0;visibility:hidden;pointer-events:none}

.gate-container{
  position:relative;
  width:min(480px,94vw);
  height:min(680px,94vh);
  display:flex;
}

.gate-half{
  flex:1;
  position:relative;
  overflow:hidden;
  transition:transform 1.6s cubic-bezier(.77,0,.18,1);
  background:var(--sage);
}
.gate-half.L{
  transform-origin:left center;
  border-right:1px solid rgba(200,168,82,.2);
}
.gate-half.R{
  transform-origin:right center;
  border-left:1px solid rgba(200,168,82,.2);
}
.gate-container.open .gate-half.L{transform:perspective(1000px) rotateY(-115deg)}
.gate-container.open .gate-half.R{transform:perspective(1000px) rotateY(115deg)}

.gate-half svg{width:100%;height:100%;display:block}

/* center card on gate */
.gate-center{
  position:absolute;
  top:50%;left:50%;
  transform:translate(-50%,-50%);
  z-index:20;
  text-align:center;
  background:var(--white);
  padding:28px 32px;
  width:230px;
  pointer-events:none;
  box-shadow:0 20px 60px rgba(0,0,0,.4);
}
.gate-center::before{
  content:'';
  position:absolute;
  inset:7px;
  border:1px solid rgba(201,168,76,.35);
  pointer-events:none;
}
.gc-tag{font-family:'Nunito',sans-serif;font-size:10px;letter-spacing:5px;text-transform:uppercase;color:var(--sage-light);margin-bottom:10px}
.gc-names{font-family:'Dancing Script',cursive;font-size:38px;color:var(--sage);line-height:1.2}
.gc-date{font-family:'Playfair Display',serif;font-size:10px;letter-spacing:4px;color:var(--sage-light);margin-top:8px}

/* open button */
.open-btn{
  position:absolute;
  bottom:14%;
  left:50%;
  transform:translateX(-50%);
  z-index:30;
  width:68px;height:68px;
  border-radius:50%;
  background:linear-gradient(135deg,var(--gold-light),var(--gold));
  border:none;
  cursor:pointer;
  font-family:'Playfair Display',serif;
  font-size:11px;
  letter-spacing:1px;
  color:var(--sage);
  font-weight:600;
  box-shadow:0 8px 28px rgba(0,0,0,.5), 0 0 0 1px rgba(201,168,76,.4), inset 0 1px 2px rgba(255,255,255,.4);
  transition:transform .25s, box-shadow .25s;
  animation:btnPulse 2.5s ease-in-out infinite;
}
.open-btn:hover{transform:translateX(-50%) scale(1.08)}
.open-btn.gone{opacity:0;pointer-events:none;transition:opacity .4s}

@keyframes btnPulse{
  0%,100%{box-shadow:0 8px 28px rgba(0,0,0,.5),0 0 0 0 rgba(201,168,76,.5)}
  50%{box-shadow:0 8px 28px rgba(0,0,0,.5),0 0 0 12px rgba(201,168,76,0)}
}

/* ═══════════════════════════════
   MAIN
════════════════════════════════ */
#main{
  opacity:0;
  display:none;
  transition:opacity 1s ease;
}
#main.show{opacity:1;display:block}

/* ─── HERO HEADER ─── */
.hero{
  min-height:100vh;
  background:var(--sage);
  position:relative;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}

/* animated background pattern */
.hero-bg{
  position:absolute;
  inset:0;
  background:
    radial-gradient(ellipse 80% 60% at 50% 40%, rgba(61,107,80,.6) 0%, transparent 70%),
    radial-gradient(ellipse 40% 40% at 20% 80%, rgba(45,74,56,.8) 0%, transparent 60%),
    radial-gradient(ellipse 40% 40% at 80% 10%, rgba(45,74,56,.8) 0%, transparent 60%);
}

/* SVG ornamental lines */
.hero-ornament{
  position:absolute;
  inset:0;
  width:100%;height:100%;
  opacity:.18;
}

.hero-content{
  position:relative;
  z-index:2;
  text-align:center;
  padding:0 24px;
}

.hero-eyebrow{
  font-family:'Nunito',sans-serif;
  font-size:12px;
  letter-spacing:8px;
  text-transform:uppercase;
  color:var(--sage-pale);
  margin-bottom:20px;
  opacity:0;
  animation:fadeUp .8s ease .4s forwards;
}

.hero-names{
  font-family:'Dancing Script',cursive;
  font-size:clamp(80px,17vw,130px);
  color:var(--white);
  line-height:1;
  opacity:0;
  animation:fadeUp .9s ease .6s forwards;
}
.hero-ampersand{
  display:block;
  font-family:'DM Serif Display',serif;
  font-style:italic;
  font-size:.38em;
  color:var(--gold-light);
  margin:4px 0;
}

.hero-divider{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:14px;
  margin:22px 0;
  opacity:0;
  animation:fadeUp .8s ease .8s forwards;
}
.hero-divider span{display:block;height:1px;width:80px;background:linear-gradient(to right,transparent,var(--gold))}
.hero-divider span:last-child{background:linear-gradient(to left,transparent,var(--gold))}
.hero-divider em{font-family:'Playfair Display',serif;font-size:14px;letter-spacing:3px;color:var(--gold-light)}

.hero-date{
  font-family:'Playfair Display',serif;
  font-size:clamp(14px,2.2vw,18px);
  letter-spacing:6px;
  color:rgba(248,244,236,.6);
  opacity:0;
  animation:fadeUp .8s ease 1s forwards;
}

/* scroll indicator */
.scroll-down{
  position:absolute;
  bottom:32px;
  left:50%;
  transform:translateX(-50%);
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:8px;
  opacity:0;
  animation:fadeIn 1s ease 2s forwards;
}
.scroll-down span{font-family:'Nunito',sans-serif;font-size:11px;letter-spacing:4px;color:rgba(184,217,198,.5);text-transform:uppercase}
.scroll-arrow{
  width:1px;height:44px;
  background:linear-gradient(to bottom,var(--gold),transparent);
  animation:scrollPulse 2s ease-in-out infinite;
}
@keyframes scrollPulse{
  0%,100%{opacity:.5;transform:scaleY(1)}
  50%{opacity:1;transform:scaleY(1.15)}
}

/* NAV */
.nav{
  position:sticky;
  top:0;z-index:500;
  background:rgba(26,35,24,.96);
  backdrop-filter:blur(12px);
  border-bottom:1px solid rgba(201,168,76,.12);
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:0;
}
.nav a{
  padding:15px 18px;
  font-family:'Nunito',sans-serif;
  font-size:11px;
  letter-spacing:2px;
  text-transform:uppercase;
  color:rgba(184,217,198,.6);
  cursor:pointer;
  transition:color .3s;
  border-bottom:2px solid transparent;
  text-decoration:none;
}
.nav a:hover,.nav a.active{
  color:var(--gold-light);
  border-bottom-color:var(--gold-light);
}

/* ─── SECTION SHELL ─── */
.sec{
  padding:100px 24px;
  max-width:720px;
  margin:0 auto;
}
.sec-full{padding:100px 0;overflow:hidden}

.sec-label{
  font-family:'Nunito',sans-serif;
  font-size:11px;
  letter-spacing:6px;
  text-transform:uppercase;
  color:var(--sage-light);
  text-align:center;
  margin-bottom:14px;
}
.sec-title{
  font-family:'DM Serif Display',serif;
  font-style:italic;
  font-size:clamp(42px,7vw,64px);
  font-weight:400;
  text-align:center;
  color:var(--sage);
  line-height:1.1;
}
.sec-title.light{color:var(--white)}
.ornament-rule{
  display:flex;align-items:center;justify-content:center;gap:12px;margin:24px 0 40px;
}
.ornament-rule::before,.ornament-rule::after{content:'';flex:1;max-width:100px;height:1px;background:linear-gradient(to right,transparent,var(--sage-light))}
.ornament-rule::after{background:linear-gradient(to left,transparent,var(--sage-light))}
.ornament-rule em{font-family:'Playfair Display',serif;font-size:22px;color:var(--sage-light)}

/* ─── REVEAL ANIMATIONS ─── */
.rv{
  opacity:0;
  transform:translateY(32px);
  transition:opacity .8s ease, transform .8s ease;
}
.rv.show{opacity:1;transform:none}
.rv-l{opacity:0;transform:translateX(-36px);transition:opacity .8s ease, transform .8s ease}
.rv-l.show{opacity:1;transform:none}
.rv-r{opacity:0;transform:translateX(36px);transition:opacity .8s ease, transform .8s ease}
.rv-r.show{opacity:1;transform:none}
.rv-z{opacity:0;transform:scale(.88);transition:opacity .8s ease, transform .8s ease}
.rv-z.show{opacity:1;transform:none}

/* ─── FORMAL INVITE ─── */
.invite-wrapper{
  background:var(--white);
  max-width:500px;
  margin:0 auto;
  position:relative;
  box-shadow:0 30px 90px rgba(26,35,24,.14), 0 4px 20px rgba(26,35,24,.06);
}
.invite-wrapper::before{
  content:'';
  position:absolute;
  inset:10px;
  border:1px solid rgba(201,168,76,.22);
  pointer-events:none;
  z-index:1;
}
.invite-wrapper::after{
  content:'';
  position:absolute;
  inset:18px;
  border:1px solid rgba(201,168,76,.1);
  pointer-events:none;
  z-index:1;
}

.invite-inner{
  padding:60px 52px;
  text-align:center;
  position:relative;
  z-index:2;
}

/* corner flourishes */
.invite-corner{
  position:absolute;
  width:40px;height:40px;
  z-index:3;
}
.invite-corner.tl{top:6px;left:6px}
.invite-corner.tr{top:6px;right:6px;transform:scaleX(-1)}
.invite-corner.bl{bottom:6px;left:6px;transform:scaleY(-1)}
.invite-corner.br{bottom:6px;right:6px;transform:scale(-1)}

.i-eyebrow{font-family:'Nunito',sans-serif;font-size:11px;letter-spacing:5px;text-transform:uppercase;color:var(--sage-light);margin-bottom:16px}
.i-together{font-family:'DM Serif Display',serif;font-style:italic;font-size:22px;color:var(--sage-light);margin-bottom:20px}
.i-name{font-family:'Dancing Script',cursive;font-size:clamp(54px,9vw,72px);color:var(--sage);line-height:1}
.i-surname{font-family:'Playfair Display',serif;font-size:12px;letter-spacing:4px;color:rgba(45,74,56,.5);margin-top:4px;margin-bottom:20px}
.i-and{font-family:'Nunito',sans-serif;font-size:11px;letter-spacing:5px;color:var(--gold);margin:18px 0}
.i-request{font-family:'Playfair Display',serif;font-style:italic;font-size:17px;color:var(--sage-light);line-height:2;margin:20px 0}

.date-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  border:1px solid rgba(201,168,76,.25);
  margin:24px 0;
}
.dg-cell{
  padding:14px 8px;
  text-align:center;
  border-right:1px solid rgba(201,168,76,.2);
}
.dg-cell:last-child{border-right:none}
.dg-num{font-family:'Playfair Display',serif;font-size:34px;color:var(--sage);line-height:1}
.dg-lbl{font-family:'Nunito',sans-serif;font-size:10px;letter-spacing:3px;text-transform:uppercase;color:rgba(45,74,56,.45);margin-top:4px}

.i-venue{font-family:'Nunito',sans-serif;font-size:13px;letter-spacing:3px;text-transform:uppercase;color:var(--sage-mid);line-height:2.4;margin-top:18px}
.i-reception{font-family:'DM Serif Display',serif;font-style:italic;font-size:24px;color:var(--sage-light);margin-top:14px}

/* ─── GREEN BAND ─── */
.band{
  background:var(--sage);
  padding:80px 24px;
  position:relative;
  overflow:hidden;
}
.band-inner{max-width:720px;margin:0 auto;position:relative;z-index:2}
.band::before{
  content:'';
  position:absolute;
  inset:0;
  background:
    radial-gradient(ellipse 60% 50% at 50% 0%, rgba(106,158,127,.25) 0%, transparent 60%),
    radial-gradient(ellipse 40% 40% at 10% 100%, rgba(61,107,80,.4) 0%, transparent 55%);
}

/* ─── COUPLE CARDS ─── */
.couple-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
  margin-top:44px;
}
.person-card{
  position:relative;
  overflow:hidden;
  aspect-ratio:3/4;
  cursor:pointer;
}
.person-card img{
  width:100%;height:100%;
  object-fit:cover;
  display:block;
  transition:transform .6s ease;
}
.person-card:hover img{transform:scale(1.04)}

.person-overlay{
  position:absolute;
  inset:0;
  background:linear-gradient(180deg,transparent 45%,rgba(26,35,24,.88) 100%);
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  padding:28px 24px;
  transition:opacity .4s;
}
.po-role{font-family:'Nunito',sans-serif;font-size:11px;letter-spacing:4px;text-transform:uppercase;color:var(--gold-light);margin-bottom:6px}
.po-name{font-family:'Dancing Script',cursive;font-size:48px;color:var(--white);line-height:1}
.po-family{font-family:'Nunito',sans-serif;font-size:13px;color:rgba(248,244,236,.65);margin-top:6px;line-height:1.9}

/* placeholder photo gradient */
.photo-placeholder{
  width:100%;height:100%;
  display:block;
}

/* ─── TOGETHER PHOTO ─── */
.together-photo{
  position:relative;
  overflow:hidden;
  height:360px;
  margin-top:20px;
  max-width:560px;
  margin-left:auto;
  margin-right:auto;
  cursor:pointer;
}
.together-photo img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s ease}
.together-photo:hover img{transform:scale(1.03)}
.together-photo .person-overlay{padding:32px}

/* ─── STORY TIMELINE ─── */
.timeline{
  margin-top:52px;
  position:relative;
  padding-bottom:20px;
}
.tl-line{
  position:absolute;
  left:50%;
  top:0;bottom:0;
  width:1px;
  background:linear-gradient(to bottom,transparent,var(--sage-light) 10%,var(--sage-light) 90%,transparent);
  transform:translateX(-50%);
}
.tl-row{
  display:grid;
  grid-template-columns:1fr 40px 1fr;
  align-items:start;
  margin-bottom:40px;
  gap:0;
}
.tl-dot-wrap{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:0;
  padding-top:6px;
  position:relative;
  z-index:2;
}
.tl-dot{
  width:12px;height:12px;
  background:var(--white);
  border:2px solid var(--sage-light);
  transform:rotate(45deg);
  flex-shrink:0;
}
.tl-body{padding:0 24px}
.tl-row.right .tl-body{grid-column:3;text-align:left}
.tl-row.right .tl-empty{grid-column:1}
.tl-row.left .tl-body{text-align:right}
.tl-row.left .tl-empty{grid-column:3}
.tl-yr{font-family:'Playfair Display',serif;font-size:11px;letter-spacing:3px;color:var(--sage-light);margin-bottom:7px}
.tl-title{font-family:'DM Serif Display',serif;font-style:italic;font-size:26px;color:var(--ink);line-height:1.2;margin-bottom:8px}
.tl-desc{font-family:'Nunito',sans-serif;font-size:14px;color:rgba(26,35,24,.6);line-height:1.9}

/* ─── MEMORY PHOTOS STRIP ─── */
.memory-strip{
  display:flex;
  gap:12px;
  justify-content:center;
  margin:40px 0;
  overflow:hidden;
}
.memory-photo{
  flex-shrink:0;
  width:180px;
  height:220px;
  overflow:hidden;
  position:relative;
  box-shadow:0 12px 36px rgba(0,0,0,.18);
  transition:transform .4s ease;
}
.memory-photo:hover{transform:translateY(-6px) scale(1.02) !important}
.memory-photo img{width:100%;height:100%;object-fit:cover;display:block}
.memory-photo:nth-child(1){transform:rotate(-3.5deg)}
.memory-photo:nth-child(2){transform:rotate(0deg);margin-top:-16px}
.memory-photo:nth-child(3){transform:rotate(2.5deg)}
.memory-photo:nth-child(4){transform:rotate(-1.5deg);margin-top:-8px}

/* ─── ALBUM GRID ─── */
.album-zone{
  background:var(--cream-warm);
  padding:100px 24px;
}
.album-inner{max-width:820px;margin:0 auto}

.album-mosaic{
  display:grid;
  grid-template-columns:1.4fr 1fr 1fr;
  grid-template-rows:auto;
  gap:10px;
  margin-top:44px;
}
.am-cell{
  position:relative;
  overflow:hidden;
  cursor:pointer;
}
.am-cell img,.am-cell .photo-placeholder{
  width:100%;height:100%;object-fit:cover;display:block;
  transition:transform .5s ease;
}
.am-cell:hover img,.am-cell:hover .photo-placeholder{transform:scale(1.06)}
.am-cell::after{
  content:'';
  position:absolute;inset:0;
  background:rgba(26,35,24,0);
  transition:background .3s;
}
.am-cell:hover::after{background:rgba(26,35,24,.12)}

.am-tall{grid-row:span 2}
.am-wide{grid-column:span 2}
.am-h1{height:200px}
.am-h2{height:412px}
.am-h3{height:220px}

/* ─── EVENTS ─── */
.events-inner{max-width:720px;margin:0 auto}
.event-trio{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:1px;
  margin-top:44px;
  background:rgba(184,217,198,.2);
  border:1px solid rgba(184,217,198,.2);
}
.ev-card{
  padding:40px 28px;
  text-align:center;
  background:rgba(45,74,56,.5);
  position:relative;
  overflow:hidden;
  transition:background .4s;
}
.ev-card:hover{background:rgba(61,107,80,.55)}
.ev-card::before{
  content:'';
  position:absolute;
  top:0;left:50%;transform:translateX(-50%);
  width:1px;height:0;
  background:var(--gold);
  transition:height .4s;
}
.ev-card:hover::before{height:32px}
.ev-type{font-family:'Nunito',sans-serif;font-size:11px;letter-spacing:4px;text-transform:uppercase;color:var(--gold-light);margin-bottom:12px}
.ev-name{font-family:'DM Serif Display',serif;font-style:italic;font-size:26px;color:var(--white);margin-bottom:14px}
.ev-detail{font-family:'Nunito',sans-serif;font-size:14px;color:rgba(248,244,236,.65);line-height:2.2}
.ev-detail strong{color:rgba(248,244,236,.9);font-weight:600}

/* schedule */
.schedule{margin-top:56px;border-top:1px solid rgba(184,217,198,.15)}
.sch-row{
  display:flex;
  align-items:flex-start;
  gap:24px;
  padding:22px 0;
  border-bottom:1px solid rgba(184,217,198,.1);
  transition:transform .3s;
}
.sch-row:hover{transform:translateX(6px)}
.sch-time{
  font-family:'Playfair Display',serif;
  font-style:italic;
  font-size:28px;
  color:var(--gold-light);
  min-width:80px;
}
.sch-name{font-family:'Nunito',sans-serif;font-size:15px;letter-spacing:1px;font-weight:600;color:var(--white);margin-bottom:5px}
.sch-desc{font-family:'Nunito',sans-serif;font-size:13px;color:rgba(248,244,236,.5);font-style:italic}

/* ─── RSVP ─── */
.rsvp-zone{
  padding:100px 24px;
  max-width:560px;
  margin:0 auto;
}
.rsvp-form{display:flex;flex-direction:column;gap:24px;margin-top:44px}
.f-field{display:flex;flex-direction:column;gap:8px}
.f-label{font-family:'Nunito',sans-serif;font-size:11px;letter-spacing:4px;text-transform:uppercase;color:var(--gold-light)}
.f-input{
  background:transparent;
  border:none;
  border-bottom:1px solid rgba(184,217,198,.3);
  padding:10px 0;
  font-family:'Playfair Display',serif;
  font-size:22px;
  font-style:italic;
  color:var(--white);
  outline:none;
  transition:border-color .3s;
}
.f-input:focus{border-color:var(--gold-light)}
.f-input::placeholder{color:rgba(184,217,198,.3);font-size:18px}
.attend-btns{display:flex;gap:10px;margin-top:4px}
.att{
  flex:1;
  padding:14px;
  border:1px solid rgba(184,217,198,.25);
  background:transparent;
  font-family:'Nunito',sans-serif;
  font-size:11px;
  letter-spacing:3px;
  text-transform:uppercase;
  color:rgba(248,244,236,.5);
  cursor:pointer;
  transition:all .3s;
}
.att.on,.att:hover{border-color:var(--gold-light);color:var(--gold-light)}
.submit{
  background:var(--gold);
  color:var(--sage);
  border:none;
  padding:18px;
  font-family:'Playfair Display',serif;
  font-size:13px;
  letter-spacing:5px;
  font-weight:600;
  cursor:pointer;
  transition:opacity .3s, transform .2s;
  margin-top:8px;
}
.submit:hover{opacity:.88;transform:translateY(-1px)}
.rsvp-done{
  display:none;
  text-align:center;
  padding:48px 24px;
  font-family:'Dancing Script',cursive;
  font-size:52px;
  color:var(--gold-light);
}

/* ─── WISHES ─── */
.wishes-list{
  display:flex;
  flex-direction:column;
  gap:14px;
  max-height:340px;
  overflow-y:auto;
  scrollbar-width:thin;
  scrollbar-color:rgba(184,217,198,.3) transparent;
  margin-bottom:32px;
}
.wish-card{
  padding:18px 20px;
  border-left:2px solid var(--sage-light);
  background:rgba(184,217,198,.07);
  transition:border-color .3s, background .3s;
}
.wish-card:hover{border-color:var(--gold);background:rgba(201,168,76,.06)}
.wc-name{font-family:'DM Serif Display',serif;font-style:italic;font-size:26px;color:var(--sage-pale);margin-bottom:6px}
.wc-text{font-family:'Nunito',sans-serif;font-size:14px;color:rgba(248,244,236,.6);line-height:1.9}

.wish-form{display:flex;flex-direction:column;gap:14px}
.w-inp{
  background:rgba(255,255,255,.05);
  border:1px solid rgba(184,217,198,.2);
  padding:14px 18px;
  font-family:'Playfair Display',serif;
  font-style:italic;
  font-size:20px;
  color:var(--white);
  outline:none;
  transition:border-color .3s;
}
.w-inp:focus{border-color:var(--sage-light)}
.w-inp::placeholder{color:rgba(184,217,198,.28);font-size:17px}
.w-btn{
  background:transparent;
  border:1px solid var(--sage-light);
  color:var(--sage-pale);
  padding:16px;
  font-family:'Nunito',sans-serif;
  font-size:12px;
  letter-spacing:4px;
  text-transform:uppercase;
  cursor:pointer;
  transition:all .3s;
}
.w-btn:hover{background:var(--sage-light);color:var(--sage)}

/* ─── CONTACT ─── */
.contact-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:1px;
  margin-top:44px;
  background:rgba(184,217,198,.1);
  border:1px solid rgba(184,217,198,.1);
}
.contact-block{
  padding:28px 24px;
  text-align:center;
  background:rgba(45,74,56,.4);
  transition:background .3s;
}
.contact-block:hover{background:rgba(61,107,80,.45)}
.cb-role{font-family:'Nunito',sans-serif;font-size:11px;letter-spacing:4px;text-transform:uppercase;color:var(--gold-light);margin-bottom:10px}
.cb-name{font-family:'DM Serif Display',serif;font-style:italic;font-size:22px;color:var(--white);margin-bottom:8px}
.cb-phone{font-family:'Nunito',sans-serif;font-size:14px;color:rgba(248,244,236,.5);text-decoration:none;transition:color .3s;display:block}
.cb-phone:hover{color:var(--sage-pale)}

/* ─── CLOSING ─── */
.closing{
  background:var(--sage);
  padding:120px 24px 100px;
  text-align:center;
  position:relative;
  overflow:hidden;
}
.closing::before{
  content:'';
  position:absolute;
  inset:0;
  background:radial-gradient(ellipse 70% 50% at 50% 40%, rgba(106,158,127,.15) 0%, transparent 65%);
}
.closing-inner{position:relative;z-index:2}
.closing-names{
  font-family:'Dancing Script',cursive;
  font-size:clamp(68px,14vw,105px);
  color:var(--white);
  line-height:1.1;
  opacity:0;
  transition:opacity 1s ease, transform 1s ease;
  transform:translateY(20px);
}
.closing-names.show{opacity:1;transform:none}
.closing-date{
  font-family:'Playfair Display',serif;
  font-size:13px;
  letter-spacing:6px;
  color:rgba(201,168,76,.65);
  margin-top:14px;
}
.closing-msg{
  font-family:'Nunito',sans-serif;
  font-size:18px;
  color:rgba(248,244,236,.6);
  margin-top:28px;
  line-height:2;
  max-width:500px;
  margin-left:auto;
  margin-right:auto;
}
.wax{
  width:76px;height:76px;
  background:radial-gradient(circle at 35% 30%, var(--gold-light), var(--gold));
  border-radius:50%;
  margin:40px auto 0;
  display:flex;align-items:center;justify-content:center;
  font-family:'Playfair Display',serif;
  font-size:30px;color:var(--sage);
  box-shadow:0 8px 32px rgba(0,0,0,.4), inset 0 2px 4px rgba(255,255,255,.3);
  position:relative;
  animation:waxSpin 30s linear infinite;
}
.wax::before{
  content:'';
  position:absolute;
  inset:-6px;
  border-radius:50%;
  border:1px solid rgba(201,168,76,.35);
  animation:waxRing 3s ease-in-out infinite;
}
@keyframes waxRing{
  0%,100%{transform:scale(1);opacity:.5}
  50%{transform:scale(1.07);opacity:1}
}
@keyframes waxSpin{
  from{filter:hue-rotate(0deg)}
  to{filter:hue-rotate(15deg)}
}

/* ─── BASE ANIMATIONS ─── */
@keyframes fadeUp{
  from{opacity:0;transform:translateY(24px)}
  to{opacity:1;transform:none}
}
@keyframes fadeIn{
  to{opacity:1}
}

/* ─── BELL ─── */
.bell-wrap{
  position:absolute;
  top:0;
  left:50%;
  transform:translateX(-50%);
  z-index:40;
  display:flex;
  flex-direction:column;
  align-items:center;
  cursor:pointer;
  user-select:none;
}
.bell-chain{
  width:2px;
  height:28px;
  background:linear-gradient(to bottom, rgba(201,168,76,.5), rgba(201,168,76,.8));
}
.bell-svg{
  filter:drop-shadow(0 4px 12px rgba(0,0,0,.5));
  transform-origin:50% 0%;
  transition:filter .3s;
}
.bell-wrap:hover .bell-svg{
  filter:drop-shadow(0 4px 18px rgba(201,168,76,.7));
}
.bell-hint{
  font-family:'Nunito',sans-serif;
  font-size:9px;
  letter-spacing:3px;
  text-transform:uppercase;
  color:rgba(201,168,76,.6);
  margin-top:10px;
  animation:bellHintPulse 2s ease-in-out infinite;
}
@keyframes bellHintPulse{
  0%,100%{opacity:.4}
  50%{opacity:1}
}
@keyframes bellRing{
  0%  {transform:rotate(0deg)}
  10% {transform:rotate(18deg)}
  20% {transform:rotate(-16deg)}
  30% {transform:rotate(13deg)}
  40% {transform:rotate(-10deg)}
  50% {transform:rotate(7deg)}
  60% {transform:rotate(-5deg)}
  70% {transform:rotate(3deg)}
  80% {transform:rotate(-2deg)}
  90% {transform:rotate(1deg)}
  100%{transform:rotate(0deg)}
}
@keyframes gateShake{
  0%,100%{transform:translateX(0)}
  15%{transform:translateX(-7px)}
  30%{transform:translateX(7px)}
  45%{transform:translateX(-5px)}
  60%{transform:translateX(5px)}
  75%{transform:translateX(-3px)}
  88%{transform:translateX(3px)}
}
.bell-svg.ringing{
  animation:bellRing .8s ease forwards;
}
.gate-container.shaking{
  animation:gateShake .5s ease;
}

/* ─── RIBBON SEPARATOR ─── */
.ribbon{
  height:64px;
  background:var(--sage);
  position:relative;
  overflow:hidden;
}
.ribbon svg{width:100%;height:100%}

/* ─── RESPONSIVE ─── */
@media(max-width:768px){
  /* ── GATE / INTRO ── */
  .gate-container{
    width:99vw;
    height:min(58vw,340px);
  }
  .gate-center{width:150px;padding:12px 14px}
  .gc-tag{font-size:8px;letter-spacing:3px;margin-bottom:5px}
  .gc-names{font-size:22px;line-height:1.1}
  .gc-date{font-size:7px;letter-spacing:2px;margin-top:4px}
  .gate-center::before{inset:5px}
  .open-btn{width:48px;height:48px;font-size:9px;bottom:7%}
  .bell-chain{height:12px}
  .bell-hint{font-size:7px;margin-top:5px}
  .bell-svg{width:42px;height:48px}

  /* ── HERO ── */
  .hero-eyebrow{font-size:9px;letter-spacing:5px}
  .hero-names{font-size:clamp(60px,18vw,90px)}
  .hero-date{font-size:11px;letter-spacing:3px}
  .hero-divider span{width:40px}

  /* ── NAV ── */
  .nav{overflow-x:auto;justify-content:flex-start;flex-wrap:nowrap;padding:0 8px}
  .nav::-webkit-scrollbar{display:none}
  .nav a{padding:13px 12px;font-size:9px;letter-spacing:1.5px;white-space:nowrap}

  /* ── SECTIONS ── */
  .sec{padding:64px 20px}
  .band{padding:64px 20px}
  .album-zone{padding:64px 20px}
  .sec-title{font-size:clamp(32px,9vw,48px)}
  .sec-label{font-size:10px;letter-spacing:4px}
  .ornament-rule{margin:18px 0 28px}

  /* ── INVITE ── */
  .invite-wrapper{max-width:100%}
  .invite-inner{padding:40px 24px}
  .i-name{font-size:clamp(44px,12vw,60px)}
  .i-request{font-size:15px}
  .i-together{font-size:18px}
  .date-grid{grid-template-columns:repeat(2,1fr)}
  .dg-num{font-size:26px}
  .i-venue{font-size:11px;letter-spacing:2px}

  /* ── COUPLE ── */
  .couple-row{grid-template-columns:1fr}
  .person-card{aspect-ratio:4/5}
  .po-name{font-size:38px}
  .po-family{font-size:12px}
  .together-photo{height:280px}
  .together-photo .po-name{font-size:36px !important}

  /* ── MEMORY ── */
  .memory-strip{flex-wrap:wrap;justify-content:center;gap:8px;margin:28px 0}
  .memory-photo{width:42vw;height:52vw}
  .memory-photo:nth-child(1){transform:rotate(-2deg)}
  .memory-photo:nth-child(2){transform:rotate(1deg);margin-top:0}
  .memory-photo:nth-child(3){transform:rotate(-1.5deg)}
  .memory-photo:nth-child(4){transform:rotate(2deg);margin-top:0}

  /* ── TIMELINE ── */
  .timeline{margin-top:36px}
  .tl-line{left:16px}
  .tl-row{grid-template-columns:32px 1fr;margin-bottom:28px}
  .tl-row .tl-body{grid-column:2 !important;text-align:left !important;padding:0 0 0 12px}
  .tl-row .tl-empty{display:none}
  .tl-row .tl-dot-wrap{grid-column:1;padding-top:8px}
  .tl-title{font-size:20px}
  .tl-desc{font-size:13px}

  /* ── ALBUM ── */
  .album-inner{max-width:100%}
  .album-mosaic{
    grid-template-columns:1fr 1fr;
    gap:6px;
  }
  .am-tall{grid-row:unset}
  .am-wide{grid-column:span 2}
  .am-h1{height:44vw}
  .am-h2{height:44vw}
  .am-h3{height:44vw}

  /* ── EVENTS ── */
  .event-trio{grid-template-columns:1fr}
  .ev-card{padding:28px 20px}
  .ev-name{font-size:22px}
  .ev-detail{font-size:13px}
  .sch-time{font-size:22px;min-width:64px}
  .sch-name{font-size:13px}
  .sch-desc{font-size:12px}
  .sch-row{gap:16px;padding:18px 0}

  /* ── RSVP ── */
  .rsvp-zone{padding:64px 20px}
  .f-input{font-size:18px}
  .f-input::placeholder{font-size:15px}
  .submit{font-size:11px;letter-spacing:3px}
  .rsvp-done{font-size:40px}
  .att{font-size:10px;padding:12px}

  /* ── WISHES ── */
  .wc-name{font-size:20px}
  .wc-text{font-size:13px}
  .w-inp{font-size:17px}
  .w-inp::placeholder{font-size:15px}
  .w-btn{font-size:11px;letter-spacing:3px}

  /* ── CONTACT ── */
  .contact-grid{grid-template-columns:1fr}
  .cb-name{font-size:18px}
  .cb-phone{font-size:13px}

  /* ── CLOSING ── */
  .closing{padding:80px 20px 70px}
  .closing-names{font-size:clamp(52px,15vw,80px)}
  .closing-date{font-size:11px;letter-spacing:4px}
  .closing-msg{font-size:15px;max-width:100%}
}

@media(max-width:400px){
  .nav a{padding:11px 9px;font-size:8px}
  .hero-names{font-size:58px}
  .invite-inner{padding:32px 16px}
  .i-name{font-size:44px}
  .event-trio{gap:0}
  .album-mosaic{grid-template-columns:1fr}
  .am-wide{grid-column:unset}
  .am-h1,.am-h2,.am-h3{height:60vw}
  .couple-row{gap:12px}
}
</style>
</head>
<body>

<!-- FALLING PETALS CANVAS -->
<canvas id="petal-canvas"></canvas>

<!-- ═══════════════════════════════
     INTRO GATE
════════════════════════════════ -->
<div id="intro">
  <div class="gate-container" id="gateWrap">

    <!-- LEFT GATE PANEL -->
    <div class="gate-half L">
      <svg viewBox="0 0 240 680" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <rect width="240" height="680" fill="#1e3028"/>
        <!-- vertical bars -->
        <rect x="16" y="0" width="8" height="680" fill="#2d4a38" rx="4"/>
        <rect x="46" y="0" width="6" height="680" fill="#2d4a38" rx="3"/>
        <rect x="74" y="0" width="8" height="680" fill="#2d4a38" rx="4"/>
        <rect x="104" y="0" width="6" height="680" fill="#2d4a38" rx="3"/>
        <rect x="132" y="0" width="8" height="680" fill="#2d4a38" rx="4"/>
        <rect x="162" y="0" width="6" height="680" fill="#2d4a38" rx="3"/>
        <rect x="190" y="0" width="8" height="680" fill="#2d4a38" rx="4"/>
        <rect x="224" y="0" width="8" height="680" fill="#2d4a38" rx="4"/>
        <!-- golden spear tips -->
        <polygon points="20,0 16,28 24,28" fill="#c9a84c"/>
        <polygon points="50,0 46,24 54,24" fill="#c9a84c" opacity=".75"/>
        <polygon points="78,0 74,28 82,28" fill="#c9a84c"/>
        <polygon points="108,0 104,24 112,24" fill="#c9a84c" opacity=".75"/>
        <polygon points="136,0 132,28 140,28" fill="#c9a84c"/>
        <polygon points="166,0 162,24 170,24" fill="#c9a84c" opacity=".75"/>
        <polygon points="194,0 190,28 198,28" fill="#c9a84c"/>
        <polygon points="228,0 224,28 232,28" fill="#c9a84c"/>
        <!-- top arch curve -->
        <path d="M232,55 Q195,10 155,35 Q115,60 75,20 Q50,5 16,40" stroke="#c9a84c" stroke-width="2" fill="none" opacity=".6"/>
        <!-- horizontal rails -->
        <rect x="0" y="65" width="240" height="5" fill="#2d4a38" rx="2.5"/>
        <rect x="0" y="130" width="240" height="4" fill="#2d4a38" rx="2"/>
        <rect x="0" y="320" width="240" height="4" fill="#2d4a38" rx="2"/>
        <rect x="0" y="480" width="240" height="4" fill="#2d4a38" rx="2"/>
        <!-- decorative scrollwork center panel -->
        <g transform="translate(120,220)" fill="none" stroke="#b8d9c6" stroke-width="1.3" opacity=".75">
          <circle cx="0" cy="0" r="52"/>
          <circle cx="0" cy="0" r="38"/>
          <circle cx="0" cy="0" r="10"/>
          <path d="M-52,0 Q-35,-38 0,-38 Q35,-38 52,0"/>
          <path d="M0,-52 Q38,-35 38,0 Q38,35 0,52"/>
          <path d="M52,0 Q35,38 0,38 Q-35,38 -52,0"/>
          <path d="M0,52 Q-38,35 -38,0 Q-38,-35 0,-52"/>
          <!-- corner curls -->
          <path d="M-52,0 Q-65,-12 -60,-24 Q-50,-18 -52,0Z"/>
          <path d="M52,0 Q65,-12 60,-24 Q50,-18 52,0Z"/>
          <path d="M0,52 Q12,65 24,60 Q18,50 0,52Z"/>
          <path d="M0,-52 Q-12,-65 -24,-60 Q-18,-50 0,-52Z"/>
        </g>
        <!-- scrollwork between top bars -->
        <g fill="none" stroke="#b8d9c6" stroke-width="1" opacity=".55">
          <path d="M24,78 Q24,90 28,100 Q32,90 24,78Z" fill="#b8d9c6" opacity=".3"/>
          <path d="M84,78 Q84,90 88,100 Q92,90 84,78Z" fill="#b8d9c6" opacity=".3"/>
          <path d="M144,78 Q144,90 148,100 Q152,90 144,78Z" fill="#b8d9c6" opacity=".3"/>
          <ellipse cx="35" cy="106" rx="8" ry="9"/>
          <ellipse cx="95" cy="106" rx="8" ry="9"/>
          <ellipse cx="155" cy="106" rx="8" ry="9"/>
        </g>
        <!-- scrollwork lower -->
        <g fill="none" stroke="#b8d9c6" stroke-width="1" opacity=".5">
          <path d="M24,350 Q24,365 28,378 Q32,365 24,350Z" fill="#b8d9c6" opacity=".25"/>
          <path d="M84,350 Q84,365 88,378 Q92,365 84,350Z" fill="#b8d9c6" opacity=".25"/>
          <path d="M144,350 Q144,365 148,378 Q152,365 144,350Z" fill="#b8d9c6" opacity=".25"/>
          <ellipse cx="35" cy="384" rx="8" ry="9"/>
          <ellipse cx="95" cy="384" rx="8" ry="9"/>
          <ellipse cx="155" cy="384" rx="8" ry="9"/>
        </g>
        <!-- border stripe -->
        <rect x="232" y="0" width="8" height="680" fill="#2d4a38" rx="4"/>
        <rect x="0" y="676" width="240" height="4" fill="#c9a84c" opacity=".3"/>
      </svg>
    </div>

    <!-- RIGHT GATE PANEL (mirror) -->
    <div class="gate-half R">
      <svg viewBox="0 0 240 680" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <rect width="240" height="680" fill="#1e3028"/>
        <rect x="8" y="0" width="8" height="680" fill="#2d4a38" rx="4"/>
        <rect x="40" y="0" width="6" height="680" fill="#2d4a38" rx="3"/>
        <rect x="68" y="0" width="8" height="680" fill="#2d4a38" rx="4"/>
        <rect x="98" y="0" width="6" height="680" fill="#2d4a38" rx="3"/>
        <rect x="126" y="0" width="8" height="680" fill="#2d4a38" rx="4"/>
        <rect x="156" y="0" width="6" height="680" fill="#2d4a38" rx="3"/>
        <rect x="184" y="0" width="8" height="680" fill="#2d4a38" rx="4"/>
        <rect x="216" y="0" width="8" height="680" fill="#2d4a38" rx="4"/>
        <polygon points="12,0 8,28 16,28" fill="#c9a84c"/>
        <polygon points="44,0 40,24 48,24" fill="#c9a84c" opacity=".75"/>
        <polygon points="72,0 68,28 76,28" fill="#c9a84c"/>
        <polygon points="102,0 98,24 106,24" fill="#c9a84c" opacity=".75"/>
        <polygon points="130,0 126,28 134,28" fill="#c9a84c"/>
        <polygon points="160,0 156,24 164,24" fill="#c9a84c" opacity=".75"/>
        <polygon points="188,0 184,28 192,28" fill="#c9a84c"/>
        <polygon points="220,0 216,28 224,28" fill="#c9a84c"/>
        <path d="M8,55 Q45,10 85,35 Q125,60 165,20 Q190,5 224,40" stroke="#c9a84c" stroke-width="2" fill="none" opacity=".6"/>
        <rect x="0" y="65" width="240" height="5" fill="#2d4a38" rx="2.5"/>
        <rect x="0" y="130" width="240" height="4" fill="#2d4a38" rx="2"/>
        <rect x="0" y="320" width="240" height="4" fill="#2d4a38" rx="2"/>
        <rect x="0" y="480" width="240" height="4" fill="#2d4a38" rx="2"/>
        <g transform="translate(120,220)" fill="none" stroke="#b8d9c6" stroke-width="1.3" opacity=".75">
          <circle cx="0" cy="0" r="52"/>
          <circle cx="0" cy="0" r="38"/>
          <circle cx="0" cy="0" r="10"/>
          <path d="M-52,0 Q-35,-38 0,-38 Q35,-38 52,0"/>
          <path d="M0,-52 Q38,-35 38,0 Q38,35 0,52"/>
          <path d="M52,0 Q35,38 0,38 Q-35,38 -52,0"/>
          <path d="M0,52 Q-38,35 -38,0 Q-38,-35 0,-52"/>
          <path d="M-52,0 Q-65,-12 -60,-24 Q-50,-18 -52,0Z"/>
          <path d="M52,0 Q65,-12 60,-24 Q50,-18 52,0Z"/>
          <path d="M0,52 Q12,65 24,60 Q18,50 0,52Z"/>
          <path d="M0,-52 Q-12,-65 -24,-60 Q-18,-50 0,-52Z"/>
        </g>
        <g fill="none" stroke="#b8d9c6" stroke-width="1" opacity=".55">
          <path d="M16,78 Q16,90 20,100 Q24,90 16,78Z" fill="#b8d9c6" opacity=".3"/>
          <path d="M76,78 Q76,90 80,100 Q84,90 76,78Z" fill="#b8d9c6" opacity=".3"/>
          <path d="M136,78 Q136,90 140,100 Q144,90 136,78Z" fill="#b8d9c6" opacity=".3"/>
          <ellipse cx="27" cy="106" rx="8" ry="9"/>
          <ellipse cx="87" cy="106" rx="8" ry="9"/>
          <ellipse cx="147" cy="106" rx="8" ry="9"/>
        </g>
        <g fill="none" stroke="#b8d9c6" stroke-width="1" opacity=".5">
          <path d="M16,350 Q16,365 20,378 Q24,365 16,350Z" fill="#b8d9c6" opacity=".25"/>
          <path d="M76,350 Q76,365 80,378 Q84,365 76,350Z" fill="#b8d9c6" opacity=".25"/>
          <path d="M136,350 Q136,365 140,378 Q144,365 136,350Z" fill="#b8d9c6" opacity=".25"/>
          <ellipse cx="27" cy="384" rx="8" ry="9"/>
          <ellipse cx="87" cy="384" rx="8" ry="9"/>
          <ellipse cx="147" cy="384" rx="8" ry="9"/>
        </g>
        <rect x="0" y="0" width="8" height="680" fill="#2d4a38" rx="4"/>
        <rect x="0" y="676" width="240" height="4" fill="#c9a84c" opacity=".3"/>
      </svg>
    </div>

    <!-- CENTER CARD -->
    <div class="gate-center">
      <div class="gc-tag">Save The Date</div>
