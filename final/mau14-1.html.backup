          </div>
        </div>
        <div class="sch-row">
          <p class="sch-time">17:00</p>
          <div>
            <p class="sch-name">Đón Khách Tiệc Cưới</p>
            <p class="sch-desc">Tại Capella Gallery Hall, Quận 13</p>
          </div>
        </div>
        <div class="sch-row">
          <p class="sch-time">17:30</p>
          <div>
            <p class="sch-name">Khai Tiệc Mừng</p>
            <p class="sch-desc">Nhập tiệc và dùng bữa cùng hai gia đình</p>
          </div>
        </div>
        <div class="sch-row">
          <p class="sch-time">18:00</p>
          <div>
            <p class="sch-name">Lễ Trao Nhẫn &amp; Cắt Bánh</p>
            <p class="sch-desc">Khoảnh khắc thiêng liêng nhất của buổi tiệc</p>
          </div>
        </div>
        <div class="sch-row">
          <p class="sch-time">19:30</p>
          <div>
            <p class="sch-name">Chụp Ảnh Lưu Niệm</p>
            <p class="sch-desc">Cùng ghi lại những khoảnh khắc đáng nhớ</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ──── RSVP ──── -->
  <section id="s-rsvp" class="band" style="background:var(--ink)">
    <div class="rsvp-zone">
      <p class="sec-label rv" style="color:var(--gold-light)">— Xác Nhận Tham Dự —</p>
      <h2 class="sec-title rv light">R.S.V.P</h2>
      <p class="rv" style="text-align:center;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:16px;color:rgba(248,244,236,.45);margin-bottom:8px">
        Vui lòng xác nhận trước ngày <span style="color:var(--gold-light)">20/02/2021</span>
      </p>
      <div class="ornament-rule rv" style="--sage-light:rgba(201,168,76,.5)"><em style="color:var(--gold)">✦</em></div>

      <div class="rsvp-form rv" id="rsvpForm">
        <div class="f-field">
          <label class="f-label">Họ &amp; Tên</label>
          <input class="f-input" id="rsvpName" type="text" placeholder="Nguyễn Văn A…">
        </div>
        <div class="f-field">
          <label class="f-label">Số Điện Thoại</label>
          <input class="f-input" id="rsvpPhone" type="tel" placeholder="0xxx xxx xxx">
        </div>
        <div class="f-field">
          <label class="f-label">Số Người Tham Dự</label>
          <input class="f-input" id="rsvpNum" type="text" placeholder="2 người…">
        </div>
        <div class="f-field">
          <label class="f-label">Xác Nhận Tham Dự</label>
          <div class="attend-btns">
            <button class="att on" id="attY" onclick="setAtt('yes')">✓ Tham Dự</button>
            <button class="att" id="attN" onclick="setAtt('no')">✕ Không Thể</button>
          </div>
        </div>
        <button class="submit" onclick="submitRsvp()">Gửi Xác Nhận ✦</button>
      </div>
      <div class="rsvp-done" id="rsvpOk">
        Cảm ơn bạn! ✦<br>
        <span style="font-family:'Playfair Display',serif;font-size:14px;letter-spacing:3px;color:rgba(248,244,236,.5)">Chúng mình trân trọng sự hiện diện của bạn</span>
      </div>
    </div>
  </section>

  <!-- ──── LỜI CHÚC ──── -->
  <section id="s-wishes" class="band">
    <div class="band-inner" style="max-width:620px">
      <p class="sec-label rv" style="color:var(--gold-light)">— Lời Chúc Mừng —</p>
      <h2 class="sec-title rv light">Gửi Lời Chúc</h2>
      <div class="ornament-rule rv" style="--sage-light:rgba(201,168,76,.4)"><em style="color:var(--gold)">✦</em></div>

      <div class="wishes-list rv" id="wishList">
        <div class="wish-card">
          <p class="wc-name">Anh Minh &amp; Chị Lan</p>
          <p class="wc-text">Chúc hai bạn trăm năm hạnh phúc, mãi yêu thương và đồng hành bên nhau 💫</p>
        </div>
        <div class="wish-card">
          <p class="wc-name">Gia Đình Chú Tám</p>
          <p class="wc-text">Cầu chúc đôi uyên ương luôn vui vẻ, hạnh phúc và sớm có tin vui!</p>
        </div>
        <div class="wish-card">
          <p class="wc-name">Nhóm Bạn Đại Học</p>
          <p class="wc-text">Cuối cùng cũng đến ngày này rồi! Chúc mừng hai đứa nhé 🎉</p>
        </div>
      </div>

      <div style="width:100%;height:1px;background:rgba(184,217,198,.12);margin:28px 0"></div>

      <div class="wish-form rv">
        <input class="w-inp" id="wName" placeholder="Tên của bạn…">
        <textarea class="w-inp" id="wText" placeholder="Lời chúc tốt đẹp nhất…" style="height:80px;resize:none"></textarea>
        <button class="w-btn" onclick="addWish()">Gửi Lời Chúc ✦</button>
      </div>

      <!-- contact -->
      <p class="sec-label rv" style="color:var(--gold-light);margin-top:64px">— Liên Hệ Gia Đình —</p>
      <div class="contact-grid rv">
        <div class="contact-block">
          <p class="cb-role">Nhà Gái</p>
          <p class="cb-name">Ông Trịnh Văn Nôn</p>
          <a class="cb-phone" href="tel:0900000001">0900 000 001</a>
        </div>
        <div class="contact-block">
          <p class="cb-role">Nhà Gái</p>
          <p class="cb-name">Bà Lê Thị Minh Hiếu</p>
          <a class="cb-phone" href="tel:0900000002">0900 000 002</a>
        </div>
        <div class="contact-block">
          <p class="cb-role">Nhà Trai</p>
          <p class="cb-name">Ông Ngô Văn Phước</p>
          <a class="cb-phone" href="tel:0900000003">0900 000 003</a>
        </div>
        <div class="contact-block">
          <p class="cb-role">Nhà Trai</p>
          <p class="cb-name">Bà Giang Thị Tuyết</p>
          <a class="cb-phone" href="tel:0900000004">0900 000 004</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ──── CLOSING ──── -->
  <div class="closing" id="s-closing">
    <div class="closing-inner">
      <p style="font-family:'Nunito',sans-serif;font-size:11px;letter-spacing:6px;text-transform:uppercase;color:rgba(201,168,76,.6);margin-bottom:20px">✦ Trân Trọng ✦</p>
      <h2 class="closing-names" id="closingNames">Nhã An &amp; Duy Khánh</h2>
      <p class="closing-date">28 · 02 · 2021 &nbsp;—&nbsp; MÃI MÃI YÊU NHAU</p>
      <p class="closing-msg">
        Cảm ơn bạn đã dành thời gian quý báu đến chung vui cùng chúng mình.<br>
        Sự hiện diện của bạn là điều trân quý nhất trong ngày trọng đại này.
      </p>
      <div class="wax">✦</div>
    </div>
  </div>

</div><!-- /#main -->

<script>
/* ════════════════════════════════════
   FALLING PETALS — Canvas animation
════════════════════════════════════ */
(function(){
  const canvas = document.getElementById('petal-canvas');
  const ctx = canvas.getContext('2d');
  let W, H, petals = [];

  const COLORS = [
    'rgba(232,160,166,.85)',
    'rgba(201,104,114,.75)',
    'rgba(201,168,76,.6)',
    'rgba(184,217,198,.7)',
    'rgba(248,244,236,.65)',
    'rgba(255,182,193,.8)',
  ];

  function resize(){
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  function Petal(){
    this.reset = function(fromTop){
      this.x = Math.random() * W;
      this.y = fromTop ? -Math.random()*H*.3 : Math.random()*H;
      this.r = 3 + Math.random()*7;
      this.color = COLORS[Math.floor(Math.random()*COLORS.length)];
      this.vx = (Math.random()-.5)*1.2;
      this.vy = .5 + Math.random()*1.5;
      this.va = (Math.random()-.5)*.03;
      this.angle = Math.random()*Math.PI*2;
      this.wobble = Math.random()*Math.PI*2;
      this.wobbleSpeed = .02 + Math.random()*.04;
      this.type = Math.floor(Math.random()*3); // 0=oval, 1=heart, 2=leaf
      this.opacity = .4 + Math.random()*.6;
    };
    this.reset(false);
  }

  function drawOval(ctx, x, y, r, angle, color, opacity){
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(angle);
    ctx.globalAlpha = opacity;
    ctx.beginPath();
    ctx.ellipse(0, 0, r, r*.5, 0, 0, Math.PI*2);
    ctx.fillStyle = color;
    ctx.fill();
    ctx.restore();
  }

  function drawHeart(ctx, x, y, r, angle, color, opacity){
    const s = r*.7;
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(angle);
    ctx.globalAlpha = opacity;
    ctx.beginPath();
    ctx.moveTo(0, s*.3);
    ctx.bezierCurveTo(s*.8, -s*.3, s*1.4, s*.6, 0, s*1.2);
    ctx.bezierCurveTo(-s*1.4, s*.6, -s*.8, -s*.3, 0, s*.3);
    ctx.fillStyle = color;
    ctx.fill();
    ctx.restore();
  }

  function drawLeaf(ctx, x, y, r, angle, color, opacity){
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(angle);
    ctx.globalAlpha = opacity;
    ctx.beginPath();
    ctx.moveTo(0, -r);
    ctx.bezierCurveTo(r*.8, -r*.3, r*.8, r*.3, 0, r);
    ctx.bezierCurveTo(-r*.8, r*.3, -r*.8, -r*.3, 0, -r);
    ctx.fillStyle = color;
    ctx.fill();
    ctx.restore();
  }

  // init petals
  for(let i=0;i<80;i++){
    const p = new Petal();
    petals.push(p);
  }

  let running = true;
  function animate(){
    if(!running) return;
    ctx.clearRect(0, 0, W, H);
    petals.forEach(p => {
      p.wobble += p.wobbleSpeed;
      p.x += p.vx + Math.sin(p.wobble)*.5;
      p.y += p.vy;
      p.angle += p.va;
      if(p.y > H + 20) p.reset(true);

      if(p.type === 0) drawOval(ctx, p.x, p.y, p.r, p.angle, p.color, p.opacity);
      else if(p.type === 1) drawHeart(ctx, p.x, p.y, p.r*.6, p.angle, p.color, p.opacity);
      else drawLeaf(ctx, p.x, p.y, p.r, p.angle, p.color, p.opacity);
    });
    requestAnimationFrame(animate);
  }
  animate();

  // slow down petals after 8s to be less distracting
  setTimeout(()=>{
    petals.forEach(p=>{p.vy*=.5; p.opacity*=.65;});
  }, 8000);
})();

/* ════════════════════════════════════
   BELL SOUND — Web Audio API
════════════════════════════════════ */
function playBellSound(){
  try{
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    // bell tone: layered oscillators
    function tone(freq, gain, decay, type){
      const osc = ctx.createOscillator();
      const env = ctx.createGain();
      osc.type = type || 'sine';
      osc.frequency.setValueAtTime(freq, ctx.currentTime);
      env.gain.setValueAtTime(gain, ctx.currentTime);
      env.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + decay);
      osc.connect(env);
      env.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + decay);
    }
    tone(880,  0.35, 2.2, 'sine');
    tone(1320, 0.18, 1.6, 'sine');
    tone(2200, 0.08, 0.9, 'sine');
    tone(440,  0.12, 2.8, 'sine');
  }catch(e){}
}

/* ════════════════════════════════════
   RING BELL
════════════════════════════════════ */
let bellRung = false;
function ringBell(){
  if(bellRung) return;
  bellRung = true;

  // play sound
  playBellSound();

  // animate bell
  const svg = document.getElementById('bellSvg');
  svg.classList.add('ringing');

  // shake gate after short delay
  setTimeout(()=>{
    const wrap = document.getElementById('gateWrap');
    wrap.classList.add('shaking');
    wrap.addEventListener('animationend', ()=>{
      wrap.classList.remove('shaking');
      // after shake, hide bell hint and allow open
      const hint = document.querySelector('.bell-hint');
      if(hint) hint.style.opacity = '0';
      // auto-open after shake
      setTimeout(openGate, 200);
    }, {once:true});
  }, 400);

  // remove ringing class after animation
  svg.addEventListener('animationend', ()=>{
    svg.classList.remove('ringing');
  }, {once:true});
}

/* ════════════════════════════════════
   GATE OPEN
════════════════════════════════════ */
function openGate(){
  if(openGate._done) return;
  openGate._done = true;
  document.getElementById('openBtn').classList.add('gone');
  document.getElementById('bellWrap').style.pointerEvents = 'none';
  document.getElementById('gateWrap').classList.add('open');
  setTimeout(()=>{
    document.getElementById('intro').classList.add('away');
    const main = document.getElementById('main');
    main.style.display = 'block';
    main.classList.add('show');
    checkReveal();
  }, 1800);
}

// click gate panels also triggers bell → open
document.querySelectorAll('.gate-half').forEach(p=>p.addEventListener('click', ()=>{
  if(!bellRung) ringBell();
  else openGate();
}));

/* ════════════════════════════════════
   SCROLL REVEAL
════════════════════════════════════ */
function checkReveal(){
  const vH = window.innerHeight;
  document.querySelectorAll('.rv:not(.show),.rv-l:not(.show),.rv-r:not(.show),.rv-z:not(.show)').forEach(el=>{
    const r = el.getBoundingClientRect();
    if(r.top < vH * .91){
      // stagger siblings with small delay
      const parent = el.parentElement;
      const same = parent.querySelectorAll('.rv:not(.show),.rv-l:not(.show),.rv-r:not(.show),.rv-z:not(.show)');
      let delay = 0;
      same.forEach(s=>{
        const sr = s.getBoundingClientRect();
        if(sr.top < vH * .91){
          setTimeout(()=>s.classList.add('show'), delay);
          delay += 100;
        }
      });
    }
  });
  // closing names
  const cn = document.getElementById('closingNames');
  if(cn){
    const r = cn.getBoundingClientRect();
    if(r.top < vH * .9) cn.classList.add('show');
  }
}
window.addEventListener('scroll', checkReveal, {passive:true});

/* ════════════════════════════════════
   NAV ACTIVE STATE
════════════════════════════════════ */
const secIds = ['s-invite','s-couple','s-story','s-album','s-event','s-rsvp','s-wishes'];
window.addEventListener('scroll', ()=>{
  const mid = window.scrollY + window.innerHeight*.35;
  const links = document.querySelectorAll('.nav a');
  secIds.forEach((id,i)=>{
    const el = document.getElementById(id);
    if(!el) return;
    links[i]?.classList.toggle('active', mid >= el.offsetTop && mid < el.offsetTop + el.offsetHeight);
  });
}, {passive:true});

function gotoSec(id){
  document.getElementById(id)?.scrollIntoView({behavior:'smooth'});
}

/* ════════════════════════════════════
   RSVP
════════════════════════════════════ */
let attChoice = 'yes';
function setAtt(v){
  attChoice = v;
  document.getElementById('attY').classList.toggle('on', v==='yes');
  document.getElementById('attN').classList.toggle('on', v==='no');
}
function submitRsvp(){
  const name = document.getElementById('rsvpName').value.trim();
  if(!name){alert('Vui lòng nhập tên!');return}
  document.getElementById('rsvpForm').style.display = 'none';
  document.getElementById('rsvpOk').style.display = 'block';
}

/* ════════════════════════════════════
   WISHES
════════════════════════════════════ */
function addWish(){
  const name = document.getElementById('wName').value.trim();
  const text = document.getElementById('wText').value.trim();
  if(!name||!text){alert('Vui lòng nhập tên và lời chúc!');return}
  const list = document.getElementById('wishList');
  const el = document.createElement('div');
  el.className = 'wish-card';
  el.innerHTML = `<p class="wc-name">${name}</p><p class="wc-text">${text}</p>`;
  el.style.opacity = '0';
  el.style.transform = 'translateY(14px)';
  el.style.transition = 'opacity .5s, transform .5s';
  list.prepend(el);
  requestAnimationFrame(()=>{
    requestAnimationFrame(()=>{
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
  });
  document.getElementById('wName').value = '';
  document.getElementById('wText').value = '';
}
</script>
</body>
</html>