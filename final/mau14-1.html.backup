  <!-- ──── CHUYỆN TÌNH ──── -->
  <section id="s-story" style="background:var(--cream-warm)">
    <div class="sec">
      <p class="sec-label rv">— Hành Trình —</p>
      <h2 class="sec-title rv">Chuyện Tình Yêu</h2>
      <div class="ornament-rule rv"><em>✦</em></div>

      <!-- memory photos scattered -->
      <div class="memory-strip rv">
        <div class="memory-photo">
          <img src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img4-4.jpg" alt="Kỷ niệm" loading="lazy">
        </div>
        <div class="memory-photo">
          <img src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img5-4.jpg" alt="Hẹn hò" loading="lazy">
        </div>
        <div class="memory-photo">
          <img src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img7-4.jpg" alt="Cầu hôn" loading="lazy">
        </div>
        <div class="memory-photo">
          <img src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img6-5.jpg" alt="Tình yêu" loading="lazy">
        </div>
      </div>

      <!-- timeline -->
      <div class="timeline">
        <div class="tl-line"></div>

        <div class="tl-row left rv">
          <div class="tl-body">
            <p class="tl-yr">MÙA THU 2018</p>
            <p class="tl-title">Lần Đầu Gặp Gỡ</p>
            <p class="tl-desc">Một buổi chiều tình cờ, hai ánh mắt chạm nhau và cả thế giới như dừng lại…</p>
          </div>
          <div class="tl-dot-wrap"><div class="tl-dot"></div></div>
          <div class="tl-empty"></div>
        </div>

        <div class="tl-row right rv">
          <div class="tl-empty"></div>
          <div class="tl-dot-wrap"><div class="tl-dot"></div></div>
          <div class="tl-body">
            <p class="tl-yr">THÁNG 2, 2019</p>
            <p class="tl-title">Ngày Hẹn Hò Đầu</p>
            <p class="tl-desc">Một tách cà phê, muôn câu chuyện — và anh biết đây là người của mãi mãi.</p>
          </div>
        </div>

        <div class="tl-row left rv">
          <div class="tl-body">
            <p class="tl-yr">MÙA HÈ 2020</p>
            <p class="tl-title">Chuyến Đi Đáng Nhớ</p>
            <p class="tl-desc">Cùng nhau lạc lối trong những con đường nhỏ, và tìm thấy nhau nhiều hơn.</p>
          </div>
          <div class="tl-dot-wrap"><div class="tl-dot"></div></div>
          <div class="tl-empty"></div>
        </div>

        <div class="tl-row right rv">
          <div class="tl-empty"></div>
          <div class="tl-dot-wrap"><div class="tl-dot"></div></div>
          <div class="tl-body">
            <p class="tl-yr">24.12.2020</p>
            <p class="tl-title">Lời Cầu Hôn</p>
            <p class="tl-desc">Dưới ánh đèn lung linh Giáng Sinh, anh quỳ xuống và hỏi điều trái tim đã biết từ lâu.</p>
          </div>
        </div>

        <div class="tl-row left rv">
          <div class="tl-body">
            <p class="tl-yr">28.02.2021</p>
            <p class="tl-title">✦ Ngày Kết Đôi</p>
            <p class="tl-desc">Hành trình tươi đẹp nhất bắt đầu — chúng mình chính thức trở thành một gia đình.</p>
          </div>
          <div class="tl-dot-wrap"><div class="tl-dot"></div></div>
          <div class="tl-empty"></div>
        </div>
      </div>
    </div>
  </section>

