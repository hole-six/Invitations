        </div>
        <div class="ev-card">
          <p class="ev-type">Địa Điểm</p>
          <p class="ev-name">Capella Hall</p>
          <p class="ev-detail">
            24 Đường 3<br>
            Phường 12, Quận 13<br>
            TP. Hồ Chí Minh
          </p>
        </div>
      </div>

      <!-- schedule -->
      <div class="schedule rv">
        <div class="sch-row">
          <p class="sch-time">09:00</p>
          <div>
            <p class="sch-name">Lễ Gia Tiên Nhà Gái</p>
            <p class="sch-desc">Nghi thức truyền thống tại nhà cô dâu</p>
          </div>
        </div>
        <div class="sch-row">
          <p class="sch-time">11:00</p>
