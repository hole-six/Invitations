            </div>
            <div class="ec-name">Buổi Tối Trọng Đại</div>
            <div class="ec-detail"><strong>17:00 PM</strong> — Đón khách<br><strong>17:30 PM</strong> — Nhập tiệc<br>Capella Gallery Hall</div>
          </div>
          <div class="event-card">
            <div class="ec-type">
              <svg width="12" height="12" color="var(--silver)" style="vertical-align:middle;margin-right:4px;"><use href="#ico-pin"/></svg>
              Địa Điểm
            </div>
            <div class="ec-name">Capella Hall</div>
            <div class="ec-detail">24 Đường 3<br>Phường 12, Quận 13<br>TP. Hồ Chí Minh</div>
          </div>
        </div>
        <div class="sec-label reveal" style="margin-top:60px;">
          <svg width="14" height="14" color="var(--silver)"><use href="#ico-clock"/></svg>
          Diễn Biến
          <svg width="14" height="14" color="var(--silver)"><use href="#ico-clock"/></svg>
