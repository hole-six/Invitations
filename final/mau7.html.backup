          <div class="sch-item"><div class="sch-time">17:00</div><div><div class="sch-info-name">Đón Khách Tiệc Cưới</div><div class="sch-info-desc">Tại Capella Gallery Hall, Quận 13</div></div></div>
          <div class="sch-item"><div class="sch-time">17:30</div><div><div class="sch-info-name">Khai Tiệc Mừng</div><div class="sch-info-desc">Nhập tiệc và dùng bữa cùng hai gia đình</div></div></div>
          <div class="sch-item">
            <div class="sch-time">18:00</div>
            <div>
              <div class="sch-info-name" style="display:flex;align-items:center;gap:6px;">
                <svg width="14" height="14" color="var(--silver)"><use href="#ico-ring"/></svg>
                Lễ Trao Nhẫn &amp; Cắt Bánh
              </div>
              <div class="sch-info-desc">Khoảnh khắc thiêng liêng nhất của buổi tiệc</div>
            </div>
          </div>
          <div class="sch-item"><div class="sch-time">19:30</div><div><div class="sch-info-name">Chụp Ảnh Lưu Niệm</div><div class="sch-info-desc">Cùng ghi lại những khoảnh khắc đáng nhớ</div></div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- S6: RSVP -->
  <div id="s-rsvp" class="rsvp-section">
    <div class="section" style="max-width:520px;">
      <div class="sec-label reveal">
        <svg width="14" height="14" color="var(--silver)"><use href="#ico-check"/></svg>
        Xác Nhận
        <svg width="14" height="14" color="var(--silver)"><use href="#ico-check"/></svg>
      </div>
      <h2 class="sec-title reveal">R.S.V.P</h2>
      <p class="reveal" style="text-align:center;font-family:'Playfair Display',serif;font-size:16px;font-style:italic;color:var(--silver-deep);margin-top:4px;">Vui lòng xác nhận trước ngày <span style="color:var(--ink);">20/02/2021</span></p>
      <div class="silver-rule reveal"><svg width="16" height="16" color="var(--silver-light)"><use href="#sf-sm"/></svg></div>
      <div class="rsvp-form reveal" id="rsvpForm">
        <div class="f-row"><label class="f-label">Họ &amp; Tên</label><input class="f-input" id="rsvpName" type="text" placeholder="Nguyễn Văn A…"></div>
        <div class="f-row"><label class="f-label">Số Điện Thoại</label><input class="f-input" id="rsvpPhone" type="tel" placeholder="0xxx xxx xxx"></div>
        <div class="f-row"><label class="f-label">Số Người</label><input class="f-input" id="rsvpNum" type="text" placeholder="2 người…"></div>
        <div class="f-row">
          <label class="f-label">Xác Nhận Tham Dự</label>
          <div class="attend-row">
            <button class="att-btn active" id="attY" onclick="setAtt('yes')">
              <svg width="14" height="14" color="currentColor"><use href="#ico-check"/></svg>
              Tham Dự
            </button>
            <button class="att-btn" id="attN" onclick="setAtt('no')">
              <svg width="14" height="14" color="currentColor"><use href="#ico-x"/></svg>
              Không Thể
            </button>
          </div>
        </div>
        <button class="submit-btn" onclick="submitRsvp()">
          Gửi Xác Nhận
          <svg width="14" height="14" color="white"><use href="#ico-send"/></svg>
        </button>
      </div>
      <div class="rsvp-success" id="rsvpOk">
        <svg width="44" height="44" color="var(--silver)" style="display:block;margin:0 auto 16px;"><use href="#sf-6"/></svg>
        Cảm ơn bạn!<br>
        <span style="font-family:'Cinzel',serif;font-size:10px;letter-spacing:3px;color:var(--silver);">Chúng mình trân trọng sự hiện diện của bạn</span>
      </div>
    </div>
  </div>

  <!-- S7: LỜI CHÚC -->
  <div id="s-wishes">
    <div class="dark-section">
      <div class="inner">
        <div class="sec-label reveal">
          <svg width="14" height="14" color="var(--silver)"><use href="#ico-heart"/></svg>
          Lời Chúc Mừng
          <svg width="14" height="14" color="var(--silver)"><use href="#ico-heart"/></svg>
        </div>
        <h2 class="sec-title reveal">Gửi Lời Chúc</h2>
        <div class="silver-rule reveal"><svg width="16" height="16" color="var(--silver-light)"><use href="#sf-sm"/></svg></div>
        <div class="wish-wall reveal" id="wishWall">
          <div class="wish-item"><div class="wish-name">Anh Minh &amp; Chị Lan</div><div class="wish-text">Chúc hai bạn trăm năm hạnh phúc, mãi yêu thương và đồng hành bên nhau</div></div>
          <div class="wish-item"><div class="wish-name">Gia Đình Chú Tám</div><div class="wish-text">Cầu chúc đôi uyên ương luôn vui vẻ, hạnh phúc và sớm có tin vui!</div></div>
          <div class="wish-item"><div class="wish-name">Nhóm Bạn Đại Học</div><div class="wish-text">Cuối cùng cũng đến ngày này rồi! Chúc mừng hai đứa nhé!</div></div>
        </div>
        <div class="silver-rule reveal" style="margin:24px 0;"><svg width="16" height="16" color="var(--silver-light)"><use href="#sf-sm"/></svg></div>
        <div class="wish-inputs reveal">
          <input class="w-input" id="wishName" placeholder="Tên của bạn…">
          <textarea class="w-input" id="wishText" placeholder="Lời chúc tốt đẹp nhất…" style="height:80px;resize:none;"></textarea>
          <button class="w-btn" onclick="addWish()">
            Gửi Lời Chúc
            <svg width="14" height="14" color="currentColor"><use href="#ico-send"/></svg>
          </button>
        </div>
        <div class="sec-label reveal" style="margin-top:60px;">
          <svg width="14" height="14" color="var(--silver)"><use href="#ico-pin"/></svg>
          Liên Hệ Gia Đình
          <svg width="14" height="14" color="var(--silver)"><use href="#ico-pin"/></svg>
        </div>
        <div class="contact-grid reveal">
          <div class="contact-block"><div class="cb-role">Nhà Gái</div><div class="cb-name">Ông Trịnh Văn Nôn</div><a class="cb-phone" href="tel:0900000001">0900 000 001</a></div>
          <div class="contact-block"><div class="cb-role">Nhà Gái</div><div class="cb-name">Bà Lê Thị Minh Hiếu</div><a class="cb-phone" href="tel:0900000002">0900 000 002</a></div>
          <div class="contact-block"><div class="cb-role">Nhà Trai</div><div class="cb-name">Ông Ngô Văn Phước</div><a class="cb-phone" href="tel:0900000003">0900 000 003</a></div>
          <div class="contact-block"><div class="cb-role">Nhà Trai</div><div class="cb-name">Bà Giang Thị Tuyết</div><a class="cb-phone" href="tel:0900000004">0900 000 004</a></div>
        </div>
      </div>
    </div>
  </div>

  <!-- CLOSING -->
  <div class="closing-section">
    <div class="closing-snow-bg">
      <svg class="csbg" style="width:230px;top:-25px;left:-25px;opacity:0.10;" color="#8090aa"><use href="#sf-6"/></svg>
      <svg class="csbg" style="width:205px;top:-20px;right:-20px;opacity:0.09;transform:scaleX(-1);" color="#8090aa"><use href="#sf-6"/></svg>
      <svg class="csbg" style="width:165px;bottom:-20px;left:18%;opacity:0.07;transform:scaleY(-1);" color="#8090aa"><use href="#sf-sm"/></svg>
      <svg class="csbg" style="width:145px;bottom:-20px;right:16%;opacity:0.07;transform:scale(-1,-1);" color="#8090aa"><use href="#sf-sm"/></svg>
    </div>
    <div class="closing-inner reveal">
      <div class="closing-names">Nhã An &amp; Duy Khánh</div>
      <div class="closing-date">
        <svg width="14" height="14" color="var(--silver)" style="vertical-align:middle;"><use href="#sf-sm"/></svg>
        28 · 02 · 2021 — Mãi Mãi Yêu Nhau
        <svg width="14" height="14" color="var(--silver)" style="vertical-align:middle;"><use href="#sf-sm"/></svg>
      </div>
      <p class="closing-msg">Cảm ơn bạn đã dành thời gian quý báu đến chung vui cùng chúng mình.<br>Sự hiện diện của bạn là điều trân quý nhất trong ngày trọng đại này.</p>
      <div class="wax-seal">
        <svg width="34" height="34" color="rgba(255,255,255,0.95)"><use href="#sf-6"/></svg>
      </div>
    </div>
  </div>

</div><!-- end #main -->

<script>
/* ══════════════════════════════════════════════
   ❄ SNOW — streaks + dots
══════════════════════════════════════════════ */
(function initSnow() {
  const canvas = document.getElementById('snowCanvas');
  const ctx    = canvas.getContext('2d');
  let W = 0, H = 0;
  const flakes = [];
  function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
  resize(); window.addEventListener('resize', resize);
  function newFlake() {
    const streak = Math.random() < 0.6;
    const speed  = streak ? Math.random()*7+5 : Math.random()*3+1.5;
    return { x: Math.random()*(W+60)-30, y: Math.random()*H*-0.5, speed, streak,
      r: streak ? Math.random()*0.8+0.35 : Math.random()*1.8+0.5,
      len: streak ? speed*(Math.random()*6+4) : 0,
      drift: (Math.random()-0.5)*0.28,
      opacity: streak ? Math.random()*0.38+0.1 : Math.random()*0.5+0.18 };
  }
  for (let i=0;i<240;i++){const f=newFlake();f.y=Math.random()*H;flakes.push(f);}
  function draw() {
    ctx.clearRect(0,0,W,H);
    flakes.forEach(f=>{
      f.y+=f.speed; f.x+=f.drift;
      ctx.globalAlpha=f.opacity;
      if (f.streak) {
        const g=ctx.createLinearGradient(f.x,f.y-f.len,f.x,f.y);
        g.addColorStop(0,'rgba(210,240,255,0)'); g.addColorStop(0.3,'rgba(220,244,255,0.55)');
        g.addColorStop(0.75,'rgba(232,248,255,0.95)'); g.addColorStop(1,'rgba(240,252,255,0.4)');
        ctx.beginPath(); ctx.moveTo(f.x,f.y-f.len); ctx.lineTo(f.x,f.y);
        ctx.strokeStyle=g; ctx.lineWidth=f.r; ctx.lineCap='round'; ctx.stroke();
      } else {
        ctx.beginPath(); ctx.arc(f.x,f.y,f.r,0,Math.PI*2);
        ctx.fillStyle='rgba(215,242,255,1)'; ctx.fill();
        if (f.r>1.3) {
          ctx.beginPath(); ctx.arc(f.x-f.r*0.3,f.y-f.r*0.3,f.r*0.28,0,Math.PI*2);
          ctx.fillStyle='rgba(255,255,255,0.8)'; ctx.fill();
        }
      }
      if (f.y>H+f.len+10){const nf=newFlake();nf.y=-nf.len-5;Object.assign(f,nf);}
      if (f.x<-40)f.x=W+20; if(f.x>W+40)f.x=-20;
    });
    ctx.globalAlpha=1; requestAnimationFrame(draw);
  }
  draw();
})();

/* ══════════════════════════════════════════════
   🧊 REALISTIC ICE CRACK SYSTEM
   Uses Voronoi-like shatter approach:
   cracks radiate from impact points and follow
   grain lines with tension physics simulation
══════════════════════════════════════════════ */
const IceCrack = (function() {
  const canvas = document.getElementById('iceCrackCanvas');
  const ctx    = canvas.getContext('2d');
  let W = window.innerWidth, H = window.innerHeight;

  /* Each crack is a tree: root origin, angle, segments with child branches */
  let allSegs = [];   // flat list of {pts, width, depth, opacity}
  let shards  = [];   // triangular shard fills
  let prog    = 0, targetProg = 0, rafId;

  function setSize() {
    W = canvas.width  = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  setSize(); window.addEventListener('resize', () => { setSize(); build(); });

  /* Realistic jagged path — uses "stress direction" + random micro-deflection */
  function buildPath(x0, y0, angle, totalLen, jitter) {
    const pts = [{x:x0, y:y0}];
    let x=x0, y=y0, a=angle;
    const steps = Math.max(5, Math.floor(totalLen / 8));
    const segLen = totalLen / steps;
    for (let i=0;i<steps;i++) {
      // Realistic: crack deflects more at grain boundaries
      const grainHit = Math.random() < 0.18;
      a += (Math.random()-0.5) * (grainHit ? jitter*2.5 : jitter*0.7);
      const sl = segLen * (0.6 + Math.random()*0.8);
      // Sub-pixel micro-roughness
      x += Math.cos(a)*sl + (Math.random()-0.5)*3;
      y += Math.sin(a)*sl + (Math.random()-0.5)*3;
      pts.push({x,y});
    }
    return {pts, endX:x, endY:y, endAngle:a};
  }

  /* Recursive crack tree — simulates stress propagation */
  function crackTree(x, y, angle, length, depth, jitter, list) {
    if (depth<=0 || length<10) return;
    const path = buildPath(x, y, angle, length, jitter * (1 + depth*0.1));
    const segWidth = Math.max(0.3, depth * 0.55);
    list.push({ pts: path.pts, width: segWidth, depth, drawn: false });

    // Primary branch (continues with slight angle change)
    if (Math.random() > 0.15) {
      const branchAt = Math.floor(path.pts.length * (0.35 + Math.random()*0.4));
      const bp = path.pts[branchAt];
      const ba = angle + (Math.PI/5 + Math.random()*Math.PI/3.5) * (Math.random()>0.5?1:-1);
      crackTree(bp.x, bp.y, ba, length*(0.35+Math.random()*0.38), depth-1, jitter*0.9, list);
    }
    // Secondary branch
    if (depth > 1 && Math.random() > 0.3) {
      const branchAt = Math.floor(path.pts.length * (0.55+Math.random()*0.4));
      const bp = path.pts[branchAt];
      const ba = angle - (Math.PI/4.5 + Math.random()*Math.PI/4) * (Math.random()>0.5?1:-1);
      crackTree(bp.x, bp.y, ba, length*(0.22+Math.random()*0.3), depth-2, jitter*0.85, list);
    }
    // Tip hairline
    if (depth>=3 && Math.random()>0.5) {
      crackTree(path.endX, path.endY, path.endAngle+(Math.random()-0.5)*0.8,
        length*0.18, 1, jitter*0.7, list);
    }
  }

  /* Build shard polygons between cracks for icy panel feel */
  function buildShards(segs) {
    const out = [];
    // Sample random triangles between nearby crack endpoints
    const pts = [];
    segs.forEach(s => {
      if (s.depth>=3) {
        for (let i=0;i<s.pts.length;i+=3) pts.push(s.pts[i]);
      }
    });
    // Create Delaunay-ish triangles by connecting nearby pts
    for (let i=0;i<pts.length;i++) {
      const a=pts[i];
      // find 2 nearest pts
      let dists=pts.map((p,j)=>({j,d:Math.hypot(p.x-a.x,p.y-a.y)}))
        .filter(({j,d})=>j!==i&&d>20&&d<W*0.18)
        .sort((x,y)=>x.d-y.d);
      if (dists.length>=2) {
        const b=pts[dists[0].j], c=pts[dists[1].j];
        // calc area — skip degenerate
        const area=Math.abs((b.x-a.x)*(c.y-a.y)-(c.x-a.x)*(b.y-a.y))*0.5;
        if (area>200 && area<W*H*0.003) out.push({a,b,c});
      }
    }
    return out.slice(0, 160);
  }

  function build() {
    allSegs = []; shards = [];

    // ── A. Impact points — simulate multiple strike points ──
    const impacts = [
      // Corners — always shatter
      {x:0,     y:0,     a:Math.PI*0.2,  l:W*0.55, d:6},
      {x:0,     y:0,     a:Math.PI*0.6,  l:W*0.48, d:5},
      {x:W,     y:0,     a:Math.PI*0.85, l:W*0.52, d:6},
      {x:W,     y:0,     a:Math.PI*0.42, l:W*0.46, d:5},
      {x:0,     y:H,     a:-Math.PI*0.2, l:W*0.5,  d:5},
      {x:0,     y:H,     a:-Math.PI*0.55,l:W*0.44, d:5},
      {x:W,     y:H,     a:-Math.PI*0.8, l:W*0.52, d:6},
      {x:W,     y:H,     a:-Math.PI*0.38,l:W*0.45, d:5},
      // Edge midpoints
      {x:W*.5,  y:0,     a:Math.PI*0.48+Math.random()*0.3, l:W*0.6, d:5},
      {x:W*.5,  y:H,     a:-Math.PI*0.52+Math.random()*0.3,l:W*0.55,d:5},
      {x:0,     y:H*.5,  a:Math.random()*0.4-0.2,           l:W*0.58,d:5},
      {x:W,     y:H*.5,  a:Math.PI+Math.random()*0.4-0.2,   l:W*0.56,d:5},
      // Interior cracks — random impact sites
      {x:W*0.25,y:H*0.3, a:Math.random()*Math.PI*2, l:W*0.35, d:4},
      {x:W*0.75,y:H*0.3, a:Math.random()*Math.PI*2, l:W*0.32, d:4},
      {x:W*0.35,y:H*0.65,a:Math.random()*Math.PI*2, l:W*0.38, d:4},
      {x:W*0.65,y:H*0.65,a:Math.random()*Math.PI*2, l:W*0.34, d:4},
      {x:W*0.5, y:H*0.45,a:Math.random()*Math.PI*2, l:W*0.28, d:3},
      {x:W*0.15,y:H*0.7, a:Math.random()*Math.PI*2, l:W*0.25, d:3},
      {x:W*0.82,y:H*0.72,a:Math.random()*Math.PI*2, l:W*0.27, d:3},
    ];
    impacts.forEach(({x,y,a,l,d}) => {
      // Each impact spawns 3-5 primary cracks
      const nRays = 3 + Math.floor(Math.random()*3);
      for (let k=0;k<nRays;k++) {
        const ra = a + (k/nRays)*Math.PI*2 + (Math.random()-0.5)*0.6;
        crackTree(x, y, ra, l*(0.5+Math.random()*0.6), d, 0.9, allSegs);
      }
    });

    // ── B. Dense grid of micro-cracks for icy texture ──
    const cols=11, rows=13;
    for (let c=0;c<cols;c++) for (let r=0;r<rows;r++) {
      const ox=(c+0.15+Math.random()*0.7)*W/cols;
      const oy=(r+0.15+Math.random()*0.7)*H/rows;
      const n=1+Math.floor(Math.random()*2);
      for (let k=0;k<n;k++) {
        crackTree(ox, oy, Math.random()*Math.PI*2,
          W*(0.04+Math.random()*0.12), 1+(Math.random()>0.6?1:0), 0.8, allSegs);
      }
    }

    // Sort by depth so deep cracks draw on top
    allSegs.sort((a,b)=>a.depth-b.depth);

    // Build shards after segs are ready
    shards = buildShards(allSegs);
    console.log(`Ice: ${allSegs.length} segs, ${shards.length} shards`);
  }

  function render(p) {
    ctx.clearRect(0,0,W,H);
    if (p < 0.005) return;

    const total = allSegs.length;

    // ── 1. Shard fills (icy panels between cracks) ──
    if (p > 0.12) {
      const sa = Math.min(0.18, (p-0.12)*0.25);
      shards.forEach(({a,b,c}) => {
        ctx.beginPath();
        ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.lineTo(c.x,c.y);
        ctx.closePath();
        // Ice shard: gradient from center
        const cx=(a.x+b.x+c.x)/3, cy=(a.y+b.y+c.y)/3;
        const maxD=Math.max(Math.hypot(a.x-cx,a.y-cy),Math.hypot(b.x-cx,b.y-cy),Math.hypot(c.x-cx,c.y-cy));
        const g=ctx.createRadialGradient(cx,cy,0,cx,cy,maxD);
        g.addColorStop(0,`rgba(230,246,255,${sa*1.4})`);
        g.addColorStop(0.5,`rgba(210,236,252,${sa*0.8})`);
        g.addColorStop(1,`rgba(190,225,250,${sa*0.3})`);
        ctx.fillStyle=g; ctx.fill();
      });
    }

    // ── 2. Crack lines ──
    allSegs.forEach((seg, si) => {
      const startFrac = (si/total)*0.52;
      const cp = Math.max(0, Math.min(1, (p - startFrac)/Math.max(0.04, 0.48-startFrac*0.25)));
      if (cp<=0) return;

      const pts = seg.pts;
      const nPts = Math.max(2, Math.floor(pts.length*cp));
      const df = seg.depth/6;

      // Glow halo — bigger for deeper cracks
      if (seg.depth >= 2) {
        ctx.beginPath();
        ctx.moveTo(pts[0].x,pts[0].y);
        for (let i=1;i<nPts;i++) ctx.lineTo(pts[i].x,pts[i].y);
        const glowAlpha = Math.min(0.35, (0.05+df*0.5)*Math.min(1,p*3));
        const glowW = seg.depth*2.5+2;
        ctx.strokeStyle=`rgba(170,218,255,${glowAlpha})`;
        ctx.lineWidth=glowW; ctx.lineCap='round'; ctx.lineJoin='round';
        ctx.stroke();
        // Outer soft halo
        if (seg.depth>=4) {
          ctx.strokeStyle=`rgba(190,230,255,${glowAlpha*0.4})`;
          ctx.lineWidth=glowW*2.5; ctx.stroke();
        }
      }

      // Core crack line
      ctx.beginPath();
      ctx.moveTo(pts[0].x,pts[0].y);
      for (let i=1;i<nPts;i++) ctx.lineTo(pts[i].x,pts[i].y);
      // Color: deeper = more blue-white, shallower = faint blue
      const brightness = Math.round(120+df*120);
      const coreAlpha = Math.min(0.85, (0.06+df*0.7)*Math.min(1,p*2.5));
      ctx.strokeStyle=`rgba(${brightness},${Math.round(200+df*50)},255,${coreAlpha})`;
      ctx.lineWidth=seg.width; ctx.lineCap='round'; ctx.lineJoin='round';
      ctx.stroke();

      // Bright highlight on core (specular)
      if (seg.depth>=3) {
        ctx.beginPath();
        ctx.moveTo(pts[0].x,pts[0].y);
        for (let i=1;i<nPts;i++) ctx.lineTo(pts[i].x,pts[i].y);
        ctx.strokeStyle=`rgba(240,252,255,${coreAlpha*0.65})`;
        ctx.lineWidth=0.4; ctx.stroke();
      }

      // Frost crystallization at ends of deep cracks
      if (seg.depth>=4 && cp>0.85 && p>0.25) {
        const last = pts[nPts-1];
        const frostAlpha = Math.min(0.55, (p-0.25)*0.8);
        for (let k=0;k<4;k++) {
          const fa = Math.random()*Math.PI*2;
          const fr = 4+Math.random()*10;
          ctx.beginPath();
          ctx.moveTo(last.x,last.y);
          ctx.lineTo(last.x+Math.cos(fa)*fr, last.y+Math.sin(fa)*fr);
          ctx.strokeStyle=`rgba(200,238,255,${frostAlpha*(0.3+Math.random()*0.7)})`;
          ctx.lineWidth=0.5; ctx.stroke();
        }
      }
    });

    // ── 3. Corner refraction vignette ──
    if (p > 0.06) {
      const va = Math.min(0.28, (p-0.06)*0.36);
      [[0,0],[W,0],[0,H],[W,H]].forEach(([cx,cy]) => {
        const gr=ctx.createRadialGradient(cx,cy,0,cx,cy,Math.max(W,H)*0.55);
        gr.addColorStop(0,`rgba(185,224,255,${va*0.7})`);
        gr.addColorStop(0.45,`rgba(200,232,255,${va*0.2})`);
        gr.addColorStop(1,'rgba(210,236,255,0)');
        ctx.fillStyle=gr; ctx.fillRect(0,0,W,H);
      });
    }

    // ── 4. Frost breath overlay at high progress ──
    if (p > 0.6) {
      const fa = Math.min(0.08, (p-0.6)*0.2);
      const gf = ctx.createLinearGradient(0,0,W,H);
      gf.addColorStop(0,`rgba(220,242,255,${fa})`);
      gf.addColorStop(0.5,'rgba(210,238,255,0)');
      gf.addColorStop(1,`rgba(215,240,255,${fa*0.7})`);
      ctx.fillStyle=gf; ctx.fillRect(0,0,W,H);
    }
  }

  function smoothTo(target) {
    targetProg = Math.max(0, Math.min(0.97, target));
    cancelAnimationFrame(rafId);
    (function step() {
      prog += (targetProg - prog)*0.065;
      render(prog);
      if (Math.abs(prog-targetProg)>0.0012) rafId=requestAnimationFrame(step);
      else { prog=targetProg; render(prog); }
    })();
  }

  return { init() { build(); smoothTo(0.04); }, animateTo: smoothTo };
})();

/* ── Scroll → ice crack progress ── */
let iceActive=false, lastSY=0, crackTid;
window.addEventListener('scroll', function() {
  if (!iceActive) return;
  const sy   = window.scrollY;
  const maxS = Math.max(1, document.documentElement.scrollHeight-window.innerHeight);
  const frac = sy/maxS;
  const vel  = Math.abs(sy-lastSY);
  lastSY=sy;
  const base  = 0.04+frac*0.78;
  const burst = Math.min(0.22, vel*0.013);
  IceCrack.animateTo(Math.min(0.97, base+burst));
  clearTimeout(crackTid);
  crackTid=setTimeout(()=>IceCrack.animateTo(Math.max(0.04,base*0.55)),1100);
},{passive:true});

/* ── Gate Open ── */
function openGate() {
  if (openGate.done) return; openGate.done=true;
  document.getElementById('gateWrapper').classList.add('open');
  document.getElementById('openBtn').style.opacity='0';
  document.getElementById('snowCanvas').classList.add('visible');
  setTimeout(()=>{
    document.getElementById('intro-screen').classList.add('hidden');
    document.getElementById('main').classList.add('visible');
    IceCrack.init(); iceActive=true;
    checkReveal(); checkShards();
    setTimeout(autoFlipStrip, 800);
  }, 1700);
}
document.querySelectorAll('#gateWrapper .gate-panel,#openBtn').forEach(p=>p.addEventListener('click',openGate));

/* ── Shard dividers pop in on scroll ── */
function checkShards() {
  document.querySelectorAll('[data-crack-svg]').forEach(svg=>{
    const r=svg.getBoundingClientRect();
    if (r.top < window.innerHeight*0.9 && !svg.classList.contains('cracked')) svg.classList.add('cracked');
  });
}

/* ── Scroll reveal ── */
function checkReveal() {
  document.querySelectorAll('.reveal:not(.visible)').forEach(el=>{
    if (el.getBoundingClientRect().top<window.innerHeight*0.92) el.classList.add('visible');
  });
  document.querySelectorAll('[class*="anim-"]:not(.anim-in)').forEach(el=>{
    if (el.getBoundingClientRect().top<window.innerHeight*0.88) {
      el.parentElement.querySelectorAll('[class*="anim-"]:not(.anim-in)')
        .forEach((s,i)=>setTimeout(()=>s.classList.add('anim-in'),i*120));
    }
  });
  checkShards();
}
window.addEventListener('scroll', checkReveal);

/* ── Flip cards ── */
document.addEventListener('click', e=>{
  const c=e.target.closest('.flip-card');
  if (c) c.classList.toggle('flipped');
});

function autoFlipStrip() {
  const cards=document.querySelectorAll('#main .hero-photo-strip .flip-card');
  let i=0;
  const iv=setInterval(()=>{
    if(i>0)cards[i-1]?.classList.remove('flipped');
    if(i<cards.length){cards[i].classList.add('flipped');i++;}
    else{clearInterval(iv);setTimeout(()=>cards.forEach(c=>c.classList.remove('flipped')),1200);}
  },650);
}

const albumObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.querySelectorAll('.flip-card').forEach((c,i)=>{
        setTimeout(()=>{c.classList.add('flipped');setTimeout(()=>c.classList.remove('flipped'),900);},i*180);
      });
      albumObs.unobserve(e.target);
    }
  });
},{threshold:0.2});
const ag=document.querySelector('.album-grid');
if(ag) albumObs.observe(ag);

/* ── Nav ── */
function goTo(id){document.getElementById(id)?.scrollIntoView({behavior:'smooth'});}
window.addEventListener('scroll',()=>{
  const ids=['s-invite','s-couple','s-story','s-album','s-event','s-rsvp','s-wishes'];
  const links=document.querySelectorAll('.nav-link');
  const mid=window.scrollY+window.innerHeight*0.35;
  ids.forEach((id,i)=>{
    const el=document.getElementById(id);
    if(el)links[i]?.classList.toggle('active',mid>=el.offsetTop&&mid<el.offsetTop+el.offsetHeight);
  });
});

/* ── RSVP ── */
let attChoice='yes';
function setAtt(v){
  attChoice=v;
  document.getElementById('attY').classList.toggle('active',v==='yes');
  document.getElementById('attN').classList.toggle('active',v==='no');
}
function submitRsvp(){
  if(!document.getElementById('rsvpName').value.trim()){alert('Vui lòng nhập tên!');return;}
  document.getElementById('rsvpForm').style.display='none';
  document.getElementById('rsvpOk').style.display='block';
}

/* ── Wishes ── */
function addWish(){
  const name=document.getElementById('wishName').value.trim();
  const text=document.getElementById('wishText').value.trim();
  if(!name||!text){alert('Vui lòng nhập tên và lời chúc!');return;}
  const el=document.createElement('div');
  el.className='wish-item';
  el.innerHTML=`<div class="wish-name">${name}</div><div class="wish-text">${text}</div>`;
  document.getElementById('wishWall').prepend(el);
  document.getElementById('wishName').value='';
  document.getElementById('wishText').value='';
}
</script>
</body>
</html>