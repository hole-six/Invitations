        <h3 class="sec-title reveal" style="font-size:30px;">Lịch Trình</h3>
        <div class="silver-rule reveal"><svg width="16" height="16" color="var(--silver-light)"><use href="#sf-sm"/></svg></div>
        <div class="schedule-items reveal">
          <div class="sch-item"><div class="sch-time">09:00</div><div><div class="sch-info-name">Lễ Gia Tiên Nhà Gái</div><div class="sch-info-desc">Nghi thức truyền thống tại nhà cô dâu</div></div></div>
