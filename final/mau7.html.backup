<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Thiệp Cưới | Nhã An & Duy Khánh</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Cinzel:wght@400;500;600&family=Jost:wght@200;300;400;500&family=Pinyon+Script&display=swap" rel="stylesheet">

<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --snow-white: #ffffff;
  --ice-bg: #f2f6fb;
  --frost: #e4ecf5;
  --silver-light: #c2cdd9;
  --silver: #96a6b5;
  --silver-deep: #6e7f90;
  --ink: #2e3a48;
  --ink-light: #4a5a6a;
  --ice-blue: #d4e5f5;
  --crystal: #aac2d8;
  --accent: #8faec7;
}
html { scroll-behavior: smooth; }
body {
  background: var(--ice-bg);
  font-family: 'Jost', sans-serif;
  color: var(--ink);
  overflow-x: hidden;
}

/* ══ SNOW CANVAS ══ */
.snow-canvas {
  position: fixed; top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none; z-index: 998;
  opacity: 0; transition: opacity 2s ease;
}
.snow-canvas.visible { opacity: 1; }

/* ══ ICE CRACK CANVAS — realistic shattering ══ */
#iceCrackCanvas {
  position: fixed; top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none; z-index: 997;
}

/* ══ INTRO GATE ══ */
#intro-screen {
  position: fixed; inset: 0; z-index: 1000;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(150deg, #f5f9ff 0%, #eaf2fb 50%, #e0ecf7 100%);
  transition: opacity 1s ease, visibility 1s;
}
#intro-screen.hidden { opacity: 0; visibility: hidden; pointer-events: none; }

/* Floating snowflakes in intro */
.intro-bg-flakes { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
.ibf { position: absolute; animation: ibfDrift 14s ease-in-out infinite; }
.ibf:nth-child(1){top:4%;left:6%;animation-delay:0s;}
.ibf:nth-child(2){top:6%;right:8%;animation-delay:-4s;}
.ibf:nth-child(3){bottom:8%;left:4%;animation-delay:-8s;}
.ibf:nth-child(4){bottom:6%;right:6%;animation-delay:-11s;}
.ibf:nth-child(5){top:42%;left:1%;animation-delay:-3s;}
.ibf:nth-child(6){top:38%;right:2%;animation-delay:-7s;}
@keyframes ibfDrift {
  0%,100%{transform:translateY(0)rotate(0deg);}
  30%{transform:translateY(-14px)rotate(18deg);}
  70%{transform:translateY(9px)rotate(-12deg);}
}

.gate-wrapper {
  width: min(480px, 94vw);
  height: min(680px, 94vh);
  position: relative;
  display: flex; align-items: stretch;
  perspective: 1400px;
}
.gate-panel {
  flex: 1; position: relative; overflow: hidden;
  background: linear-gradient(160deg, #f7fbff 0%, #ecf4fb 100%);
  border: 1px solid var(--silver-light);
  box-shadow: 0 24px 70px rgba(80,110,145,0.18);
  transition: transform 1.6s cubic-bezier(0.4, 0, 0.2, 1);
}
.gate-panel.left  { transform-origin: left center; }
.gate-panel.right { transform-origin: right center; }
.gate-wrapper.open .gate-panel.left  { transform: perspective(1000px) rotateY(-118deg); }
.gate-wrapper.open .gate-panel.right { transform: perspective(1000px) rotateY(118deg); }

.gate-flake { position: absolute; opacity: 0.22; animation: ibfDrift 10s ease-in-out infinite; }

.intro-band {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10; text-align: center; pointer-events: none;
  width: 248px;
  background: rgba(255,255,255,0.97);
  border: 1px solid var(--silver-light);
  padding: 22px 26px;
  box-shadow: 0 10px 40px rgba(80,110,145,0.14);
}
.intro-band .tag {
  font-family: 'Cinzel', serif; font-size: 8px;
  letter-spacing: 4px; text-transform: uppercase;
  color: var(--silver-deep); margin-bottom: 10px;
  display: flex; align-items: center; justify-content: center; gap: 8px;
}
.intro-band .names {
  font-family: 'Pinyon Script', cursive;
  font-size: 34px; color: var(--ink); line-height: 1.2;
}
.intro-band .date {
  font-family: 'Cinzel', serif; font-size: 8px;
  letter-spacing: 3px; color: var(--silver); margin-top: 8px;
}

.open-btn {
  position: absolute; bottom: 11%; left: 50%;
  transform: translateX(-50%);
  width: 72px; height: 72px; border-radius: 50%;
  border: 1.5px solid rgba(160,185,215,0.8);
  background: linear-gradient(150deg, #ffffff 0%, #ddeaf7 100%);
  color: var(--silver-deep);
  font-family: 'Cinzel', serif; font-size: 7px;
  letter-spacing: 1.5px; text-transform: uppercase;
  cursor: pointer; z-index: 20;
  box-shadow: 0 6px 24px rgba(100,130,165,0.2), inset 0 1px 3px rgba(255,255,255,0.9);
  transition: all 0.3s;
  animation: gatePulse 2.8s ease-in-out infinite;
  display: flex; align-items: center; justify-content: center;
  flex-direction: column; gap: 3px;
}
@keyframes gatePulse {
  0%,100%{box-shadow:0 6px 24px rgba(100,130,165,0.2),inset 0 1px 3px rgba(255,255,255,0.9),0 0 0 0 rgba(160,200,240,0.5);}
  50%{box-shadow:0 6px 24px rgba(100,130,165,0.2),inset 0 1px 3px rgba(255,255,255,0.9),0 0 0 16px rgba(160,200,240,0);}
}
.open-btn:hover { transform: translateX(-50%) scale(1.1); }
.open-btn span { display: block; }

/* ══ MAIN ══ */
#main { opacity: 0; transition: opacity 1.2s ease; }
#main.visible { opacity: 1; }

/* HEADER */
.site-header {
  position: relative;
  background: linear-gradient(160deg, #ffffff 0%, #eef5fb 45%, #e5eff8 100%);
  min-height: 380px;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  border-bottom: 1px solid var(--frost);
}
.header-snow-bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
.hbg-fl { position: absolute; animation: ibfDrift 11s ease-in-out infinite; }
.hbg-fl:nth-child(1){top:-25px;left:-25px;animation-delay:0s;}
.hbg-fl:nth-child(2){top:-20px;right:-20px;animation-delay:-3s;transform:scaleX(-1);}
.hbg-fl:nth-child(3){bottom:-20px;left:10%;animation-delay:-6s;}
.hbg-fl:nth-child(4){bottom:-15px;right:15%;animation-delay:-9s;transform:scaleX(-1);}
.hbg-fl:nth-child(5){top:35%;left:5%;animation-delay:-2s;}
.hbg-fl:nth-child(6){top:30%;right:6%;animation-delay:-8s;}

.header-content { position: relative; z-index: 2; text-align: center; padding: 48px 20px; }
.header-tag {
  font-family: 'Cinzel', serif; font-size: 8px; letter-spacing: 6px;
  text-transform: uppercase; color: var(--silver); margin-bottom: 18px;
  display: flex; align-items: center; justify-content: center; gap: 12px;
}
.header-names {
  font-family: 'Pinyon Script', cursive;
  font-size: clamp(58px, 11vw, 92px);
  color: var(--ink); line-height: 1.1;
}
.header-amp {
  display: block;
  font-family: 'Cinzel', serif; font-size: 0.25em;
  font-weight: 400; color: var(--silver);
  letter-spacing: 8px; text-transform: uppercase; margin: 6px 0;
}
.header-date {
  font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 5px;
  color: var(--silver-deep); margin-top: 16px; text-transform: uppercase;
}

/* NAV */
.sticky-nav {
  position: sticky; top: 0; z-index: 100;
  background: rgba(255,255,255,0.96);
  backdrop-filter: blur(12px);
  display: flex; justify-content: center;
  border-bottom: 1px solid var(--frost);
  box-shadow: 0 1px 14px rgba(80,110,145,0.07);
}
.nav-link {
  padding: 15px 13px;
  font-family: 'Cinzel', serif; font-size: 7px;
  letter-spacing: 1.5px; text-transform: uppercase;
  color: var(--silver); cursor: pointer;
  transition: color 0.3s;
  border-bottom: 1.5px solid transparent;
  white-space: nowrap;
}
.nav-link:hover, .nav-link.active { color: var(--ink); border-bottom-color: var(--accent); }

/* REVEAL ANIMATIONS */
.reveal { opacity: 0; transform: translateY(22px); transition: opacity 0.9s ease, transform 0.9s ease; }
.reveal.visible { opacity: 1; transform: none; }
.anim-fade-up    { opacity: 0; transform: translateY(40px); transition: opacity 0.8s ease, transform 0.8s ease; }
.anim-fade-left  { opacity: 0; transform: translateX(-40px); transition: opacity 0.8s ease, transform 0.8s ease; }
.anim-fade-right { opacity: 0; transform: translateX(40px); transition: opacity 0.8s ease, transform 0.8s ease; }
.anim-zoom       { opacity: 0; transform: scale(0.88); transition: opacity 0.8s ease, transform 0.8s ease; }
.anim-in { opacity: 1 !important; transform: none !important; }

/* SECTION */
.section { padding: 80px 20px; max-width: 700px; margin: 0 auto; }
.sec-label {
  font-family: 'Cinzel', serif; font-size: 8px;
  letter-spacing: 5px; text-transform: uppercase;
  color: var(--silver); text-align: center; margin-bottom: 10px;
  display: flex; align-items: center; justify-content: center; gap: 12px;
}
.sec-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(30px, 5vw, 46px); font-weight: 400;
  font-style: italic; text-align: center; color: var(--ink); margin-bottom: 8px;
}
.silver-rule {
  display: flex; align-items: center; justify-content: center;
  gap: 14px; margin: 20px 0;
}
.silver-rule::before, .silver-rule::after {
  content: ''; flex: 1; max-width: 90px; height: 1px;
  background: linear-gradient(to right, transparent, var(--silver-light));
}
.silver-rule::after { background: linear-gradient(to left, transparent, var(--silver-light)); }

/* FORMAL CARD */
.formal-card {
  background: #ffffff; border: 1px solid var(--silver-light);
  max-width: 460px; margin: 36px auto; padding: 58px 50px;
  text-align: center; position: relative; overflow: visible;
  box-shadow: 0 22px 64px rgba(70,95,130,0.09), 0 2px 8px rgba(70,95,130,0.05);
}
.formal-card::before {
  content: ''; position: absolute; inset: 12px;
  border: 0.5px solid var(--silver-light); pointer-events: none; opacity: 0.5;
}
.corner-deco { position: absolute; opacity: 0.55; }
.corner-deco.tl { top: -18px; left: -18px; }
.corner-deco.tr { top: -18px; right: -18px; transform: scaleX(-1); }
.corner-deco.bl { bottom: -18px; left: -10px; transform: scaleY(-1); }
.corner-deco.br { bottom: -18px; right: -10px; transform: scale(-1,-1); }

.fc-families {
  font-family: 'Jost', sans-serif; font-size: 9px;
  letter-spacing: 2.5px; text-transform: uppercase;
  color: var(--silver); margin-bottom: 5px; line-height: 2.2;
}
.fc-together {
  font-family: 'Playfair Display', serif; font-size: 14px;
  font-style: italic; color: var(--silver-deep); margin-bottom: 18px;
}
.fc-name {
  font-family: 'Pinyon Script', cursive;
  font-size: clamp(50px, 9vw, 72px); color: var(--ink); line-height: 1;
}
.fc-and { font-family: 'Cinzel', serif; font-size: 8px; letter-spacing: 5px; color: var(--silver); margin: 14px 0; }
.fc-request { font-family: 'Jost', sans-serif; font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--silver); line-height: 2.6; margin: 18px 0; }
.fc-date-row { display: flex; align-items: stretch; justify-content: center; border: 1px solid var(--silver-light); margin: 22px auto; max-width: 300px; }
.fc-date-col { padding: 13px 18px; border-right: 1px solid var(--silver-light); }
.fc-date-col:last-child { border-right: none; }
.fc-date-num { font-family: 'Playfair Display', serif; font-size: 26px; color: var(--ink); line-height: 1; }
.fc-date-lbl { font-family: 'Cinzel', serif; font-size: 7px; letter-spacing: 2px; text-transform: uppercase; color: var(--silver); margin-top: 4px; }
.fc-venue { font-family: 'Cinzel', serif; font-size: 8px; letter-spacing: 2px; text-transform: uppercase; color: var(--ink-light); line-height: 2.5; margin-top: 18px; }
.fc-reception { font-family: 'Playfair Display', serif; font-size: 15px; font-style: italic; color: var(--silver-deep); margin-top: 14px; }

/* SECTION DIVIDER */
.section-divider {
  height: 60px;
  background: var(--frost);
  display: flex; align-items: center; justify-content: center;
  overflow: visible; position: relative; z-index: 5;
}
.shard-svg {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%) scaleX(0);
  transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  width: min(800px, 100vw);
}
.shard-svg.cracked { transform: translate(-50%, -50%) scaleX(1); }

/* COUPLE */
.couple-photo-row { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 40px; }
.couple-photo-card { height: 380px; position: relative; overflow: hidden; }
.flip-card { perspective: 1000px; cursor: pointer; }
.flip-card-inner { position: relative; width: 100%; height: 100%; transition: transform 0.75s cubic-bezier(0.4,0.2,0.2,1); transform-style: preserve-3d; }
.flip-card:hover .flip-card-inner, .flip-card.flipped .flip-card-inner { transform: rotateY(180deg); }
.flip-front, .flip-back { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; overflow: hidden; }
.flip-back {
  transform: rotateY(180deg);
  background: linear-gradient(150deg, #eef5fb 0%, #e1edf7 100%);
  display: flex; align-items: center; justify-content: center;
  flex-direction: column; padding: 24px; text-align: center;
  border: 1px solid var(--silver-light);
}
.flip-back-name { font-family: 'Pinyon Script', cursive; font-size: 44px; color: var(--ink); margin: 10px 0 4px; }
.flip-back-desc { font-family: 'Cinzel', serif; font-size: 8px; letter-spacing: 4px; text-transform: uppercase; color: var(--silver); }
.photo-frame { width: 100%; height: 100%; object-fit: cover; display: block; }
.flip-hint {
  position: absolute; bottom: 8px; right: 8px;
  background: rgba(255,255,255,0.88); color: var(--silver-deep);
  font-family: 'Cinzel', serif; font-size: 7px; letter-spacing: 2px;
  padding: 4px 8px; z-index: 5; pointer-events: none;
  border: 1px solid var(--silver-light);
  display: flex; align-items: center; gap: 5px;
}

/* TIMELINE */
.timeline { margin-top: 40px; position: relative; }
.timeline::before {
  content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 1px;
  background: linear-gradient(to bottom, transparent, var(--silver-light) 10%, var(--silver-light) 90%, transparent);
  transform: translateX(-50%);
}
.tl-item { display: grid; grid-template-columns: 1fr 28px 1fr; margin-bottom: 38px; align-items: start; }
.tl-dot { display: flex; align-items: flex-start; justify-content: center; padding-top: 6px; }
.tl-dot-inner { width: 10px; height: 10px; border: 1.5px solid var(--silver); background: white; transform: rotate(45deg); }
.tl-content { padding: 0 22px; }
.tl-item:nth-child(odd) .tl-content { text-align: right; }
.tl-item:nth-child(even) .tl-content { grid-column: 3; text-align: left; }
.tl-item:nth-child(even) .tl-empty { grid-column: 1; }
.tl-date { font-family: 'Cinzel', serif; font-size: 7px; letter-spacing: 3px; color: var(--silver); margin-bottom: 4px; text-transform: uppercase; }
.tl-title { font-family: 'Playfair Display', serif; font-size: 20px; font-style: italic; color: var(--ink); }
.tl-desc { font-size: 12px; color: var(--silver-deep); line-height: 1.9; margin-top: 5px; font-weight: 300; }

/* ALBUM */
.album-section { background: white; padding: 80px 20px; }
.album-inner { max-width: 800px; margin: 0 auto; }
.album-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 40px; }
.album-cell { position: relative; overflow: hidden; }
.album-cell:nth-child(1) { grid-row: span 2; height: 420px; }
.album-cell-h1 { height: 200px; }

/* DARK EVENT SECTION */
.dark-section {
  background: linear-gradient(150deg, #eef4fa 0%, #e3eef6 50%, #d8e9f4 100%);
  color: var(--ink); padding: 80px 20px;
  position: relative; overflow: hidden;
}
.dark-section::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle at 15% 20%, rgba(160,190,220,0.28) 0%, transparent 42%),
              radial-gradient(circle at 85% 80%, rgba(140,175,210,0.18) 0%, transparent 42%);
}
.dark-section .inner { max-width: 700px; margin: 0 auto; position: relative; }
.dark-fl { position: absolute; pointer-events: none; animation: ibfDrift 14s ease-in-out infinite; }
.dark-fl:nth-child(1){top:4%;right:2%;animation-delay:-1s;}
.dark-fl:nth-child(2){bottom:4%;left:2%;animation-delay:-6s;}

.event-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-top: 36px; }
.event-card {
  background: white; border: 1px solid var(--silver-light);
  padding: 28px 22px; position: relative;
  box-shadow: 0 4px 20px rgba(70,100,135,0.06);
}
.event-card::after {
  content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 2px;
  background: linear-gradient(to right, transparent, var(--crystal), transparent);
}
.ec-type { font-family: 'Cinzel', serif; font-size: 7px; letter-spacing: 4px; text-transform: uppercase; color: var(--silver); margin-bottom: 8px; }
.ec-name { font-family: 'Playfair Display', serif; font-size: 20px; font-style: italic; color: var(--ink); margin-bottom: 10px; }
.ec-detail { font-family: 'Jost', sans-serif; font-size: 11px; color: var(--silver-deep); line-height: 2.3; font-weight: 300; }
.ec-detail strong { color: var(--ink-light); font-weight: 400; }

.schedule-items { margin-top: 36px; }
.sch-item { display: flex; align-items: flex-start; gap: 20px; padding: 16px 0; border-bottom: 1px solid rgba(200,215,230,0.5); }
.sch-item:last-child { border-bottom: none; }
.sch-time { font-family: 'Playfair Display', serif; font-size: 22px; font-style: italic; color: var(--silver); min-width: 76px; }
.sch-info-name { font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 1.5px; color: var(--ink); margin-bottom: 3px; text-transform: uppercase; }
.sch-info-desc { font-family: 'Jost', sans-serif; font-size: 11px; color: var(--silver-deep); font-weight: 300; }

/* RSVP */
.rsvp-section { background: white; }
.rsvp-form { margin-top: 36px; display: flex; flex-direction: column; gap: 22px; }
.f-row { display: flex; flex-direction: column; gap: 6px; }
.f-label { font-family: 'Cinzel', serif; font-size: 7px; letter-spacing: 4px; text-transform: uppercase; color: var(--silver); }
.f-input { background: transparent; border: none; border-bottom: 1px solid var(--silver-light); padding: 10px 0; font-family: 'Playfair Display', serif; font-size: 17px; font-style: italic; color: var(--ink); outline: none; transition: border-color 0.3s; }
.f-input:focus { border-color: var(--silver-deep); }
.attend-row { display: flex; gap: 12px; margin-top: 4px; }
.att-btn { flex: 1; padding: 13px; border: 1px solid var(--silver-light); background: transparent; font-family: 'Cinzel', serif; font-size: 7px; letter-spacing: 3px; text-transform: uppercase; color: var(--silver); cursor: pointer; transition: all 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px; }
.att-btn.active, .att-btn:hover { border-color: var(--silver-deep); color: var(--ink); background: var(--frost); }
.submit-btn { background: var(--ink); color: white; border: none; padding: 17px; font-family: 'Cinzel', serif; font-size: 8px; letter-spacing: 5px; text-transform: uppercase; cursor: pointer; transition: opacity 0.3s; margin-top: 8px; display: flex; align-items: center; justify-content: center; gap: 10px; }
.submit-btn:hover { opacity: 0.8; }
.rsvp-success { display: none; font-family: 'Pinyon Script', cursive; font-size: 36px; color: var(--ink); text-align: center; padding: 40px; }

/* WISHES */
.wish-wall { margin-top: 32px; max-height: 320px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; }
.wish-item { border-left: 2px solid var(--silver-light); padding: 12px 16px; background: rgba(255,255,255,0.6); }
.wish-name { font-family: 'Playfair Display', serif; font-size: 19px; font-style: italic; color: var(--ink); margin-bottom: 4px; }
.wish-text { font-family: 'Jost', sans-serif; font-size: 11px; color: var(--silver-deep); line-height: 1.9; font-weight: 300; }
.wish-inputs { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; }
.w-input { background: white; border: 1px solid var(--silver-light); padding: 12px 16px; font-family: 'Playfair Display', serif; font-size: 16px; font-style: italic; color: var(--ink); outline: none; transition: border-color 0.3s; }
.w-input:focus { border-color: var(--silver-deep); }
.w-btn { background: transparent; border: 1px solid var(--ink); color: var(--ink); padding: 14px; font-family: 'Cinzel', serif; font-size: 8px; letter-spacing: 4px; text-transform: uppercase; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; justify-content: center; gap: 10px; }
.w-btn:hover { background: var(--ink); color: white; }

/* CONTACT */
.contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-top: 36px; }
.contact-block { border: 1px solid var(--silver-light); padding: 22px 18px; text-align: center; background: white; }
.cb-role { font-family: 'Cinzel', serif; font-size: 7px; letter-spacing: 4px; color: var(--silver); margin-bottom: 8px; text-transform: uppercase; }
.cb-name { font-family: 'Playfair Display', serif; font-size: 16px; font-style: italic; color: var(--ink); margin-bottom: 6px; }
.cb-phone { font-family: 'Jost', sans-serif; font-size: 11px; color: var(--silver); text-decoration: none; display: block; font-weight: 300; transition: color 0.3s; }
.cb-phone:hover { color: var(--ink); }

/* HERO STRIP */
.hero-photo-strip { display: flex; gap: 14px; align-items: flex-end; justify-content: center; padding: 28px 20px; background: white; border-bottom: 1px solid var(--frost); overflow: hidden; }
.strip-photo { width: 120px; height: 170px; flex-shrink: 0; position: relative; box-shadow: 0 6px 24px rgba(70,100,135,0.12); overflow: hidden; animation: stripEnt 0.8s ease both; border: 1px solid var(--frost); }
.strip-photo:nth-child(2), .strip-photo:nth-child(5) { width: 150px; height: 210px; }
.strip-photo:nth-child(1){transform:rotate(-3deg);animation-delay:0.1s;}
.strip-photo:nth-child(2){animation-delay:0.2s;}
.strip-photo:nth-child(3){transform:rotate(2.5deg);animation-delay:0.3s;}
.strip-photo:nth-child(4){transform:rotate(-1.5deg);animation-delay:0.15s;}
.strip-photo:nth-child(5){transform:rotate(1.5deg);animation-delay:0.25s;}
@keyframes stripEnt { from{opacity:0;transform:translateY(40px)scale(0.92);}to{opacity:1;} }

/* STORY LAYOUT */
.story-with-photos { display: grid; grid-template-columns: 1fr 190px; gap: 32px; align-items: start; }
.story-photos-col { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 100px; }
.story-photo-item { height: 155px; position: relative; overflow: hidden; box-shadow: 0 4px 16px rgba(70,100,135,0.12); animation: floatPh 5s ease-in-out infinite; }
.story-photo-item:nth-child(2) { animation-delay: -2.5s; }
@keyframes floatPh { 0%,100%{transform:translateY(0);}50%{transform:translateY(-6px);} }

/* CLOSING */
.closing-section { background: linear-gradient(150deg, #ffffff 0%, #eef4fb 40%, #e5eff8 100%); padding: 100px 20px 80px; text-align: center; position: relative; overflow: hidden; }
.closing-snow-bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
.csbg { position: absolute; animation: ibfDrift 12s ease-in-out infinite; }
.csbg:nth-child(1){top:-20px;left:-20px;animation-delay:0s;}
.csbg:nth-child(2){top:-20px;right:-20px;animation-delay:-4s;transform:scaleX(-1);}
.csbg:nth-child(3){bottom:-20px;left:20%;animation-delay:-7s;transform:scaleY(-1);}
.csbg:nth-child(4){bottom:-20px;right:18%;animation-delay:-10s;transform:scale(-1,-1);}
.closing-inner { position: relative; z-index: 1; }
.closing-names { font-family: 'Pinyon Script', cursive; font-size: clamp(52px, 10vw, 84px); color: var(--ink); }
.closing-date { font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 5px; color: var(--silver); margin-top: 14px; text-transform: uppercase; }
.closing-msg { font-family: 'Playfair Display', serif; font-size: 16px; font-style: italic; color: var(--silver-deep); margin-top: 24px; line-height: 2.2; }
.wax-seal {
  width: 76px; height: 76px;
  background: linear-gradient(150deg, var(--crystal), var(--silver));
  border-radius: 50%; margin: 32px auto 0;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6px 22px rgba(90,120,155,0.22); position: relative;
}
.wax-seal::before { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 1px solid var(--silver-light); }

@media (max-width: 600px) {
  .couple-photo-row, .story-with-photos { grid-template-columns: 1fr; }
  .story-photos-col { flex-direction: row; position: static; }
  .story-photo-item { flex: 1; height: 120px; }
  .timeline::before { left: 16px; }
  .tl-item { grid-template-columns: 28px 1fr; }
  .tl-item .tl-content { grid-column: 2 !important; text-align: left !important; padding-left: 14px; }
  .tl-item .tl-empty { display: none; }
  .nav-link { padding: 12px 7px; font-size: 6px; }
  .formal-card { padding: 36px 22px; }
}
</style>
</head>
<body>

<canvas class="snow-canvas" id="snowCanvas"></canvas>
<canvas id="iceCrackCanvas"></canvas>

<!-- ══════════ SVG SYMBOL DEFS ══════════ -->
<svg width="0" height="0" style="position:absolute;">
  <defs>
    <!-- Snowflake 6-arm -->
    <symbol id="sf-6" viewBox="0 0 100 100">
      <g stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round">
        <line x1="50" y1="4" x2="50" y2="96"/>
        <line x1="4" y1="50" x2="96" y2="50"/>
        <line x1="13.3" y1="13.3" x2="86.7" y2="86.7"/>
        <line x1="86.7" y1="13.3" x2="13.3" y2="86.7"/>
        <!-- arm barbs -->
        <line x1="50" y1="22" x2="41" y2="13"/><line x1="50" y1="22" x2="59" y2="13"/>
        <line x1="50" y1="36" x2="39" y2="25"/><line x1="50" y1="36" x2="61" y2="25"/>
        <line x1="78" y1="50" x2="87" y2="41"/><line x1="78" y1="50" x2="87" y2="59"/>
        <line x1="64" y1="50" x2="75" y2="39"/><line x1="64" y1="50" x2="75" y2="61"/>
        <line x1="27.7" y1="27.7" x2="19" y2="19"/><line x1="27.7" y1="27.7" x2="19" y2="36.3"/>
        <line x1="38.4" y1="38.4" x2="27" y2="27"/><line x1="38.4" y1="38.4" x2="27" y2="49.7"/>
        <line x1="72.3" y1="27.7" x2="81" y2="19"/><line x1="72.3" y1="27.7" x2="81" y2="36.3"/>
        <line x1="61.6" y1="38.4" x2="73" y2="27"/><line x1="61.6" y1="38.4" x2="73" y2="49.7"/>
        <circle cx="50" cy="50" r="5"/>
      </g>
    </symbol>
    <!-- Snowflake small -->
    <symbol id="sf-sm" viewBox="0 0 100 100">
      <g stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round">
        <line x1="50" y1="8" x2="50" y2="92"/>
        <line x1="8" y1="50" x2="92" y2="50"/>
        <line x1="16" y1="16" x2="84" y2="84"/>
        <line x1="84" y1="16" x2="16" y2="84"/>
        <line x1="50" y1="24" x2="42" y2="16"/><line x1="50" y1="24" x2="58" y2="16"/>
        <line x1="76" y1="50" x2="84" y2="42"/><line x1="76" y1="50" x2="84" y2="58"/>
        <line x1="29.3" y1="29.3" x2="21" y2="21"/><line x1="29.3" y1="29.3" x2="21" y2="37.5"/>
        <line x1="70.7" y1="29.3" x2="79" y2="21"/><line x1="70.7" y1="29.3" x2="79" y2="37.5"/>
        <circle cx="50" cy="50" r="4.5"/>
      </g>
    </symbol>
    <!-- Ring SVG -->
    <symbol id="ico-ring" viewBox="0 0 100 100">
      <g stroke="currentColor" stroke-width="3" fill="none">
        <ellipse cx="32" cy="50" rx="22" ry="16" transform="rotate(-20,32,50)"/>
        <ellipse cx="68" cy="50" rx="22" ry="16" transform="rotate(20,68,50)"/>
        <path d="M42 38 Q50 28 58 38" stroke-width="2"/>
        <circle cx="50" cy="30" r="4" fill="currentColor" opacity="0.6"/>
      </g>
    </symbol>
    <!-- Heart SVG -->
    <symbol id="ico-heart" viewBox="0 0 100 100">
      <path d="M50 80 C10 55 10 20 35 15 C42 13 48 18 50 22 C52 18 58 13 65 15 C90 20 90 55 50 80Z" stroke="currentColor" stroke-width="2.5" fill="none"/>
    </symbol>
    <!-- Calendar/date icon -->
    <symbol id="ico-calendar" viewBox="0 0 100 100">
      <rect x="10" y="20" width="80" height="70" rx="4" stroke="currentColor" stroke-width="2.5" fill="none"/>
      <line x1="10" y1="38" x2="90" y2="38" stroke="currentColor" stroke-width="2.5"/>
      <line x1="30" y1="10" x2="30" y2="28" stroke="currentColor" stroke-width="3"/>
      <line x1="70" y1="10" x2="70" y2="28" stroke="currentColor" stroke-width="3"/>
      <circle cx="35" cy="55" r="3" fill="currentColor"/>
      <circle cx="50" cy="55" r="3" fill="currentColor"/>
      <circle cx="65" cy="55" r="3" fill="currentColor"/>
      <circle cx="35" cy="70" r="3" fill="currentColor"/>
      <circle cx="50" cy="70" r="3" fill="currentColor"/>
    </symbol>
    <!-- Location pin -->
    <symbol id="ico-pin" viewBox="0 0 100 100">
      <path d="M50 10 C30 10 15 25 15 44 C15 65 50 95 50 95 C50 95 85 65 85 44 C85 25 70 10 50 10Z" stroke="currentColor" stroke-width="2.5" fill="none"/>
      <circle cx="50" cy="44" r="12" stroke="currentColor" stroke-width="2.5" fill="none"/>
    </symbol>
    <!-- Clock -->
    <symbol id="ico-clock" viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="38" stroke="currentColor" stroke-width="2.5" fill="none"/>
      <line x1="50" y1="50" x2="50" y2="22" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      <line x1="50" y1="50" x2="68" y2="62" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      <circle cx="50" cy="50" r="3" fill="currentColor"/>
    </symbol>
    <!-- Check mark -->
    <symbol id="ico-check" viewBox="0 0 100 100">
      <polyline points="20,50 42,72 80,28" stroke="currentColor" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>
    <!-- X mark -->
    <symbol id="ico-x" viewBox="0 0 100 100">
      <line x1="25" y1="25" x2="75" y2="75" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
      <line x1="75" y1="25" x2="25" y2="75" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
    </symbol>
    <!-- Send arrow -->
    <symbol id="ico-send" viewBox="0 0 100 100">
      <path d="M10 50 L90 50 M60 25 L90 50 L60 75" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>
    <!-- Star/sparkle -->
    <symbol id="ico-star" viewBox="0 0 100 100">
      <path d="M50 10 L54 44 L88 40 L62 62 L74 94 L50 74 L26 94 L38 62 L12 40 L46 44 Z" stroke="currentColor" stroke-width="2" fill="none"/>
    </symbol>
    <!-- Forever/infinity -->
    <symbol id="ico-infinity" viewBox="0 0 100 100">
      <path d="M20 50 C20 35 30 25 42 25 C54 25 62 40 50 50 C38 60 46 75 58 75 C70 75 80 65 80 50 C80 35 70 25 58 25 C46 25 38 40 50 50 C62 60 54 75 42 75 C30 75 20 65 20 50Z" stroke="currentColor" stroke-width="3" fill="none"/>
    </symbol>
    <!-- Coffee cup -->
    <symbol id="ico-coffee" viewBox="0 0 100 100">
      <path d="M20 35 L20 72 C20 80 28 86 38 86 L62 86 C72 86 80 80 80 72 L80 35Z" stroke="currentColor" stroke-width="2.5" fill="none"/>
      <path d="M80 42 C90 42 90 58 80 58" stroke="currentColor" stroke-width="2.5" fill="none"/>
      <path d="M35 20 C35 20 33 26 37 28 C41 30 39 36 39 36" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
      <path d="M50 18 C50 18 48 26 52 29 C56 32 54 38 54 38" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
    </symbol>
    <!-- Mountain/travel -->
    <symbol id="ico-mountain" viewBox="0 0 100 100">
      <polyline points="10,88 40,35 55,58 68,42 90,88" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linejoin="round"/>
      <path d="M62 28 L68 42 L74 28Z" stroke="currentColor" stroke-width="1.5" fill="none"/>
    </symbol>
    <!-- Flower/close icon small -->
    <symbol id="ico-flower" viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="8" stroke="currentColor" stroke-width="2" fill="none"/>
      <ellipse cx="50" cy="30" rx="7" ry="12" stroke="currentColor" stroke-width="2" fill="none"/>
      <ellipse cx="50" cy="70" rx="7" ry="12" stroke="currentColor" stroke-width="2" fill="none"/>
      <ellipse cx="30" cy="50" rx="12" ry="7" stroke="currentColor" stroke-width="2" fill="none"/>
      <ellipse cx="70" cy="50" rx="12" ry="7" stroke="currentColor" stroke-width="2" fill="none"/>
      <ellipse cx="34.6" cy="34.6" rx="7" ry="12" stroke="currentColor" stroke-width="1.5" fill="none" transform="rotate(-45,34.6,34.6)"/>
      <ellipse cx="65.4" cy="65.4" rx="7" ry="12" stroke="currentColor" stroke-width="1.5" fill="none" transform="rotate(-45,65.4,65.4)"/>
      <ellipse cx="65.4" cy="34.6" rx="7" ry="12" stroke="currentColor" stroke-width="1.5" fill="none" transform="rotate(45,65.4,34.6)"/>
      <ellipse cx="34.6" cy="65.4" rx="7" ry="12" stroke="currentColor" stroke-width="1.5" fill="none" transform="rotate(45,34.6,65.4)"/>
    </symbol>
  </defs>
</svg>

<!-- ══════════ INTRO SCREEN ══════════ -->
<div id="intro-screen">
  <div class="intro-bg-flakes">
    <svg class="ibf" width="130" height="130" color="#8aa0b5"><use href="#sf-6"/></svg>
    <svg class="ibf" width="105" height="105" color="#8aa0b5"><use href="#sf-6"/></svg>
    <svg class="ibf" width="118" height="118" color="#8aa0b5"><use href="#sf-sm"/></svg>
    <svg class="ibf" width="100" height="100" color="#8aa0b5"><use href="#sf-sm"/></svg>
    <svg class="ibf" width="68" height="68" color="#8aa0b5"><use href="#sf-sm"/></svg>
    <svg class="ibf" width="65" height="65" color="#8aa0b5"><use href="#sf-sm"/></svg>
  </div>

  <div style="position:relative;display:flex;flex-direction:column;align-items:center;">
    <div class="gate-wrapper" id="gateWrapper">
      <div class="gate-panel left">
        <svg class="gate-flake" style="width:90px;top:8%;left:10%;" color="rgba(90,115,145,0.9)"><use href="#sf-6"/></svg>
        <svg class="gate-flake" style="width:58px;top:37%;left:28%;animation-delay:-4s;" color="rgba(90,115,145,0.6)"><use href="#sf-sm"/></svg>
        <svg class="gate-flake" style="width:105px;bottom:12%;left:5%;animation-delay:-7s;" color="rgba(90,115,145,0.8)"><use href="#sf-6"/></svg>
        <div style="position:absolute;top:0;right:0;bottom:0;width:1px;background:linear-gradient(to bottom,transparent,rgba(170,190,215,0.4) 20%,rgba(170,190,215,0.4) 80%,transparent);"></div>
      </div>
      <div class="gate-panel right">
        <svg class="gate-flake" style="width:88px;top:8%;right:10%;" color="rgba(90,115,145,0.9)"><use href="#sf-6"/></svg>
        <svg class="gate-flake" style="width:55px;top:37%;right:28%;animation-delay:-5s;" color="rgba(90,115,145,0.6)"><use href="#sf-sm"/></svg>
        <svg class="gate-flake" style="width:100px;bottom:12%;right:5%;animation-delay:-8s;" color="rgba(90,115,145,0.8)"><use href="#sf-6"/></svg>
        <div style="position:absolute;top:0;left:0;bottom:0;width:1px;background:linear-gradient(to bottom,transparent,rgba(170,190,215,0.4) 20%,rgba(170,190,215,0.4) 80%,transparent);"></div>
      </div>
      <div class="intro-band">
        <div class="tag">
          <svg width="14" height="14" color="var(--silver-deep)"><use href="#sf-sm"/></svg>
          Save The Date
          <svg width="14" height="14" color="var(--silver-deep)"><use href="#sf-sm"/></svg>
        </div>
        <div class="names">Nhã An &amp; Duy Khánh</div>
        <div class="date">28 · 02 · 2021</div>
      </div>
      <button class="open-btn" id="openBtn" onclick="openGate()">
        <svg width="24" height="24" color="var(--silver-deep)" style="margin:0 auto 2px;"><use href="#sf-sm"/></svg>
        <span style="font-size:6.5px;letter-spacing:1px;">Mở</span>
      </button>
    </div>
  </div>
</div>

<!-- ══════════ MAIN ══════════ -->
<div id="main">

  <header class="site-header">
    <div class="header-snow-bg">
      <svg class="hbg-fl" style="width:260px;top:-30px;left:-30px;opacity:0.12;" color="#8090aa"><use href="#sf-6"/></svg>
      <svg class="hbg-fl" style="width:210px;top:-20px;right:-20px;opacity:0.10;transform:scaleX(-1);" color="#8090aa"><use href="#sf-6"/></svg>
      <svg class="hbg-fl" style="width:180px;bottom:-20px;left:10%;opacity:0.08;" color="#8090aa"><use href="#sf-sm"/></svg>
      <svg class="hbg-fl" style="width:195px;bottom:-15px;right:16%;opacity:0.09;" color="#8090aa"><use href="#sf-6"/></svg>
      <svg class="hbg-fl" style="width:92px;top:35%;left:5%;opacity:0.07;" color="#8090aa"><use href="#sf-sm"/></svg>
      <svg class="hbg-fl" style="width:100px;top:30%;right:6%;opacity:0.07;" color="#8090aa"><use href="#sf-sm"/></svg>
    </div>
    <div class="header-content">
      <div class="header-tag reveal">
        <svg width="16" height="16" color="var(--silver)"><use href="#sf-sm"/></svg>
        Save The Date
        <svg width="16" height="16" color="var(--silver)"><use href="#sf-sm"/></svg>
      </div>
      <div class="header-names reveal">
        Nhã An<span class="header-amp">and</span>Duy Khánh
      </div>
      <div class="header-date reveal">28 · 02 · 2021 — Capella Gallery Hall</div>
    </div>
  </header>

  <div class="hero-photo-strip">
    <div class="strip-photo flip-card"><div class="flip-card-inner"><div class="flip-front"><img class="photo-frame" src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img6-5.jpg" alt="Nhã An" loading="lazy"><div class="flip-hint"><svg width="10" height="10" color="var(--silver-deep)"><use href="#sf-sm"/></svg></div></div><div class="flip-back"><svg width="36" height="36" color="var(--silver)"><use href="#sf-6"/></svg><div class="flip-back-name">Nhã An</div><div class="flip-back-desc">Cô Dâu</div></div></div></div>
    <div class="strip-photo flip-card"><div class="flip-card-inner"><div class="flip-front"><img class="photo-frame" src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img2-4.jpg" alt="Ảnh đôi" loading="lazy"><div class="flip-hint"><svg width="10" height="10" color="var(--silver-deep)"><use href="#ico-heart"/></svg></div></div><div class="flip-back"><svg width="38" height="38" color="var(--silver)"><use href="#ico-ring"/></svg><div class="flip-back-name">Đôi Uyên Ương</div><div class="flip-back-desc">28 · 02 · 2021</div></div></div></div>
    <div class="strip-photo flip-card"><div class="flip-card-inner"><div class="flip-front"><img class="photo-frame" src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img6-5.jpg" alt="Ảnh cưới" loading="lazy"><div class="flip-hint"><svg width="10" height="10" color="var(--silver-deep)"><use href="#sf-sm"/></svg></div></div><div class="flip-back"><svg width="38" height="38" color="var(--silver)"><use href="#ico-infinity"/></svg><div class="flip-back-name">Mãi Mãi</div><div class="flip-back-desc">Forever &amp; Always</div></div></div></div>
    <div class="strip-photo flip-card"><div class="flip-card-inner"><div class="flip-front"><img class="photo-frame" src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img2-4.jpg" alt="Ảnh đôi 2" loading="lazy"><div class="flip-hint"><svg width="10" height="10" color="var(--silver-deep)"><use href="#sf-sm"/></svg></div></div><div class="flip-back"><svg width="38" height="38" color="var(--silver)"><use href="#ico-star"/></svg><div class="flip-back-name">Duy Khánh</div><div class="flip-back-desc">Chú Rể</div></div></div></div>
    <div class="strip-photo flip-card"><div class="flip-card-inner"><div class="flip-front"><img class="photo-frame" src="https://www.thiepmoidientu.com/wp-content/uploads/2024/03/img6-5.jpg" alt="Ảnh cưới 2" loading="lazy"><div class="flip-hint"><svg width="10" height="10" color="var(--silver-deep)"><use href="#ico-heart"/></svg></div></div><div class="flip-back"><svg width="38" height="38" color="var(--silver)"><use href="#sf-6"/></svg><div class="flip-back-name">Kỷ Niệm</div><div class="flip-back-desc">Chuyện Tình Yêu</div></div></div></div>
  </div>
  <p style="text-align:center;font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;color:var(--silver);padding:10px 0 0;background:white;text-transform:uppercase;">Nhấn vào ảnh để lật</p>

  <nav class="sticky-nav">
    <div class="nav-link active" onclick="goTo('s-invite')">Thiệp Mời</div>
    <div class="nav-link" onclick="goTo('s-couple')">Đôi Uyên Ương</div>
    <div class="nav-link" onclick="goTo('s-story')">Chuyện Tình</div>
    <div class="nav-link" onclick="goTo('s-album')">Album</div>
    <div class="nav-link" onclick="goTo('s-event')">Sự Kiện</div>
    <div class="nav-link" onclick="goTo('s-rsvp')">RSVP</div>
    <div class="nav-link" onclick="goTo('s-wishes')">Lời Chúc</div>
  </nav>

  <!-- S1: THIỆP MỜI -->
  <div id="s-invite" style="background:linear-gradient(160deg,#f8fbff 0%,#f0f6fb 100%);padding:60px 20px;">
    <div class="section" style="padding:0;">
      <div class="sec-label reveal">
        <svg width="14" height="14" color="var(--silver)"><use href="#sf-sm"/></svg>
        Kính Mời
        <svg width="14" height="14" color="var(--silver)"><use href="#sf-sm"/></svg>
      </div>
      <h2 class="sec-title reveal">Thiệp Mời Chính Thức</h2>
      <div class="silver-rule reveal"><svg width="16" height="16" color="var(--silver-light)"><use href="#sf-sm"/></svg></div>
      <div class="formal-card reveal">
        <!-- Corner snowflakes -->
        <svg class="corner-deco tl" width="100" height="100" color="rgba(140,170,200,0.6)"><use href="#sf-6"/></svg>
        <svg class="corner-deco tr" width="80" height="80" color="rgba(140,170,200,0.55)"><use href="#sf-6"/></svg>
