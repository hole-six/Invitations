      <div class="passport-field"><span class="field-label">Họ và Tên</span><div class="field-value">Trần Thư Hương</div></div>
      <div class="passport-field"><span class="field-label">Ngày Sinh</span><div class="field-value">08 · 03 · 1997</div></div>
      <div class="passport-field"><span class="field-label">Quê Quán</span><div class="field-value">TP. Hồ Chí Minh</div></div>
      <div class="passport-field"><span class="field-label">Nghề Nghiệp</span><div class="field-value">Nhà Thiết Kế Nội Thất</div></div>
      <div class="mrz">P&lt;VNM&lt;TRAN&lt;&lt;THU&lt;HUONG&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;<br>WED2023&lt;&lt;9703083F2312253VNM&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</div>
