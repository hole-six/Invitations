</section>

<!-- ══════════════════════════════════
     RSVP
══════════════════════════════════ -->
<section class="page-section" id="rsvp">
  <div class="rsvp-card reveal">
    <div class="rsvp-inner">
      <div class="rsvp-tag">✈ &nbsp; Xác Nhận Chuyến Bay &nbsp; ✈</div>
      <h2 class="rsvp-title">Xác Nhận Tham Dự</h2>
      <p class="rsvp-sub">"Chuyến bay hạnh phúc sẽ đủ đầy hơn với sự hiện diện của bạn. Vui lòng đặt chỗ trước ngày 01.12.2023"</p>
      <div class="rsvp-attend">
        <div class="attend-btn active" onclick="selectAttend(this)"><span class="attend-icon">🎉</span><div class="attend-label">Tôi Sẽ Bay</div></div>
        <div class="attend-btn" onclick="selectAttend(this)"><span class="attend-icon">💌</span><div class="attend-label">Rất Tiếc Vắng Mặt</div></div>
      </div>
      <div class="form-row">
        <div class="form-field"><label class="form-label">Họ Tên</label><input class="form-input" type="text" placeholder="Nguyễn Văn A"></div>
        <div class="form-field"><label class="form-label">Điện Thoại</label><input class="form-input" type="tel" placeholder="0912 345 678"></div>
      </div>
      <div class="form-row">
        <div class="form-field"><label class="form-label">Số Người Đi Kèm</label><input class="form-input" type="text" placeholder="1 – chỉ mình tôi"></div>
        <div class="form-field"><label class="form-label">Chế Độ Ăn</label><input class="form-input" type="text" placeholder="Chay, dị ứng..."></div>
      </div>
      <div class="form-field">
        <label class="form-label">Lời Chúc ✈</label>
        <textarea class="form-input" rows="3" placeholder="Gửi lời chúc đến cô dâu & chú rể..." style="resize:vertical"></textarea>
      </div>
      <button class="btn-submit" onclick="handleRsvp(this)"><span>Xác Nhận Chuyến Bay ✈</span></button>
      <div style="font-size:11px;color:var(--muted);margin-top:14px;font-family:'Cormorant Garamond',serif;font-style:italic">Chúng tôi sẽ liên hệ xác nhận qua điện thoại</div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════
     THANK YOU
══════════════════════════════════ -->
<section class="page-section" id="thankyou">
  <svg style="position:absolute;top:30px;left:30px;width:80px;opacity:.18;animation:float 7s ease-in-out infinite;z-index:0" viewBox="0 0 100 100" fill="none">
    <circle cx="50" cy="50" r="18" fill="#f5c4b8"/>
    <ellipse cx="50" cy="32" rx="14" ry="20" fill="#f8d0c4" opacity=".7" transform="rotate(0 50 50)"/>
    <ellipse cx="50" cy="32" rx="14" ry="20" fill="#f5c4b8" opacity=".6" transform="rotate(60 50 50)"/>
    <ellipse cx="50" cy="32" rx="14" ry="20" fill="#f8d0c4" opacity=".6" transform="rotate(120 50 50)"/>
    <ellipse cx="50" cy="32" rx="14" ry="20" fill="#f5c4b8" opacity=".55" transform="rotate(180 50 50)"/>
    <ellipse cx="50" cy="32" rx="14" ry="20" fill="#f8d0c4" opacity=".55" transform="rotate(240 50 50)"/>
    <ellipse cx="50" cy="32" rx="14" ry="20" fill="#f5c4b8" opacity=".5" transform="rotate(300 50 50)"/>
  </svg>
  <div class="ty-passport reveal">
    <div class="ty-inner">
      <div class="ty-label">Passport Wedding · Trang Cuối</div>
      <div class="ty-title">Thank You</div>
      <div class="ty-names">Anh Xuân &amp; Thư Hương · 25.12.2023</div>
      <svg style="width:52px;height:52px;margin:0 auto 20px;display:block;animation:float 4s ease-in-out infinite" viewBox="0 0 80 80">
        <circle cx="40" cy="40" r="35" fill="none" stroke="#c9a96e" stroke-width="1" stroke-dasharray="3,2" opacity=".6"/>
        <path d="M40,50C40,50 26,42 26,34C26,28 31,25 35,25C37.5,25 40,27.5 40,27.5C40,27.5 42.5,25 45,25C49,25 54,28 54,34C54,42 40,50 40,50Z" fill="#e8a99a" opacity=".85"/>
      </svg>
      <p class="ty-message">"Cảm ơn bạn đã hiện diện trong ngày trọng đại nhất cuộc đời chúng tôi. Mỗi nụ cười, mỗi lời chúc của bạn là hành lý quý giá nhất chúng tôi mang theo trên hành trình mới này."</p>
      <div style="display:flex;align-items:center;gap:12px;justify-content:center;margin-bottom:16px">
        <div style="flex:1;height:1px;background:linear-gradient(90deg,transparent,rgba(201,169,110,.4))"></div>
        <span style="color:var(--gold);font-size:14px">✦</span>
        <div style="flex:1;height:1px;background:linear-gradient(90deg,rgba(201,169,110,.4),transparent)"></div>
      </div>
      <div class="ty-hashtag">#AnhXuanThuHuong &nbsp;·&nbsp; #25122023</div>
    </div>
  </div>
</section>

<script>
/* PETALS */
(function(){
  const bg=document.getElementById('petalBg');
  const c=['#f8d0c4','#f5c4b8','#fce4de','#e8d5b0','#f9ddd6'];
  for(let i=0;i<22;i++){
    const p=document.createElement('div');p.className='petal';
    const s=5+Math.random()*13;
    p.style.cssText=`left:${Math.random()*100}%;top:${-20-Math.random()*10}%;width:${s}px;height:${s*1.4}px;background:${c[~~(Math.random()*c.length)]};animation-duration:${6+Math.random()*9}s;animation-delay:${Math.random()*8}s;opacity:0;transform:rotate(${Math.random()*360}deg)`;
    bg.appendChild(p);
  }
})();

/* OPEN BOOK */
let opened=false;
function openBook(){
  if(opened)return; opened=true;

  // hide hint
  const hint=document.getElementById('clickHint');
  hint.style.transition='opacity .3s'; hint.style.opacity='0';

  // light rays
  const rays=document.getElementById('lightRays');
  rays.classList.add('show');
  for(let i=0;i<18;i++){
    const r=document.createElement('div'); r.className='ray';
    r.style.setProperty('--r',`${i*20}deg`);
    r.style.animationDelay=`${i*0.038}s`;
    rays.appendChild(r);
  }
  setTimeout(()=>{rays.classList.remove('show');rays.innerHTML=''},1200);

  // flip cover out
  const cover=document.getElementById('bookCoverEl');
  cover.style.transition='transform 1.05s cubic-bezier(.4,0,.2,1), opacity .45s ease .7s';
  cover.style.transformOrigin='left center';
  cover.style.transform='rotateY(-175deg)';
  cover.style.opacity='0';

  // shrink closed state
  const closed=document.getElementById('state-closed');
  setTimeout(()=>{
    closed.style.transition='opacity .5s ease, transform .5s ease';
    closed.style.opacity='0'; closed.style.transform='scale(.72) translateY(-24px)';
  },860);

  // swap to open state
  setTimeout(()=>{
    closed.style.display='none';
    const openState=document.getElementById('state-open');
    openState.classList.add('show');
    // trigger animation
    requestAnimationFrame(()=>requestAnimationFrame(()=>{
      document.getElementById('openBook2').classList.add('animate');
    }));
  },1280);
}

/* SCROLL REVEAL */
const ro=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting)x.target.classList.add('visible')}),{threshold:.1});
document.querySelectorAll('.reveal').forEach(el=>ro.observe(el));

/* NAV DOTS */
const sIDs=['hero','boarding','passport-spread','save-the-date','details','rsvp','thankyou'];
const dots=[...document.querySelectorAll('.nav-dot')];
window.addEventListener('scroll',()=>{
  const mid=scrollY+innerHeight/2;
  sIDs.forEach((id,i)=>{
    const el=document.getElementById(id); if(!el) return;
    if(mid>=el.offsetTop&&mid<el.offsetTop+el.offsetHeight){
      dots.forEach(d=>d.classList.remove('active')); dots[i].classList.add('active');
    }
  });
});
dots.forEach((d,i)=>d.addEventListener('click',()=>document.getElementById(sIDs[i]).scrollIntoView({behavior:'smooth'})));

/* RSVP */
function selectAttend(el){document.querySelectorAll('.attend-btn').forEach(b=>b.classList.remove('active'));el.classList.add('active')}
function handleRsvp(btn){
  const o=btn.innerHTML;
  btn.innerHTML='<span>✓ &nbsp; Đã Xác Nhận Chuyến Bay!</span>';
  btn.style.background='linear-gradient(90deg,#7ab07a,#5a9a5a)';
  setTimeout(()=>{btn.innerHTML=o;btn.style.background=''},3500);
}
</script>
</body>
</html>