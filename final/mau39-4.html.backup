      <div class="visa-id">WED-2023-1225</div>
    </div>
    <div class="visa-body">
      <div class="visa-photo"><img src="https://images.unsplash.com/photo-1519741497674-611481863552?w=300&auto=format&fit=crop&q=80" alt="Đôi uyên ương"></div>
      <div class="visa-fields">
        <div class="visa-field"><span class="vf-label">Cô Dâu</span><span class="vf-value">Trần Thư Hương</span></div>
