  </div>
</section>

<!-- ══════════════════════════════════
     SAVE THE DATE
══════════════════════════════════ -->
<section class="page-section" id="save-the-date">
  <div class="std-card reveal">
    <div class="std-stamp">
      <svg width="80" height="80" viewBox="0 0 90 90">
        <circle cx="45" cy="45" r="40" fill="none" stroke="#c0392b" stroke-width="2" stroke-dasharray="4,2" opacity=".7"/>
        <circle cx="45" cy="45" r="32" fill="none" stroke="#c0392b" stroke-width="1" opacity=".5"/>
        <text x="45" y="32" text-anchor="middle" font-family="Jost" font-size="7" fill="#c0392b" letter-spacing="3" opacity=".8">SAVE THE</text>
        <text x="45" y="52" text-anchor="middle" font-family="Playfair Display" font-size="14" font-weight="700" fill="#c0392b" opacity=".8">DATE</text>
        <text x="45" y="66" text-anchor="middle" font-family="Jost" font-size="7" fill="#c0392b" letter-spacing="2" opacity=".7">25.12.2023</text>
      </svg>
    </div>
    <div class="std-inner">
      <svg width="100%" height="40" viewBox="0 0 340 40" overflow="visible" style="margin-bottom:24px">
        <path d="M0,30 Q85,5 170,20 Q255,35 340,10" stroke="#f5cdc3" stroke-width="1.5" fill="none" stroke-dasharray="8,4"/>
