      <div class="std-names">Anh Xuân<span class="amp">&</span>Thư Hương</div>
      <div class="std-divider"><span class="std-divider-icon">✦</span></div>
      <div class="std-date">Thứ Hai, 25 tháng 12 năm 2023</div>
      <div class="std-place">Royal Palace · Hà Nội, Việt Nam</div>
      <div class="std-divider" style="margin-top:20px"><span class="std-divider-icon">💕</span></div>
      <div style="font-family:'Cormorant Garamond',serif;font-size:13px;font-style:italic;color:var(--muted);line-height:1.8">Lễ Vu Quy: 08:00 SA &nbsp;·&nbsp; Tiệc Cưới: 11:30 SA</div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════
     DETAILS
══════════════════════════════════ -->
