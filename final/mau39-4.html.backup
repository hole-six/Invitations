        <div class="visa-field"><span class="vf-label">Tiệc Cưới</span><span class="vf-value">11:30 SA · Royal Palace Ballroom</span></div>
        <div class="visa-field"><span class="vf-label">Địa Chỉ</span><span class="vf-value">123 Đường Hoàng Văn Thụ, Hà Nội</span></div>
        <div class="visa-field"><span class="vf-label">Xác Nhận Trước</span><span class="vf-value">01 tháng 12 năm 2023</span></div>
      </div>
    </div>
    <div class="visa-footer">
      <div class="visa-mrz">WED&lt;VNM&lt;NGUYEN&lt;ANH&lt;XUAN&lt;&lt;&lt;TRAN&lt;THU&lt;HUONG<br>2312253&lt;&lt;&lt;ROYAL&lt;PALACE&lt;HANOI&lt;&lt;&lt;VNM&lt;&lt;&lt;&lt;&lt;</div>
      <div class="visa-stamp-approved">APPROVED ✓</div>
