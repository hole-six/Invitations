<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Passport Wedding – Anh Xuân & Thư Hương</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Great+Vibes&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --rose:#f9ddd6;--rose2:#f5cdc3;--rose3:#e8a99a;
  --gold:#c9a96e;--gold2:#b8893a;--gold3:#e8d5b0;
  --white:#fff;--dark:#2a1810;--brown:#6b3a2a;--muted:#9a7a6e;--stamp:#c0392b;
}
html{scroll-behavior:smooth}
body{font-family:'Jost',sans-serif;background:#f0e8e2;color:var(--dark);overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;z-index:9999;pointer-events:none;opacity:.022;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:var(--rose)}
::-webkit-scrollbar-thumb{background:var(--gold);border-radius:2px}

/* ══ KEYFRAMES ══ */
@keyframes fadeUp{from{opacity:0;transform:translateY(32px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes petalDrift{0%{transform:translateY(-30px) rotate(0deg);opacity:0}10%{opacity:.5}90%{opacity:.2}100%{transform:translateY(110vh) rotate(660deg);opacity:0}}
@keyframes dashDraw{to{stroke-dashoffset:0}}
@keyframes planefly{0%{transform:translate(-60px,20px) rotate(15deg);opacity:0}20%{opacity:1}100%{transform:translate(340px,-20px) rotate(15deg);opacity:0}}
@keyframes stampDrop{0%{transform:translateY(-80px) scale(1.3) rotate(-8deg);opacity:0}70%{transform:translateY(4px) scale(.97) rotate(-12deg);opacity:1}85%{transform:translateY(-3px) scale(1.02)}100%{transform:translateY(0) scale(1) rotate(-12deg);opacity:1}}
@keyframes shimmer{0%,100%{opacity:.6}50%{opacity:1}}
@keyframes hintFloat{0%,100%{opacity:.5;transform:translateY(0)}50%{opacity:1;transform:translateY(6px)}}
@keyframes rayBurst{0%{opacity:0;transform:translateX(-50%) rotate(var(--r)) scaleY(0)}35%{opacity:.55}100%{opacity:0;transform:translateX(-50%) rotate(var(--r)) scaleY(1)}}

/* ── spread appears ── */
@keyframes bookExpand{
  0%  {width:min(300px,80vw);opacity:.6}
  60% {width:min(1000px,98vw);opacity:1}
  100%{width:min(960px,96vw);opacity:1}
}
@keyframes leftPageReveal{
  0%  {opacity:0;transform:translateX(-30px)}
  100%{opacity:1;transform:translateX(0)}
}
@keyframes rightPageReveal{
  0%  {opacity:0;transform:translateX(30px)}
  100%{opacity:1;transform:translateX(0)}
}
@keyframes textFloat{
  0%  {opacity:0;transform:translateY(18px)}
  100%{opacity:1;transform:translateY(0)}
}
@keyframes coverFlip{
  0%  {transform:rotateY(0deg);z-index:10}
  100%{transform:rotateY(-175deg);z-index:0}
}
@keyframes scrollArrow{0%,100%{opacity:.4;transform:translateY(0)}50%{opacity:1;transform:translateY(6px)}}

.reveal{opacity:0;transform:translateY(28px);transition:opacity .9s ease,transform .9s ease}
.reveal.visible{opacity:1;transform:translateY(0)}
.page-section{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:80px 24px;position:relative;overflow:hidden}

/* ════════════════════════════════════════
   HERO
════════════════════════════════════════ */
#hero{
  background:linear-gradient(145deg,#fce8e2 0%,#fdf4f0 45%,#f9e8e0 100%);
  flex-direction:column;padding:0;
}
#hero::before{content:'';position:absolute;top:-120px;right:-80px;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(249,189,175,.22) 0%,transparent 68%);pointer-events:none}
#hero::after{content:'';position:absolute;bottom:-100px;left:-70px;width:430px;height:430px;border-radius:50%;background:radial-gradient(circle,rgba(232,169,154,.16) 0%,transparent 68%);pointer-events:none}
.petal-bg{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:0}
.petal{position:absolute;border-radius:50% 0 50% 0;animation:petalDrift linear infinite;opacity:0}

/* ── light rays ── */
.light-rays{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:600;display:none}
.light-rays.show{display:block}
.ray{position:fixed;top:50%;left:50%;width:2px;height:65vmax;background:linear-gradient(to bottom,rgba(252,232,226,.9),transparent);transform-origin:top center;opacity:0;animation:rayBurst .9s ease-out forwards}

/* ───────────────────────────
   CLOSED PASSPORT STATE
─────────────────────────── */
#state-closed{
  display:flex;flex-direction:column;align-items:center;
  position:relative;z-index:2;width:100%;
  padding:60px 0 40px;
}
.hero-eyebrow{
  font-size:8px;letter-spacing:.44em;text-transform:uppercase;
  color:rgba(107,58,42,.48);margin-bottom:28px;
  animation:fadeIn 1s ease both .3s;
}

/* 3-D book scene */
.book-scene{perspective:1500px;cursor:pointer;position:relative;display:inline-block}
.book-3d{
  width:min(300px,78vw);height:min(400px,52vw);
  position:relative;transform-style:preserve-3d;
  transition:transform .22s ease;
  animation:fadeUp 1s cubic-bezier(.22,.61,.36,1) both .45s;
}
.book-scene:hover .book-3d{transform:rotateY(-10deg) rotateX(4deg) translateY(-10px)}
.book-pages-edge{position:absolute;top:3px;right:-9px;bottom:3px;width:13px;border-radius:0 4px 4px 0;background:repeating-linear-gradient(90deg,#fdf8f6 0,#fdf8f6 1.5px,#e8d8d2 1.5px,#e8d8d2 2.2px);box-shadow:3px 0 9px rgba(100,40,20,.1)}

/* cover */
.book-cover-el{
  position:absolute;inset:0;
  background:linear-gradient(160deg,#fce4de 0%,#f5c8bc 100%);
  border-radius:8px 22px 22px 8px;
  box-shadow:-12px 0 0 rgba(190,110,95,.42),0 44px 90px rgba(100,40,20,.24),0 10px 28px rgba(100,40,20,.16),inset 0 0 0 1px rgba(201,169,110,.16);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:36px 28px;text-align:center;
  transform-style:preserve-3d;
  transform-origin:left center;
}
.book-cover-el::before{content:'';position:absolute;top:0;left:0;width:24px;height:100%;background:linear-gradient(90deg,#c07268,#dfa090 50%,#c07268);border-radius:8px 0 0 8px}
.book-cover-el::after{content:'';position:absolute;inset:14px 10px;border:1px solid rgba(201,169,110,.25);border-radius:4px;pointer-events:none}
.bc-watermark{position:absolute;bottom:20px;right:18px;width:50px;height:50px;opacity:.2;animation:spin 40s linear infinite}
.bc-lbl{font-size:7px;letter-spacing:.36em;text-transform:uppercase;color:rgba(107,58,42,.46);margin-bottom:10px}
.bc-emblem{width:62px;height:62px;margin:0 auto 12px;animation:float 5s ease-in-out infinite}
.bc-title{font-family:'Playfair Display',serif;font-size:clamp(18px,5vw,26px);font-weight:700;letter-spacing:.14em;color:var(--gold2);text-transform:uppercase;margin-bottom:1px}
.bc-sub{font-size:7.5px;letter-spacing:.26em;text-transform:uppercase;color:var(--brown);margin-bottom:18px}
.bc-names{font-family:'Great Vibes',cursive;font-size:clamp(30px,8vw,46px);color:var(--brown);line-height:1.05}
.bc-amp{font-family:'Great Vibes',cursive;font-size:clamp(22px,6vw,34px);color:var(--gold);display:block;line-height:.85;margin:2px 0}
.bc-date{font-size:13px;font-style:italic;color:var(--muted);margin-top:12px}

/* click hint */
.click-hint{margin-top:26px;display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;animation:hintFloat 2.5s ease-in-out infinite .8s}
.click-hint span{font-size:8px;letter-spacing:.32em;text-transform:uppercase;color:var(--muted)}
.click-hint i{font-size:19px;color:var(--gold);font-style:normal}

/* ───────────────────────────
   OPEN PASSPORT STATE  ← HERO PAGE
─────────────────────────── */
#state-open{
  display:none;
  width:100%;min-height:100vh;
  position:relative;z-index:2;
  align-items:stretch;
  overflow:hidden;
}
#state-open.show{display:flex}

/* The open book — full-width hero */
.open-book{
  display:grid;grid-template-columns:1fr 1fr;
  width:100%;min-height:100vh;
  position:relative;
  opacity:0;
}
.open-book.animate{animation:bookExpand .9s cubic-bezier(.22,.61,.36,1) forwards .05s}

/* center binding */
.ob-spine{
  position:absolute;top:0;left:50%;transform:translateX(-50%);
  width:20px;height:100%;
  background:linear-gradient(90deg,#c8a898,#f0ddd6,#c8a898);
  z-index:10;
  box-shadow:0 0 18px rgba(100,40,20,.18);
}

/* LEFT PAGE — groom photo */
.ob-page-left{
  position:relative;overflow:hidden;
  background:#1a0e0a;
  opacity:0;animation:leftPageReveal .7s ease forwards .6s;
}
.ob-page-left img{
  width:100%;height:100%;object-fit:cover;display:block;
  filter:brightness(.82) contrast(1.05);
  transform:scale(1.04);
  transition:transform 8s ease;
}
.ob-page-left:hover img{transform:scale(1.08)}

/* left page overlay gradient */
.ob-page-left::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(
    to right,  rgba(26,14,10,.0) 30%, rgba(26,14,10,.55) 100%),
    linear-gradient(to top, rgba(26,14,10,.7) 0%, transparent 50%);
  pointer-events:none;z-index:1;
}

/* groom name bottom-left */
.ob-left-text{
  position:absolute;bottom:0;left:0;right:0;
  z-index:2;padding:40px 36px 36px;
  opacity:0;animation:textFloat .7s ease forwards .95s;
}
.ob-left-text .page-role{font-size:8px;letter-spacing:.44em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:8px}
.ob-left-text .page-name{font-family:'Great Vibes',cursive;font-size:clamp(36px,6vw,58px);color:#fff;line-height:1;text-shadow:0 2px 20px rgba(0,0,0,.4)}
.ob-left-text .page-fullname{font-family:'Cormorant Garamond',serif;font-size:clamp(12px,1.6vw,15px);color:rgba(255,255,255,.65);letter-spacing:.12em;margin-top:5px}

/* left stamp */
.ob-left-stamp{position:absolute;top:24px;left:28px;z-index:2;opacity:.75;animation:textFloat .6s ease forwards .7s;opacity:0}

/* RIGHT PAGE — bride photo */
.ob-page-right{
  position:relative;overflow:hidden;
  background:#1a0e0a;
  opacity:0;animation:rightPageReveal .7s ease forwards .6s;
}
.ob-page-right img{
  width:100%;height:100%;object-fit:cover;display:block;
  filter:brightness(.82) contrast(1.05);
  transform:scale(1.04);
  transition:transform 8s ease;
}
.ob-page-right:hover img{transform:scale(1.08)}
.ob-page-right::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(
    to left, rgba(26,14,10,.0) 30%, rgba(26,14,10,.55) 100%),
    linear-gradient(to top, rgba(26,14,10,.7) 0%, transparent 50%);
  pointer-events:none;z-index:1;
}

/* bride name bottom-right */
.ob-right-text{
  position:absolute;bottom:0;left:0;right:0;
  z-index:2;padding:40px 36px 36px;text-align:right;
  opacity:0;animation:textFloat .7s ease forwards 1.0s;
}
.ob-right-text .page-role{font-size:8px;letter-spacing:.44em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:8px}
.ob-right-text .page-name{font-family:'Great Vibes',cursive;font-size:clamp(36px,6vw,58px);color:#fff;line-height:1;text-shadow:0 2px 20px rgba(0,0,0,.4)}
.ob-right-text .page-fullname{font-family:'Cormorant Garamond',serif;font-size:clamp(12px,1.6vw,15px);color:rgba(255,255,255,.65);letter-spacing:.12em;margin-top:5px}

/* right stamp */
.ob-right-stamp{position:absolute;top:24px;right:36px;z-index:2;opacity:0;animation:textFloat .6s ease forwards .75s}

/* CENTER OVERLAY — date + scroll cue */
.ob-center{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  z-index:20;text-align:center;
  pointer-events:none;
  opacity:0;animation:textFloat .8s ease forwards 1.15s;
}
.ob-center-heart{font-size:28px;display:block;margin-bottom:10px;filter:drop-shadow(0 2px 12px rgba(0,0,0,.5));animation:float 4s ease-in-out infinite 1.5s}
.ob-center-amp{font-family:'Great Vibes',cursive;font-size:clamp(44px,7vw,68px);color:#fff;line-height:1;text-shadow:0 2px 30px rgba(0,0,0,.5),0 0 60px rgba(201,169,110,.4)}
.ob-center-date{font-family:'Cormorant Garamond',serif;font-size:clamp(11px,1.5vw,14px);font-style:italic;color:rgba(255,255,255,.7);letter-spacing:.2em;margin-top:6px}

/* MRZ bar at very bottom */
.ob-mrz{
  position:absolute;bottom:0;left:0;right:0;
  z-index:20;background:rgba(0,0,0,.5);
  padding:8px 28px;
  display:flex;justify-content:space-between;align-items:center;
  opacity:0;animation:textFloat .6s ease forwards 1.3s;
}
.ob-mrz-text{font-family:monospace;font-size:7.5px;color:rgba(255,255,255,.45);letter-spacing:.06em}
.ob-mrz-approved{font-family:'Playfair Display',serif;font-size:11px;font-weight:700;color:var(--stamp);border:1.5px solid var(--stamp);padding:2px 10px;border-radius:2px;opacity:.7;letter-spacing:.14em;animation:shimmer 2.5s ease-in-out infinite}

/* scroll hint */
.ob-scroll{
  position:absolute;bottom:60px;left:50%;
  z-index:22;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:5px;
  opacity:0;animation:fadeIn .8s ease 1.8s forwards;
  pointer-events:none;
}
.ob-scroll span{font-size:7.5px;letter-spacing:.3em;text-transform:uppercase;color:rgba(255,255,255,.5)}
.ob-scroll i{font-size:16px;color:rgba(255,255,255,.5);font-style:normal;animation:scrollArrow 2.2s ease-in-out infinite 2s}

/* ════════════════════════════════════════
   BOARDING PASS
════════════════════════════════════════ */
#boarding{background:linear-gradient(135deg,#fdf0ee,#faf5f2,#f5ede8)}
.boarding-card{width:min(680px,95vw);background:var(--white);border-radius:12px;box-shadow:0 24px 70px rgba(100,40,20,.13);overflow:hidden;position:relative}
.boarding-header{background:linear-gradient(90deg,var(--rose2),#f8cfc8,var(--rose2));padding:18px 28px 14px;display:flex;align-items:center;justify-content:space-between}
.boarding-airline{display:flex;align-items:center;gap:10px}
.boarding-airline-icon{font-size:22px;animation:float 3s ease-in-out infinite}
.boarding-airline-name{font-size:9px;letter-spacing:.28em;text-transform:uppercase;color:var(--brown);font-weight:600}
.boarding-type{font-size:9px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);border:1px solid var(--rose3);padding:3px 10px;border-radius:20px}
.boarding-body{padding:24px 28px 0;display:grid;grid-template-columns:1fr auto 1fr;gap:20px;align-items:start}
.boarding-from,.boarding-to{text-align:center}
.boarding-code{font-family:'Playfair Display',serif;font-size:clamp(36px,8vw,52px);font-weight:700;color:var(--brown);line-height:1}
.boarding-city{font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-top:4px}
.flight-path-wrap{display:flex;flex-direction:column;align-items:center;padding-top:8px}
.flight-path-svg{width:120px;height:50px;overflow:visible}
.flight-path-line{stroke-dasharray:200;stroke-dashoffset:200;animation:dashDraw 2s ease forwards .8s}
.plane-icon{font-size:20px;display:inline-block;animation:planefly 3.5s ease-in-out infinite 1.5s}
.boarding-duration{font-size:8.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-top:4px}
.boarding-info{padding:18px 28px;display:grid;grid-template-columns:repeat(4,1fr);gap:16px;border-top:1px dashed var(--rose);margin-top:18px}
.info-item{text-align:center}
.info-label{font-size:7.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);margin-bottom:4px;display:block}
.info-value{font-family:'Playfair Display',serif;font-size:15px;font-weight:600;color:var(--brown)}
.tear-line{display:flex;align-items:center;padding:0 20px}
.tear-line::before,.tear-line::after{content:'';width:20px;height:20px;border-radius:50%;background:#f0e8e2;flex-shrink:0}
.tear-dashes{flex:1;border-top:2px dashed var(--rose2)}
.boarding-stub{background:linear-gradient(135deg,#fdf0f2,#fbeff0);padding:20px 28px;display:flex;justify-content:space-between;align-items:center}
.stub-names{font-family:'Great Vibes',cursive;font-size:28px;color:var(--brown)}
.stub-date{font-size:10px;color:var(--muted);margin-top:2px;letter-spacing:.1em}
.barcode-svg{opacity:.4}
.thank-you-badge{position:absolute;top:-8px;right:28px;background:var(--rose2);color:var(--brown);font-family:'Great Vibes',cursive;font-size:22px;padding:8px 20px;box-shadow:0 4px 12px rgba(100,40,20,.12);transform:rotate(-2deg)}

/* ════════════════════════════════════════
   PASSPORT SPREAD
════════════════════════════════════════ */
#passport-spread{background:linear-gradient(150deg,#f5ede8,#fdf8f5,#f0e8e2);flex-direction:column}
.spread-title{font-size:9.5px;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);margin-bottom:36px;text-align:center}
.passport-book{width:min(720px,95vw);display:grid;grid-template-columns:1fr 1fr;background:var(--white);border-radius:4px 12px 12px 4px;box-shadow:0 2px 0 rgba(200,140,120,.3),0 30px 80px rgba(100,40,20,.16);overflow:hidden;position:relative}
.passport-book::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:16px;height:100%;background:linear-gradient(90deg,#e0c8c0,#f5e0d8,#e0c8c0);z-index:3}
.passport-book::after{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:24px;height:100%;background:linear-gradient(90deg,rgba(100,40,20,.06),transparent 40%,rgba(100,40,20,.06));z-index:4;pointer-events:none}
.passport-page{padding:36px 28px;position:relative;overflow:hidden}
.passport-page:first-child{background:linear-gradient(160deg,#fffaf8,#fdf6f3)}
.passport-page:last-child{background:linear-gradient(160deg,#fdf6f3,#fffaf8)}
.page-watermark{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:80px;font-weight:700;color:rgba(201,169,110,.04);pointer-events:none;user-select:none}
.page-number{font-size:7px;letter-spacing:.22em;color:var(--muted);text-align:center;margin-bottom:24px}
.passport-photo{width:120px;height:150px;margin:0 auto 20px;border:3px solid var(--rose2);overflow:hidden;position:relative;box-shadow:0 8px 24px rgba(100,40,20,.12)}
.passport-photo img{width:100%;height:100%;object-fit:cover;display:block}
.passport-photo-label{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(107,58,42,.6));padding:12px 8px 6px;font-family:'Great Vibes',cursive;font-size:16px;color:#fff;text-align:center}
.passport-field{border-bottom:1px solid var(--rose);padding:8px 0;margin-bottom:2px}
.field-label{font-size:7px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:2px}
.field-value{font-family:'Cormorant Garamond',serif;font-size:14px;color:var(--dark)}
.passport-stamp{position:absolute;width:90px;height:90px;opacity:.72}
.stamp-tr{top:12px;right:12px;transform:rotate(12deg)}
.stamp-tl{top:12px;left:12px;transform:rotate(-10deg)}
.spread-names{text-align:center;margin-bottom:16px}
.spread-names-script{font-family:'Great Vibes',cursive;font-size:clamp(26px,5vw,36px);color:var(--brown);line-height:1.1}
.mrz{font-family:monospace;font-size:9px;color:var(--muted);letter-spacing:.08em;background:rgba(201,169,110,.06);padding:8px;margin-top:16px;border-radius:2px;overflow:hidden;word-break:break-all}

/* ════════════════════════════════════════
   SAVE THE DATE
════════════════════════════════════════ */
#save-the-date{background:linear-gradient(150deg,#fce8e2,#fdf4f0,#f9e8e0);flex-direction:column}
.std-card{width:min(480px,92vw);background:var(--white);border-radius:8px;box-shadow:0 24px 70px rgba(100,40,20,.14);padding:52px 44px;text-align:center;position:relative;overflow:hidden}
.std-card::before{content:'';position:absolute;inset:12px;border:1px solid rgba(201,169,110,.3);border-radius:4px;pointer-events:none}
.std-card::after{content:'';position:absolute;inset:18px;border:1px solid rgba(201,169,110,.14);border-radius:2px;pointer-events:none}
.std-inner{position:relative;z-index:2}
.std-stamp{position:absolute;top:18px;right:18px;animation:stampDrop .9s cubic-bezier(.34,1.56,.64,1) both .8s}
.std-title{font-family:'Playfair Display',serif;font-size:clamp(26px,5vw,34px);font-weight:700;color:var(--gold2);text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px}
.std-sub{font-size:9px;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);margin-bottom:28px}
.std-names{font-family:'Great Vibes',cursive;font-size:clamp(42px,9vw,62px);color:var(--brown);line-height:1;margin-bottom:6px}
.std-names .amp{font-size:clamp(30px,7vw,44px);color:var(--gold);display:block;line-height:.9}
.std-divider{display:flex;align-items:center;gap:12px;margin:20px 0}
.std-divider::before,.std-divider::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--gold3),transparent)}
.std-divider-icon{color:var(--gold);font-size:14px}
.std-date{font-family:'Playfair Display',serif;font-size:clamp(18px,4vw,24px);color:var(--brown);margin-bottom:4px}
.std-place{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}

/* ════════════════════════════════════════
   DETAILS
════════════════════════════════════════ */
#details{background:linear-gradient(150deg,#f5ede8,#fdf8f5,#f0e8e2);flex-direction:column}
.visa-card{width:min(680px,95vw);background:var(--white);border-radius:8px;box-shadow:0 24px 70px rgba(100,40,20,.13);overflow:hidden}
.visa-header{background:linear-gradient(90deg,var(--rose2),#fce8e4,var(--rose2));padding:20px 32px;display:flex;justify-content:space-between;align-items:center}
.visa-header-title{font-family:'Playfair Display',serif;font-size:18px;font-weight:700;color:var(--brown);letter-spacing:.06em}
.visa-header-sub{font-size:8.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
.visa-id{font-family:monospace;font-size:11px;color:var(--muted);letter-spacing:.12em}
.visa-body{padding:32px;display:grid;grid-template-columns:160px 1fr;gap:28px}
.visa-photo{width:100%;aspect-ratio:3/4;background:var(--rose);overflow:hidden;border:2px solid var(--rose2)}
.visa-photo img{width:100%;height:100%;object-fit:cover;display:block}
.visa-fields{display:flex;flex-direction:column}
.visa-field{padding:10px 0;border-bottom:1px solid rgba(249,221,214,.8);display:grid;grid-template-columns:120px 1fr}
.visa-field:last-child{border-bottom:none}
.vf-label{font-size:8px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);padding-top:2px}
.vf-value{font-family:'Cormorant Garamond',serif;font-size:15px;color:var(--dark)}
.visa-footer{background:rgba(249,221,214,.3);padding:16px 32px;display:flex;justify-content:space-between;align-items:center}
.visa-stamp-approved{font-family:'Playfair Display',serif;font-size:14px;font-weight:700;color:var(--stamp);letter-spacing:.14em;border:2px solid var(--stamp);padding:5px 16px;border-radius:2px;transform:rotate(-3deg);display:inline-block;opacity:.7;animation:shimmer 2.5s ease-in-out infinite}
.visa-mrz{font-family:monospace;font-size:8.5px;color:var(--muted);letter-spacing:.08em;line-height:1.6}

/* ════════════════════════════════════════
   RSVP
════════════════════════════════════════ */
#rsvp{background:linear-gradient(150deg,#fce8e2,#fdf4f0,#f9e8e0);flex-direction:column}
.rsvp-card{width:min(540px,94vw);background:var(--white);border-radius:8px;box-shadow:0 24px 70px rgba(100,40,20,.13);padding:48px 44px;text-align:center;position:relative;overflow:hidden}
.rsvp-card::before{content:'';position:absolute;inset:10px;border:1px solid rgba(201,169,110,.25);border-radius:4px;pointer-events:none}
.rsvp-inner{position:relative;z-index:2}
.rsvp-tag{font-size:8.5px;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);display:inline-block;border-bottom:1px solid var(--gold3);padding-bottom:3px;margin-bottom:18px}
.rsvp-title{font-family:'Playfair Display',serif;font-size:clamp(22px,4vw,28px);font-weight:600;color:var(--brown);margin-bottom:6px}
.rsvp-sub{font-size:12px;color:var(--muted);margin-bottom:30px;line-height:1.7;font-family:'Cormorant Garamond',serif;font-style:italic}
.rsvp-attend{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px}
.attend-btn{border:1px solid var(--rose2);background:transparent;padding:14px;cursor:pointer;transition:all .25s;text-align:center}
.attend-btn:hover,.attend-btn.active{background:var(--rose);border-color:var(--rose3)}
.attend-icon{font-size:22px;display:block;margin-bottom:5px}
.attend-label{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--brown)}
.form-field{margin-bottom:18px;text-align:left}
.form-label{font-size:8px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:6px}
.form-input{width:100%;border:none;border-bottom:1px solid var(--rose2);background:transparent;padding:8px 0;font-family:'Jost',sans-serif;font-size:14px;color:var(--dark);outline:none;transition:border-color .2s}
.form-input:focus{border-bottom-color:var(--gold)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.btn-submit{width:100%;background:linear-gradient(90deg,var(--rose3),#d4857a);color:#fff;border:none;padding:15px;font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.22em;text-transform:uppercase;cursor:pointer;margin-top:24px;transition:all .25s}
.btn-submit:hover{background:linear-gradient(90deg,#d4857a,var(--rose3))}

/* ════════════════════════════════════════
   THANK YOU
════════════════════════════════════════ */
#thankyou{background:linear-gradient(150deg,#f9e8e0,#fdf4f0,#fce8e2);flex-direction:column;text-align:center}
.ty-passport{width:min(440px,92vw);background:linear-gradient(160deg,#fce4de,#f9d8d0);border-radius:4px 12px 12px 4px;box-shadow:-8px 0 0 rgba(200,140,120,.3),0 30px 80px rgba(100,40,20,.18);padding:52px 40px 48px;text-align:center;position:relative;overflow:hidden}
.ty-passport::before{content:'';position:absolute;top:0;left:0;width:18px;height:100%;background:linear-gradient(90deg,#d4857a,#e8a99a,#d4857a);border-radius:4px 0 0 4px}
.ty-passport::after{content:'';position:absolute;inset:18px 14px;border:1px solid rgba(201,169,110,.25);border-radius:4px;pointer-events:none}
.ty-inner{position:relative;z-index:2}
.ty-label{font-size:8px;letter-spacing:.4em;text-transform:uppercase;color:rgba(107,58,42,.5);margin-bottom:16px}
.ty-title{font-family:'Great Vibes',cursive;font-size:clamp(42px,10vw,64px);color:var(--brown);margin-bottom:8px}
.ty-names{font-family:'Cormorant Garamond',serif;font-size:16px;font-style:italic;color:var(--muted);margin-bottom:24px;letter-spacing:.06em}
.ty-message{font-family:'Cormorant Garamond',serif;font-size:15px;line-height:1.85;color:var(--brown);font-style:italic;max-width:320px;margin:0 auto 24px}
.ty-hashtag{font-size:10px;letter-spacing:.18em;color:var(--muted);text-transform:uppercase}

/* NAV */
.nav-dots{position:fixed;right:20px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:8px;z-index:200}
.nav-dot{width:8px;height:8px;border-radius:50%;background:rgba(107,58,42,.2);cursor:pointer;transition:all .25s;border:1px solid rgba(107,58,42,.12)}
.nav-dot.active{background:var(--gold);transform:scale(1.35)}
.nav-dot:hover{background:var(--rose3)}

@media(max-width:640px){
  .boarding-body{grid-template-columns:1fr;gap:12px}
  .flight-path-wrap{display:none}
  .boarding-info{grid-template-columns:1fr 1fr}
  .passport-book{grid-template-columns:1fr}
  .passport-book::before,.passport-book::after{display:none}
  .visa-body{grid-template-columns:1fr}
  .visa-photo{width:120px;margin:0 auto}
  .rsvp-attend,.form-row{grid-template-columns:1fr}
  .ob-left-text,.ob-right-text{padding:24px 20px 20px}
  .ob-center-amp{font-size:42px}
}
</style>
</head>
<body>

<!-- light rays -->
<div class="light-rays" id="lightRays"></div>

<!-- nav -->
<nav class="nav-dots" id="navDots">
  <div class="nav-dot active" data-s="hero"></div>
  <div class="nav-dot" data-s="boarding"></div>
  <div class="nav-dot" data-s="passport-spread"></div>
  <div class="nav-dot" data-s="save-the-date"></div>
  <div class="nav-dot" data-s="details"></div>
  <div class="nav-dot" data-s="rsvp"></div>
  <div class="nav-dot" data-s="thankyou"></div>
</nav>

<!-- ══════════════════════════════════
     HERO
══════════════════════════════════ -->
<section class="page-section" id="hero">

  <div class="petal-bg" id="petalBg"></div>

  <!-- deco roses -->
  <svg style="position:absolute;top:22px;right:42px;width:88px;opacity:.3;animation:float 6s ease-in-out infinite;z-index:1" viewBox="0 0 100 100" fill="none">
    <circle cx="50" cy="50" r="18" fill="#f5c4b8" opacity=".6"/>
    <ellipse cx="50" cy="32" rx="14" ry="20" fill="#f8d0c4" opacity=".7" transform="rotate(0 50 50)"/>
    <ellipse cx="50" cy="32" rx="14" ry="20" fill="#f5c4b8" opacity=".65" transform="rotate(45 50 50)"/>
    <ellipse cx="50" cy="32" rx="14" ry="20" fill="#f8d0c4" opacity=".65" transform="rotate(90 50 50)"/>
    <ellipse cx="50" cy="32" rx="14" ry="20" fill="#f5c4b8" opacity=".6" transform="rotate(135 50 50)"/>
    <ellipse cx="50" cy="32" rx="14" ry="20" fill="#f8d0c4" opacity=".55" transform="rotate(180 50 50)"/>
    <ellipse cx="50" cy="32" rx="14" ry="20" fill="#f5c4b8" opacity=".55" transform="rotate(225 50 50)"/>
    <ellipse cx="50" cy="32" rx="14" ry="20" fill="#f8d0c4" opacity=".5" transform="rotate(270 50 50)"/>
    <ellipse cx="50" cy="32" rx="14" ry="20" fill="#f5c4b8" opacity=".45" transform="rotate(315 50 50)"/>
  </svg>
  <svg style="position:absolute;bottom:72px;left:34px;width:58px;opacity:.2;animation:float 5s ease-in-out 1.2s infinite;z-index:1" viewBox="0 0 100 100" fill="none">
    <circle cx="50" cy="50" r="15" fill="#c9a96e" opacity=".5"/>
    <ellipse cx="50" cy="34" rx="12" ry="17" fill="#d4b47a" opacity=".6" transform="rotate(0 50 50)"/>
    <ellipse cx="50" cy="34" rx="12" ry="17" fill="#c9a96e" opacity=".55" transform="rotate(60 50 50)"/>
    <ellipse cx="50" cy="34" rx="12" ry="17" fill="#d4b47a" opacity=".5" transform="rotate(120 50 50)"/>
    <ellipse cx="50" cy="34" rx="12" ry="17" fill="#c9a96e" opacity=".5" transform="rotate(180 50 50)"/>
    <ellipse cx="50" cy="34" rx="12" ry="17" fill="#d4b47a" opacity=".45" transform="rotate(240 50 50)"/>
    <ellipse cx="50" cy="34" rx="12" ry="17" fill="#c9a96e" opacity=".4" transform="rotate(300 50 50)"/>
  </svg>

  <!-- ── STATE: CLOSED BOOK ── -->
  <div id="state-closed">
    <div class="hero-eyebrow">Cộng Hoà Xã Hội Chủ Nghĩa Việt Nam</div>

    <div class="book-scene" onclick="openBook()">
      <div class="book-3d" id="book3d">
        <div class="book-pages-edge"></div>
        <div class="book-cover-el" id="bookCoverEl">

          <svg class="bc-watermark" viewBox="0 0 80 80">
            <circle cx="40" cy="40" r="35" fill="none" stroke="#c9a96e" stroke-width="1"/>
            <circle cx="40" cy="40" r="28" fill="none" stroke="#c9a96e" stroke-width=".5"/>
            <line x1="40" y1="8" x2="40" y2="72" stroke="#c9a96e" stroke-width="1"/>
            <line x1="8" y1="40" x2="72" y2="40" stroke="#c9a96e" stroke-width="1"/>
            <polygon points="40,12 37,28 40,24 43,28" fill="#c9a96e"/>
            <polygon points="40,68 43,52 40,56 37,52" fill="#c9a96e" opacity=".5"/>
          </svg>

          <div class="bc-lbl">Wedding Invitation</div>

          <svg class="bc-emblem" viewBox="0 0 80 80">
            <circle cx="40" cy="40" r="36" fill="none" stroke="#c9a96e" stroke-width="1.5"/>
            <circle cx="40" cy="40" r="29" fill="none" stroke="#c9a96e" stroke-width=".8" stroke-dasharray="3,2"/>
            <circle cx="40" cy="40" r="20" fill="rgba(201,169,110,.1)" stroke="#c9a96e" stroke-width="1"/>
            <polygon points="40,10 37,30 40,26 43,30" fill="#c9a96e"/>
            <polygon points="40,70 43,50 40,54 37,50" fill="#c9a96e" opacity=".7"/>
            <polygon points="10,40 30,37 26,40 30,43" fill="#c9a96e" opacity=".7"/>
            <polygon points="70,40 50,43 54,40 50,37" fill="#c9a96e"/>
            <path d="M40,46C40,46 30,39 30,33C30,29 33,27 36,27C38,27 40,29 40,29C40,29 42,27 44,27C47,27 50,29 50,33C50,39 40,46 40,46Z" fill="#e8846a" opacity=".8"/>
          </svg>

          <div class="bc-title">Passport</div>
          <div class="bc-sub">Wedding Invitation</div>
          <div class="bc-names">Anh Xuân<span class="bc-amp">&</span>Thư Hương</div>
          <div class="bc-date">25 · 12 · 2023</div>
        </div>
      </div>
    </div>

    <div class="click-hint" id="clickHint" onclick="openBook()">
      <span>Bấm để mở thiệp</span>
      <i>↓</i>
    </div>
  </div>

  <!-- ── STATE: OPEN BOOK (hero spread) ── -->
  <div id="state-open">
    <div class="open-book" id="openBook2">
      <div class="ob-spine"></div>

      <!-- LEFT — Groom photo -->
      <div class="ob-page-left">
        <img src="https://images.unsplash.com/photo-1519741497674-611481863552?w=900&auto=format&fit=crop&q=85&facepad=2" alt="Cô dâu chú rể">

        <!-- stamp top-left -->
        <svg class="ob-left-stamp" width="72" height="72" viewBox="0 0 90 90">
          <circle cx="45" cy="45" r="40" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="1.5" stroke-dasharray="5,3"/>
          <circle cx="45" cy="45" r="33" fill="none" stroke="rgba(255,255,255,.3)" stroke-width=".8"/>
          <text x="45" y="30" text-anchor="middle" font-family="Jost" font-size="6" fill="rgba(255,255,255,.7)" letter-spacing="3">WEDDING</text>
          <text x="45" y="52" text-anchor="middle" font-family="Great Vibes" font-size="17" fill="rgba(255,255,255,.85)">2023</text>
          <text x="45" y="64" text-anchor="middle" font-family="Jost" font-size="5.5" fill="rgba(255,255,255,.6)" letter-spacing="2">VIETNAM</text>
        </svg>

        <div class="ob-left-text">
          <div class="page-role">Chú Rể</div>
          <div class="page-name">Anh Xuân</div>
          <div class="page-fullname">Nguyễn Anh Xuân · 14.02.1995 · Hà Nội</div>
        </div>
      </div>

      <!-- RIGHT — Bride photo -->
      <div class="ob-page-right">
        <img src="https://images.unsplash.com/photo-1606800052052-a08af7148866?w=900&auto=format&fit=crop&q=85&facepad=2" alt="Cô Dâu">

        <!-- stamp top-right -->
        <svg class="ob-right-stamp" width="72" height="72" viewBox="0 0 90 90">
          <circle cx="45" cy="45" r="40" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="1.5" stroke-dasharray="5,3"/>
          <circle cx="45" cy="45" r="33" fill="none" stroke="rgba(255,255,255,.3)" stroke-width=".8"/>
          <text x="45" y="30" text-anchor="middle" font-family="Jost" font-size="5.5" fill="rgba(255,255,255,.7)" letter-spacing="2">PASSPORT</text>
          <text x="45" y="52" text-anchor="middle" font-family="Great Vibes" font-size="14" fill="rgba(255,255,255,.85)">Love</text>
          <text x="45" y="64" text-anchor="middle" font-family="Jost" font-size="5" fill="rgba(255,255,255,.6)" letter-spacing="2">TO MARRIAGE</text>
        </svg>

        <div class="ob-right-text">
          <div class="page-role">Cô Dâu</div>
          <div class="page-name">Thư Hương</div>
          <div class="page-fullname">Trần Thư Hương · 08.03.1997 · TP. HCM</div>
        </div>
      </div>

      <!-- CENTER OVERLAY -->
      <div class="ob-center">
        <span class="ob-center-heart">💕</span>
        <div class="ob-center-amp">&</div>
        <div class="ob-center-date">25 · 12 · 2023 &nbsp;·&nbsp; Royal Palace, Hà Nội</div>
      </div>

      <!-- MRZ bar -->
      <div class="ob-mrz">
        <div class="ob-mrz-text">P&lt;VNM&lt;NGUYEN&lt;ANH&lt;XUAN&lt;&lt;&lt;TRAN&lt;THU&lt;HUONG&lt;&lt;&lt;&lt;&lt;&lt;&lt;<br>WED2023&lt;&lt;ROYAL&lt;PALACE&lt;HANOI&lt;VNM&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</div>
        <div class="ob-mrz-approved">APPROVED ✓</div>
      </div>

      <!-- Scroll hint -->
      <div class="ob-scroll">
        <span>Cuộn xuống xem thiệp</span>
        <i>↓</i>
      </div>
    </div>
  </div>

</section>

<!-- ══════════════════════════════════
     BOARDING PASS
══════════════════════════════════ -->
<section class="page-section" id="boarding">
  <div class="boarding-card reveal">
    <div class="thank-you-badge">Thank You ✈</div>
    <div class="boarding-header">
      <div class="boarding-airline">
        <span class="boarding-airline-icon">✈</span>
        <div><div class="boarding-airline-name">Love Air — Wedding Flight</div></div>
      </div>
      <div class="boarding-type">THIỆP MỜI</div>
    </div>
    <div class="boarding-body">
      <div class="boarding-from"><div class="boarding-code">HNI</div><div class="boarding-city">Hà Nội · Điểm Khởi Hành</div></div>
      <div class="flight-path-wrap">
        <svg class="flight-path-svg" viewBox="0 0 120 50" overflow="visible">
          <path class="flight-path-line" d="M0,35 Q30,5 60,25 Q90,45 120,15" stroke="#f5cdc3" stroke-width="1.5" stroke-dasharray="180" stroke-dashoffset="180" fill="none"/>
          <circle cx="0" cy="35" r="3" fill="#e8a99a"/>
          <circle cx="120" cy="15" r="3" fill="#c9a96e"/>
        </svg>
        <div class="plane-icon">✈</div>
        <div class="boarding-duration">Mãi Mãi</div>
      </div>
      <div class="boarding-to"><div class="boarding-code">HON</div><div class="boarding-city">Hôn Nhân · Điểm Đến</div></div>
    </div>
    <div class="boarding-info">
      <div class="info-item"><span class="info-label">Ngày Bay</span><div class="info-value">25/12</div></div>
      <div class="info-item"><span class="info-label">Giờ Bay</span><div class="info-value">11:30</div></div>
      <div class="info-item"><span class="info-label">Ghế</span><div class="info-value">VIP</div></div>
      <div class="info-item"><span class="info-label">Hạng</span><div class="info-value">Hạnh Phúc</div></div>
    </div>
    <div class="tear-line"><div class="tear-dashes"></div></div>
    <div class="boarding-stub">
      <div><div class="stub-names">Anh Xuân & Thư Hương</div><div class="stub-date">Royal Palace · 25.12.2023</div></div>
      <svg class="barcode-svg" width="80" height="50" viewBox="0 0 80 50">
        <rect x="0" width="2" height="50" fill="#6b3a2a"/><rect x="4" width="1" height="50" fill="#6b3a2a"/>
        <rect x="7" width="3" height="50" fill="#6b3a2a"/><rect x="12" width="1" height="50" fill="#6b3a2a"/>
        <rect x="15" width="2" height="50" fill="#6b3a2a"/><rect x="20" width="1" height="50" fill="#6b3a2a"/>
        <rect x="23" width="3" height="50" fill="#6b3a2a"/><rect x="28" width="1" height="50" fill="#6b3a2a"/>
        <rect x="31" width="2" height="50" fill="#6b3a2a"/><rect x="35" width="1" height="50" fill="#6b3a2a"/>
        <rect x="38" width="3" height="50" fill="#6b3a2a"/><rect x="43" width="1" height="50" fill="#6b3a2a"/>
        <rect x="46" width="2" height="50" fill="#6b3a2a"/><rect x="50" width="1" height="50" fill="#6b3a2a"/>
        <rect x="53" width="3" height="50" fill="#6b3a2a"/><rect x="58" width="2" height="50" fill="#6b3a2a"/>
        <rect x="62" width="1" height="50" fill="#6b3a2a"/><rect x="65" width="3" height="50" fill="#6b3a2a"/>
        <rect x="70" width="1" height="50" fill="#6b3a2a"/><rect x="73" width="2" height="50" fill="#6b3a2a"/>
        <rect x="77" width="3" height="50" fill="#6b3a2a"/>
      </svg>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════
     PASSPORT SPREAD
══════════════════════════════════ -->
<section class="page-section" id="passport-spread" style="flex-direction:column">
  <div class="spread-title reveal">✦ &nbsp; Hộ Chiếu Tình Yêu &nbsp; ✦</div>
  <div class="passport-book reveal">
    <div class="passport-page">
      <div class="page-watermark">♥</div>
      <svg class="passport-stamp stamp-tr" viewBox="0 0 90 90">
        <circle cx="45" cy="45" r="40" fill="none" stroke="#c9a96e" stroke-width="1.5" stroke-dasharray="5,3"/>
        <circle cx="45" cy="45" r="33" fill="none" stroke="#c9a96e" stroke-width=".8"/>
        <text x="45" y="30" text-anchor="middle" font-family="Jost" font-size="6" fill="#c9a96e" letter-spacing="3">WEDDING</text>
        <text x="45" y="52" text-anchor="middle" font-family="Great Vibes" font-size="18" fill="#c9a96e">2023</text>
        <text x="45" y="64" text-anchor="middle" font-family="Jost" font-size="6" fill="#c9a96e" letter-spacing="3">VIETNAM</text>
      </svg>
      <div class="page-number">PAGE 01</div>
      <div class="passport-photo">
        <img src="https://images.unsplash.com/photo-1566492031773-4f4e44671857?w=300&auto=format&fit=crop&q=80" alt="Chú Rể">
