      <div class="passport-field"><span class="field-label">Quê Quán</span><div class="field-value">Hà Nội, Việt Nam</div></div>
      <div class="passport-field"><span class="field-label">Nghề Nghiệp</span><div class="field-value">Kỹ Sư – Nhiếp Ảnh Gia</div></div>
      <div class="mrz">P&lt;VNM&lt;NGUYEN&lt;&lt;ANH&lt;XUAN&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;<br>WED2023&lt;&lt;9502143M2312253VNM&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</div>
    </div>
    <div class="passport-page">
      <div class="page-watermark">♥</div>
      <svg class="passport-stamp stamp-tl" viewBox="0 0 90 90">
        <circle cx="45" cy="45" r="40" fill="none" stroke="#e8a99a" stroke-width="1.5" stroke-dasharray="5,3"/>
        <circle cx="45" cy="45" r="33" fill="none" stroke="#e8a99a" stroke-width=".8"/>
        <text x="45" y="30" text-anchor="middle" font-family="Jost" font-size="6" fill="#e8a99a" letter-spacing="2">PASSPORT</text>
        <text x="45" y="52" text-anchor="middle" font-family="Great Vibes" font-size="14" fill="#e8a99a">Love</text>
        <text x="45" y="64" text-anchor="middle" font-family="Jost" font-size="5" fill="#e8a99a" letter-spacing="2">TO MARRIAGE</text>
      </svg>
      <div class="page-number">PAGE 02</div>
      <div class="passport-photo">
